    z-index: 2;
    transition: all 300ms ease;
    font-weight: 900;
  }

  /* ✅ HIGH STOCK (50+): Green circle, white text */
  .stock-badge-circle[data-stock-level] {
    background: rgb(96 198 85 / 57%);
