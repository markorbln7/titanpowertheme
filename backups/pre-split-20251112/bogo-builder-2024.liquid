  /* ✅ Mobile carousel for tier cards */
  @media (max-width: 968px) {
    .tier-cards-container {
      display: flex;
      overflow-x: auto;
      overflow-y: visible;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scroll-padding: 20px;
      gap: 16px;
      padding: 0 20px 20px;
      margin-bottom: 16px;
      scrollbar-width: none;
