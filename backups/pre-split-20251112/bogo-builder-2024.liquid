  .btn-start-building { background: linear-gradient(135deg, #60c655 0%, #50b645 100%); color: #000; border: none; padding: 16px 48px; border-radius: 12px; font-size: 18px; font-weight: 900; cursor: pointer; transition: all 300ms ease; box-shadow: 0 8px 24px rgba(96, 198, 85, 0.4); }
  .btn-start-building:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(96, 198, 85, 0.6); }

  {%- comment -%} ========================================
      BOGO-CELEBRATION-CLOSE-046: CLICKABLE OVERLAY
      Celebration modal dismissible by background click
      ======================================== {%- endcomment -%}
  /* Overlay container - clickable to close */
  .tier-celebration-overlay {
    position: fixed;
    inset: 0;
    z-index: 10002;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.5); /* ✅ 50% transparent black overlay */
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    opacity: 0;
    transition: opacity 500ms ease;
    cursor: pointer; /* ✅ Shows it's clickable */
    padding: 20px; /* ✅ Space for hint text */
  }

  .tier-celebration-overlay.show {
    display: flex;
    opacity: 1;
  }

  /* Canvas for confetti - still non-interactive */
  .celebration-canvas {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Content box - prevents click-through */
  .celebration-content {
    position: relative;
    text-align: center;
    max-width: 600px;
    width: 100%;
    padding: 48px 32px;
    background: linear-gradient(135deg, #1a1a1a 0%, #0d0d0d 100%);
    border: 3px solid #60c655;
    border-radius: 20px;
    box-shadow: 0 24px 80px rgba(96, 198, 85, 0.4);
    animation: celebrationPop 600ms cubic-bezier(0.68, -0.55, 0.265, 1.55);
    cursor: default; /* ✅ Prevent parent cursor from applying */
    pointer-events: auto; /* ✅ Stop click propagation to overlay */
  }
  @keyframes celebrationPop { 0% { transform: scale(0.5); opacity: 0; } 60% { transform: scale(1.1); } 100% { transform: scale(1); opacity: 1; } }
  .celebration-badge { display: inline-flex; flex-direction: column; align-items: center; gap: 12px; padding: 24px; background: linear-gradient(135deg, #60c655 0%, #50b645 100%); border-radius: 50%; width: 140px; height: 140px; margin-bottom: 24px; box-shadow: 0 12px 48px rgba(96, 198, 85, 0.6); animation: badgeFloat 2000ms ease-in-out infinite; }
  @keyframes badgeFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
  .tier-celebration-overlay.tier-3 .celebration-badge { background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%); box-shadow: 0 12px 48px rgba(255, 215, 0, 0.6); }
  .badge-icon { font-size: 48px; line-height: 1; }
  .badge-tier { font-size: 16px; font-weight: 900; color: #000; text-transform: uppercase; letter-spacing: 0.05em; }
  .celebration-message { font-size: clamp(32px, 5vw, 48px); font-weight: 900; color: #fff; margin-bottom: 16px; text-transform: uppercase; letter-spacing: -0.02em; animation: messageGlow 2000ms ease-in-out infinite; }
  @keyframes messageGlow { 0%, 100% { text-shadow: 0 0 20px rgba(96, 198, 85, 0.6); } 50% { text-shadow: 0 0 40px rgba(96, 198, 85, 1); } }
  .celebration-submessage { font-size: clamp(18px, 3vw, 24px); font-weight: 600; color: #60c655; margin-bottom: 32px; line-height: 1.4; }
  .celebration-savings { background: rgba(96, 198, 85, 0.1); border: 2px solid rgba(96, 198, 85, 0.3); border-radius: 16px; padding: 24px; margin-bottom: 32px; }
  .savings-breakdown { font-size: 14px; color: rgba(255, 255, 255, 0.8); margin-bottom: 12px; line-height: 1.6; }
  .savings-total { font-size: 48px; font-weight: 900; color: #FFD700; line-height: 1; }

  /* ✅ Two-button layout in celebration modal */
  .celebration-buttons { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; margin-top: 8px; }

  .btn-celebration-continue { border: none; padding: 16px 40px; border-radius: 12px; font-size: 16px; font-weight: 900; cursor: pointer; transition: all 300ms ease; text-transform: uppercase; letter-spacing: 0.05em; flex: 1; min-width: 180px; max-width: 240px; }

  /* Primary button (Checkout) */
  .btn-celebration-continue.primary { background: linear-gradient(135deg, #60c655 0%, #50b645 100%); color: #000; box-shadow: 0 8px 24px rgba(96, 198, 85, 0.4); }
  .btn-celebration-continue.primary:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(96, 198, 85, 0.6); }

  /* Secondary button (Review Pairs) */
  .btn-celebration-continue.secondary { background: rgba(255, 255, 255, 0.1); color: #ffffff; border: 2px solid rgba(96, 198, 85, 0.5); box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2); }
  .btn-celebration-continue.secondary:hover { background: rgba(255, 255, 255, 0.15); border-color: #60c655; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(96, 198, 85, 0.3); }

  /* Tier 3 - Gold primary button */
  .tier-celebration-overlay.tier-3 .btn-celebration-continue.primary { background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%); box-shadow: 0 8px 24px rgba(255, 215, 0, 0.4); }
  .tier-celebration-overlay.tier-3 .btn-celebration-continue.primary:hover { box-shadow: 0 12px 32px rgba(255, 215, 0, 0.6); }

  /* ✅ BOGO-CELEBRATION-CLOSE-046: Hint text for overlay dismissal */
  .celebration-hint {
    margin-top: 24px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.6);
    font-weight: 500;
    text-align: center;
    letter-spacing: 0.02em;
    animation: hintPulse 2000ms ease-in-out infinite;
  }

  @keyframes hintPulse {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
  }

  /* Mobile: Stack buttons vertically */
  @media (max-width: 768px) {
    .celebration-buttons { flex-direction: column; gap: 12px; }
    .btn-celebration-continue { min-width: 100%; max-width: 100%; }
  }
  .bogo-sticky-cart.celebration-pulse { animation: cartCelebratePulse 1200ms ease-out; }
  @keyframes cartCelebratePulse { 0%, 100% { transform: translateY(0); box-shadow: 0 -4px 20px rgba(96, 198, 85, 0.3); } 25% { transform: translateY(-8px); box-shadow: 0 -8px 40px rgba(96, 198, 85, 0.6); } 50% { transform: translateY(0); box-shadow: 0 -12px 60px rgba(96, 198, 85, 0.8); } 75% { transform: translateY(-4px); box-shadow: 0 -8px 40px rgba(96, 198, 85, 0.6); } }

  /* Tier benefit styling for sticky cart */
  .tier-benefit { display: block; font-size: 12px; color: #FFD700; margin-top: 4px; font-weight: 600; }

