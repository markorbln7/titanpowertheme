  .tier-comparison-modal { position: fixed; inset: 0; z-index: 10001; display: none; align-items: center; justify-content: center; padding: 20px; }
  .tier-comparison-modal.active { display: flex; }
  .comparison-overlay { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.5); backdrop-filter: blur(8px); cursor: pointer; }
  .comparison-content { position: relative; width: 100%; max-width: 1000px; max-height: 90vh; background: #1a1a1a; border-radius: 20px; border: 3px solid #60c655; box-shadow: 0 24px 80px rgba(96, 198, 85, 0.4); overflow-y: auto; }
  .comparison-close { position: absolute; top: 16px; right: 16px; width: 40px; height: 40px; background: rgba(255, 255, 255, 0.1); border: none; border-radius: 50%; color: #fff; font-size: 24px; cursor: pointer; transition: all 300ms ease; z-index: 10; }
  .comparison-close:hover { background: rgba(255, 0, 0, 0.8); transform: rotate(90deg); }
  .comparison-header { text-align: center; padding: 40px 24px 24px; border-bottom: 2px solid rgba(96, 198, 85, 0.3); }
  .comparison-header h2 { font-size: 32px; font-weight: 900; color: #fff; margin-bottom: 8px; }
