<!doctype html>
  <html class="no-js" lang="{{ request.locale.iso_code }}">
    <head>
      {{ 'special-buds.css' | asset_url | stylesheet_tag }}



    <!-- Start of Shoplift scripts -->
    {% render 'shoplift' %}
    <!-- End of Shoplift scripts -->

      {% render 'meta' %}
      {% render 'vwo' %}
      {% render 'seo' %}
      {% render 'theme-head-scripts' %}
      {%- render 'header-scripts.zipifypages', apprxhbl: zp_apprxhbl, renderctx: 'thm' -%}{{ content_for_header }}

      {%- liquid
        assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
        assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
        assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
      %}
      {% render 'head-stylesheets' %}

      {{ 'base.css' | asset_url | stylesheet_tag }}


      {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
        {{ 'component-localization-form.css' | asset_url | stylesheet_tag: preload: true }}
        <script src="{{ 'localization-form.js' | asset_url }}" defer="defer"></script>
      {%- endif -%}

      {%- if settings.predictive_search_enabled -%}
        <link
          rel="stylesheet"
          href="{{ 'component-predictive-search.css' | asset_url }}"
          media="print"
          onload="this.media='all'"
        >
      {%- endif -%}

      {% render 'head-scripts' %}
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css"/>

      <style>  body.no-scroll {  overflow: hidden;  }  </style>

      {{ 'main.css' | asset_url | stylesheet_tag }}

      {{ 'main.js' | asset_url | script_tag }}
      {{ 'section-product-template.css' | asset_url | stylesheet_tag }}
      {{ 'section-product-template.js' | asset_url | script_tag }}
      {{ 'override.css' | asset_url | stylesheet_tag }}

      {% render 'additional-third-party-scripts' %}


  </head>

    <body class="aha--{{ template.suffix }} gradient{% if settings.animations_hover_elements != 'none' %} animate--hover-{{ settings.animations_hover_elements }}{% endif %}">
      <a class="skip-to-content-link button visually-hidden" href="#MainContent">
        {{ 'accessibility.skip_to_text' | t }}
      </a>

      {% sections 'header-group' %}

      <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
        {{ content_for_layout }}
        {% section 'footer' %}
      </main>
      {{ 'globallight.css' | asset_url | stylesheet_tag }}
      {% if template.suffix == 'mega-bundle' %}
        {{ 'bundleoverrides.css' | asset_url | stylesheet_tag }}
      {% endif %}

      <ul hidden>
        <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
        <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
      </ul>

      {% comment %} Do not delete below snippet file {% endcomment %}
      {% render 'theme-head-script' %}


      {%- if settings.predictive_search_enabled -%}
        <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
      {%- endif -%}

      {%- render 'page-footer.zipifypages', renderctx: 'thm', ocuapp: oneclickupsellapp -%}
{%- comment -%}
  ============================================
  BF25 REBUY SUPPRESSION SYSTEM
  6-Layer defense for 100% Rebuy blocking on BF25 pages
  Implemented: 2024-11-24
  ============================================
{%- endcomment -%}

{%- comment -%} Layer 1: Server-side page detection {%- endcomment -%}
{% assign bf25_handles = "black-friday-2025,bf25-bundle-builder,bf25,bf-2025,black-friday" | split: "," %}
{% assign is_bf25_page = false %}
{% if template contains 'page' %}
  {% for handle in bf25_handles %}
    {% if page.handle == handle %}
      {% assign is_bf25_page = true %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if is_bf25_page %}
  {%- comment -%} ===== BF25 PAGE: FULL REBUY SUPPRESSION ===== {%- endcomment -%}

  {%- comment -%} Layer 3: CSS Hide - Immediate visual suppression {%- endcomment -%}
  <style id="bf25-rebuy-hide">
    rebuy-cart,
    rebuy-smart-cart,
    [data-rebuy-cart],
    [data-rebuy-id],
    .rebuy-cart,
    .rebuy-smart-cart,
    .rebuy-cart__flyout,
    .rebuy-cart__overlay,
    #rebuy-smart-cart {
      display: none !important;
      visibility: hidden !important;
      opacity: 0 !important;
      pointer-events: none !important;
      position: absolute !important;
      left: -9999px !important;
    }
  </style>

  {%- comment -%} Layers 2, 4, 5, 6: JavaScript suppression system {%- endcomment -%}
  <script id="bf25-rebuy-suppression">
  (function() {
    'use strict';

    // ==========================================
    // LAYER 2: Immutable Object Definition
    // Lock window.Rebuy BEFORE any scripts can set it
    // ==========================================
    var RebuyProxy = new Proxy({}, {
      get: function(target, prop) {
        // Return no-op functions for any method call
        return function() {
          console.log('[BF25] Rebuy method blocked:', prop);
          return Promise.resolve();
        };
      },
      set: function() { return true; }
    });

    try {
      Object.defineProperty(window, 'Rebuy', {
        value: RebuyProxy,
        configurable: false,
        writable: false,
        enumerable: true
      });
      console.log('[BF25] Layer 2: window.Rebuy locked as immutable');
    } catch (e) {
      // Fallback if defineProperty fails
      window.Rebuy = RebuyProxy;
      console.log('[BF25] Layer 2: window.Rebuy set (fallback mode)');
    }

    // ==========================================
    // LAYER 6: Global Flags
    // Set flags that other scripts check
    // ==========================================
    window.TitanContext = window.TitanContext || {};
    window.TitanContext.isBF25Page = true;
    window.TitanContext.isCheckout = window.location.pathname.includes('/checkouts/');
    window.TitanContext.rebuySuppressionActive = true;

    // Flags checked by existing BOGO/BF25 code
    window.rebuyDisabled = true;
    window.bf25Active = true;

    // Session flag for cart page protection
    sessionStorage.setItem('bf25_session_active', 'true');
    sessionStorage.setItem('bf25_rebuy_suppressed', 'true');

    console.log('[BF25] Layer 6: Global flags set');

    // ==========================================
    // LAYER 5: Event Blocking
    // Intercept all Rebuy custom events
    // ==========================================
    var rebuyEvents = [
      'rebuy:cart.open',
      'rebuy:cart.close',
      'rebuy:cart.change',
      'rebuy:cart-open',
      'rebuy:cart-close',
      'rebuy:cart-update',
      'rebuy:checkout',
      'rebuy:smartcart.open',
      'rebuy:smartcart.close',
      'rebuy:item.added',
      'rebuy:item.removed'
    ];

    rebuyEvents.forEach(function(eventName) {
      document.addEventListener(eventName, function(e) {
        e.stopImmediatePropagation();
        e.preventDefault();
        console.log('[BF25] Layer 5: Blocked event:', eventName);
        return false;
      }, true); // Use capture phase to intercept first
    });

    // Also block on window
    rebuyEvents.forEach(function(eventName) {
      window.addEventListener(eventName, function(e) {
        e.stopImmediatePropagation();
        e.preventDefault();
        return false;
      }, true);
    });

    console.log('[BF25] Layer 5: Event listeners installed');

    // ==========================================
    // LAYER 4: MutationObserver Watchdog
    // Remove Rebuy elements the instant they appear
    // ==========================================
    var rebuySelectors = [
      'rebuy-cart',
      'rebuy-smart-cart',
      '[data-rebuy-cart]',
      '[data-rebuy-id]',
      '.rebuy-cart',
      '.rebuy-smart-cart',
      '#rebuy-smart-cart'
    ];

    function removeRebuyElement(element) {
      if (element && element.parentNode) {
        console.log('[BF25] Layer 4: Removing Rebuy element:', element.tagName || element.className);
        element.parentNode.removeChild(element);
      }
    }

    function isRebuyElement(node) {
      if (node.nodeType !== Node.ELEMENT_NODE) return false;

      var tagName = (node.tagName || '').toLowerCase();
      if (tagName === 'rebuy-cart' || tagName === 'rebuy-smart-cart') return true;

      if (node.matches) {
        for (var i = 0; i < rebuySelectors.length; i++) {
          try {
            if (node.matches(rebuySelectors[i])) return true;
          } catch (e) {}
        }
      }

      return false;
    }

    var observer = new MutationObserver(function(mutations) {
      mutations.forEach(function(mutation) {
        mutation.addedNodes.forEach(function(node) {
          if (isRebuyElement(node)) {
            removeRebuyElement(node);
          }
          // Also check children
          if (node.querySelectorAll) {
            rebuySelectors.forEach(function(selector) {
              try {
                var elements = node.querySelectorAll(selector);
                elements.forEach(removeRebuyElement);
              } catch (e) {}
            });
          }
        });
      });
    });

    // Start observing as soon as possible
    if (document.documentElement) {
      observer.observe(document.documentElement, {
        childList: true,
        subtree: true
      });
      console.log('[BF25] Layer 4: MutationObserver active');
    }

    // Also run cleanup on DOMContentLoaded
    document.addEventListener('DOMContentLoaded', function() {
      rebuySelectors.forEach(function(selector) {
        try {
          document.querySelectorAll(selector).forEach(removeRebuyElement);
        } catch (e) {}
      });
    });

    // ==========================================
    // FINAL: Confirmation
    // ==========================================
    console.log('[BF25] ✅ 6-Layer Rebuy Suppression System Active');
    console.log('[BF25] Layers: Liquid Block, Immutable Object, CSS Hide, MutationObserver, Event Blocking, Global Flags');

  })();
  </script>

  {%- comment -%} DO NOT render Rebuy on BF25 pages {%- endcomment -%}

{% else %}
  {%- comment -%} ===== NON-BF25 PAGE: NORMAL REBUY LOADING ===== {%- endcomment -%}

  <script>
    // Set context for non-BF25 pages
    window.TitanContext = window.TitanContext || {};
    window.TitanContext.isBF25Page = false;
    window.TitanContext.isCheckout = window.location.pathname.includes('/checkouts/');
    window.TitanContext.rebuySuppressionActive = false;
  </script>

  <script async src="https://cdn.rebuyengine.com/onsite/js/rebuy.js?shop={{ shop.permanent_domain }}"></script>
  {% render 'rebuy-smartcart-extensions' %}

{% endif %}
      <script async data-src="https://static.klaviyo.com/onsite/js/klaviyo.js?company_id=HXhrVm"></script>
      {% render 'footer-scripts' %}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Find product-rev element and add js-scroll class to make it a valid target
    const productRev = document.querySelector('#product-rev');
    if (productRev) {
      productRev.classList.add('js-scroll');
      console.log('Added js-scroll class to #product-rev');
    }

    // Also try section-pdp-hero as a fallback since button links there
    const pdpHero = document.querySelector('#section-pdp-hero');
    if (pdpHero) {
      pdpHero.classList.add('js-scroll');
      console.log('Added js-scroll class to #section-pdp-hero');
    }
  });
</script>



      </body>
  </html>
