<script src="https://cdn.tailwindcss.com"></script>
<style>
   .font-sans {
        font-family: "Work Sans", serif;
        font-weight: 600;
   }
   .font-bold {
        font-weight: 900;
   }
  .custom-pack-wrapper {
    max-width: 1000px; /* Reduced from 1400px (BF25-8.10b) */
    padding: 40px 20px; /* Reduced from 60px (BF25-8.10b) */
    margin: 0 auto;
    background: #000000;
  }

  .block-items {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    max-width: 900px; /* Reduced from 1200px (BF25-8.10b) */
    margin: 0 auto;
    gap: 8px;
  }

  .block-item {
    background: linear-gradient(135deg, rgba(96, 198, 85, 0.1) 0%, rgba(0, 0, 0, 0.8) 100%);
    border: 2px solid rgba(96, 198, 85, 0.3);
    border-radius: 16px;
    padding: 20px 16px; /* Reduced from 32px 20px (BF25-8.10b) */
    text-align: center;
    transition: all 0.3s ease;
    min-height: 160px; /* Reduced from 200px (BF25-8.10b) */
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .block-item:hover {
    border-color: rgba(96, 198, 85, 0.6);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(96, 198, 85, 0.2);
  }

  /* ========== BF25 TIER BOX TEXT STYLING (V4) ========== */

  /* Items label - top */
  .block-item .bf25-items-label,
  .block-item > div:first-child {
    color: #60c655;
    font-size: 9px;
    font-weight: 700;
    margin-bottom: 4px;
    letter-spacing: 0.3px;
    text-transform: uppercase;
  }

  /* Discount row container - align OFF to bottom of number */
  .block-item .bf25-discount-row,
  .block-item h3 {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 2px;
  }

  /* Large discount number */
  .block-item .bf25-discount-number,
  .block-item h3 span:first-child {
    color: #fff;
    font-size: 36px;
    font-weight: 700;
    line-height: 0.8;
    order: 1; /* Ensure number is first */
  }

  /* % and OFF stacked */
  .block-item .bf25-discount-suffix,
  .block-item h3 > div {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-bottom: 2px;
    order: 2; /* Ensure suffix is second */
  }

  /* Override Tailwind absolute positioning on % */
  .block-item h3 .absolute {
    position: relative !important;
    top: auto !important;
    right: auto !important;
  }

  /* Percent sign */
  .block-item .bf25-percent,
  .block-item h3 .text-\[24px\],
  .block-item h3 .md\:text-\[40px\] {
    position: relative !important;
    top: auto !important;
    right: auto !important;
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
  }

  /* OFF text */
  .block-item .bf25-off-text,
  .block-item h3 span:last-child,
  .block-item h3 .text-\[10px\],
  .block-item h3 .md\:text-\[20px\] {
    color: rgba(255, 255, 255, 0.6);
    font-size: 8px;
    font-weight: 600;
    line-height: 1;
    margin-top: 1px;
  }

  /* Gift text - bigger and prominent */
  .block-item .bf25-gift-text {
    color: #60c655;
    font-size: 9px;
    font-weight: 700;
    margin-top: 6px;
    text-transform: uppercase;
  }

  /* ========== MOBILE OVERRIDES ========== */
  @media (max-width: 768px) {
    .custom-pack-wrapper {
      padding: 20px 8px;
    }

    .block-items {
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
      max-width: 100%;
    }

    .block-item {
      padding: 8px 4px;
      min-height: 120px;
      border-radius: 8px;
    }

    /* Items label */
    .block-item .bf25-items-label,
    .block-item > div:first-child {
      font-size: 8px;
      margin-bottom: 3px;
    }

    /* Discount number */
    .block-item .bf25-discount-number,
    .block-item h3 span:first-child {
      font-size: 28px;
    }

    /* Percent */
    .block-item .bf25-percent,
    .block-item h3 .text-\[24px\] {
      font-size: 12px;
    }

    /* OFF */
    .block-item .bf25-off-text,
    .block-item h3 span:last-child,
    .block-item h3 .text-\[10px\] {
      font-size: 7px;
    }

    /* Gift text */
    .block-item .bf25-gift-text {
      font-size: 8px;
      margin-top: 4px;
    }
  }

  /* Tablet: 4 columns but adjust sizing */
  @media (max-width: 1024px) and (min-width: 769px) {
    .block-items {
      max-width: 100%;
      padding: 0 20px;
      gap: 6px;
    }

    .block-item {
      padding: 24px 16px;
      min-height: 180px;
    }
  }
</style>

<section class="bg-black text-center">
  <div class="custom-pack-wrapper">
  {% if section.settings.show_banner %}
  <div class="max-w-[700px] mx-auto">
    <img class="w-full" width="100%" height="auto"  src="{{ section.settings.banner_image | img_url:'master' }}">
  </div>
  {% endif %}
    {% if section.settings.section_title %}
      <h2 class="text-white text-[30px] md:text-[60px] font-sans font-bold relative">

        {{ section.settings.section_title }}
      </h2>
    {% endif %}
    {% if section.settings.section_eyebrow %}
      <div class="text-[#60c655] text-[18px] md:text-[24px] mb-[20px]">
        {{ section.settings.section_eyebrow }}
      </div>
    {% endif %}

    <div class="block-items">
      {% for block in section.blocks %}
        <div class="block-item" {{ block.shopify_attributes }}>
          {% if block.settings.eyebrow_position == false %}
            <div class="text-[#60c655] text-[14px] md:text-[20px] leading-[1] font-semibold mb-2">
              {{ block.settings.block_eyebrow }}
            </div>
          {% endif %}

          <h3 class="bf25-discount-row text-white font-sans leading-[1]">
            <span class="bf25-discount-number">{{ block.settings.block_title }}</span>
            <div class="bf25-discount-suffix">
              <span class="bf25-percent">%</span>
              <span class="bf25-off-text">OFF</span>
            </div>
          </h3>

          <!-- Gift text with auto-incrementing count (BF25-8.12b) -->
          <div class="bf25-gift-text">+ {{ forloop.index }} FREE GIFT{% if forloop.index > 1 %}S{% endif %}</div>

          {% if block.settings.eyebrow_position %}
            <div class="text-[#60c655] text-[14px] md:text-[20px] leading-[1] font-semibold mt-2">
              {{ block.settings.block_eyebrow }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Shopify Section: Custom Pack Builder -->
{% schema %}
{
  "name": "BF Promo Discount bf 2025",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "Show Banner",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Build Your Horror-Free Pack"
    },
    {
      "type": "text",
      "id": "section_eyebrow",
      "label": "Section Eyebrow",
      "default": "The More You Add, More You Save"
    }
  ],
  "blocks": [
    {
      "type": "block_item",
      "name": "Discount Tier",
      "settings": [
        {
          "type": "text",
          "id": "block_eyebrow",
          "label": "Items Text",
          "default": "4+ items"
        },
        {
          "type": "text",
          "id": "block_title",
          "label": "Discount Percentage",
          "default": "60"
        },
        {
          "type": "text",
          "id": "gift_text",
          "label": "Gift Text",
          "default": "+ 1 FREE GIFT"
        },
        {
          "type": "checkbox",
          "id": "eyebrow_position",
          "label": "Eyebrow below title",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Bf Promo Discount bf 2025",
      "category": "Custom",
      "blocks": [
        {
          "type": "block_item",
          "settings": {
            "block_eyebrow": "4+ items",
            "block_title": "60",
            "gift_text": "+ 1 FREE GIFT"
          }
        },
        {
          "type": "block_item",
          "settings": {
            "block_eyebrow": "8+ items",
            "block_title": "70",
            "gift_text": "+ 2 FREE GIFTS"
          }
        },
        {
          "type": "block_item",
          "settings": {
            "block_eyebrow": "12+ items",
            "block_title": "80",
            "gift_text": "+ 3 FREE GIFTS"
          }
        },
        {
          "type": "block_item",
          "settings": {
            "block_eyebrow": "16+ items",
            "block_title": "85",
            "gift_text": "+ 4 FREE GIFTS"
          }
        }
      ]
    }
  ]
}
{% endschema %}