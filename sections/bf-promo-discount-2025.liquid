<script src="https://cdn.tailwindcss.com"></script>
<style>
   .font-sans {
        font-family: "Work Sans", serif;
        font-weight: 600;
   }
   .font-bold {
        font-weight: 900;
   }
  .custom-pack-wrapper {
    max-width: 1300px;
    padding: 40px 20px;
    margin: 0 auto;
    background: #000000;
  }

  .block-items {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 4px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .block-item {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 16px 8px;
    border-right: 2px solid rgba(96, 198, 85, 0.3);
    align-items: center;
    justify-content: center;
    min-width: 0;
  }

  .block-item:last-child {
    border-right: none;
  }

  /* Mobile: Horizontal scroll */
  @media (max-width: 768px) {
    .custom-pack-wrapper {
      padding: 20px 10px;
    }

    .block-items {
      max-width: 100%;
      overflow-x: auto;
      justify-content: flex-start;
      padding: 0 10px;
      gap: 2px;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .block-items::-webkit-scrollbar {
      display: none;
    }

    .block-item {
      flex: 0 0 auto;
      min-width: 85px;
      padding: 12px 6px;
      border-right: 1px solid rgba(96, 198, 85, 0.3);
    }
  }

  /* Desktop: Ensure all blocks fit proportionally */
  @media (min-width: 769px) {
    .block-item {
      padding: 20px 12px;
    }
  }
</style>

<section class="bg-black text-center">
  <div class="custom-pack-wrapper">
  {% if section.settings.show_banner %}
  <div class="max-w-[700px] mx-auto">
    <img class="w-full" width="100%" height="auto"  src="{{ section.settings.banner_image | img_url:'master' }}">
  </div>
  {% endif %}
    {% if section.settings.section_title %}
      <h2 class="text-white text-[30px] md:text-[60px] font-sans font-bold relative">

        {{ section.settings.section_title }}
      </h2>
    {% endif %}
    {% if section.settings.section_eyebrow %}
      <div class="text-[#60c655] text-[18px] md:text-[24px] mb-[20px]">
        {{ section.settings.section_eyebrow }}
      </div>
    {% endif %}

    <div class="block-items flex flex-row md:flex-row max-w-[1000px] mx-auto gap-[2px] md:gap-[4px]">
      {% for block in section.blocks %}
        <div class="block-item" {{ block.shopify_attributes }}>
          {% if block.settings.eyebrow_position == false %}
            <div class="text-[#60c655] text-[14px] md:text-[24px] leading-[1] font-semibold">
              {{ block.settings.block_eyebrow }}
            </div>
          {% endif %}

          <h3 class="text-white text-[36px] md:text-[70px] font-sans leading-[1] relative">
            <div class="text-[24px] md:text-[46px] absolute top-0 right-0">%</div>
            <span>{{ block.settings.block_title }}</span><span class="text-[10px] md:text-[20px]"> OFF</span>
          </h3>

          {% if block.settings.eyebrow_position %}
            <div class="text-[#60c655] text-[14px] md:text-[24px] leading-[1] font-semibold">
              {{ block.settings.block_eyebrow }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Shopify Section: Custom Pack Builder -->
{% schema %}
{
  "name": "BF Promo Discount bf 2025",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "Show Banner",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Build a Custom Pack"
    },
    {
      "type": "text",
      "id": "section_eyebrow",
      "label": "Section Eyebrow"
    }
  ],
  "blocks": [
    {
      "type": "block_item",
      "name": "Block Item",
      "settings": [
        {
          "type": "text",
          "id": "block_eyebrow",
          "label": "Block Eyebrow",
          "default": "4+ items"
        },
        {
          "type": "text",
          "id": "block_title",
          "label": "Block Title"
        },
        {
          "type": "checkbox",
          "id": "eyebrow_position",
          "label": "Eyebrow below title",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bf Promo Discount bf 2025",
      "category": "Custom"
    }
  ]
}
{% endschema %}