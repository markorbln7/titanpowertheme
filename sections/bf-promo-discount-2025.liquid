<script src="https://cdn.tailwindcss.com"></script>
<style>
   .font-sans {
        font-family: "Work Sans", serif;
        font-weight: 600;
   }
   .font-bold {
        font-weight: 900;
   }
  .custom-pack-wrapper {
    max-width: 1000px; /* Reduced from 1400px (BF25-8.10b) */
    padding: 40px 15px; /* Adjusted for 4th box visibility */
    margin: 0 auto;
    background: #000000;
    overflow: visible;
  }

  .block-items {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    max-width: 900px; /* Reduced from 1200px (BF25-8.10b) */
    margin: 0 auto;
    gap: 8px;
    padding: 0 10px; /* Prevent 4th box cutoff */
    overflow: visible;
  }

  .block-item {
    background: linear-gradient(135deg, rgba(96, 198, 85, 0.1) 0%, rgba(0, 0, 0, 0.8) 100%);
    border: 2px solid rgba(96, 198, 85, 0.3);
    border-radius: 16px;
    padding: 20px 16px; /* Reduced from 32px 20px (BF25-8.10b) */
    text-align: center;
    transition: all 0.3s ease;
    min-height: 160px; /* Reduced from 200px (BF25-8.10b) */
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .block-item:hover {
    border-color: rgba(96, 198, 85, 0.6);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(96, 198, 85, 0.2);
  }

  /* ========== BF25 TIER BOX - FORCED INDEPENDENT SIZING ========== */

  /* DISCOUNT NUMBER - Large and bold */
  .bf25-discount-number,
  .block-item .bf25-discount-number,
  .custom-pack-wrapper .bf25-discount-number {
    color: #fff !important;
    font-size: 52px !important;
    font-weight: 700 !important;
    line-height: 0.85 !important;
    display: inline-block !important;
  }

  /* PERCENT SYMBOL - Much smaller */
  .bf25-percent,
  .block-item .bf25-percent,
  .custom-pack-wrapper .bf25-percent {
    color: #fff !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    line-height: 1 !important;
    display: block !important;
  }

  /* OFF TEXT - Smallest */
  .bf25-off-text,
  .block-item .bf25-off-text,
  .custom-pack-wrapper .bf25-off-text {
    color: rgba(255, 255, 255, 0.6) !important;
    font-size: 9px !important;
    font-weight: 600 !important;
    line-height: 1 !important;
    display: block !important;
    margin-top: 2px !important;
  }

  /* ROW CONTAINER */
  .bf25-discount-row,
  .block-item .bf25-discount-row {
    display: flex !important;
    align-items: flex-end !important;
    justify-content: center !important;
    gap: 3px !important;
  }

  /* SUFFIX CONTAINER (% and OFF stacked) */
  .bf25-discount-suffix,
  .block-item .bf25-discount-suffix {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
    padding-bottom: 4px !important;
  }

  /* ITEMS LABEL */
  .bf25-items-label,
  .block-item .bf25-items-label {
    color: #60c655 !important;
    font-size: 12px !important;
    font-weight: 700 !important;
    margin-bottom: 4px !important;
  }

  /* GIFT TEXT */
  .bf25-gift-text,
  .block-item .bf25-gift-text {
    color: #60c655 !important;
    font-size: 11px !important;
    font-weight: 700 !important;
    margin-top: 8px !important;
    text-transform: uppercase !important;
  }

  /* Kill any inherited font-size on h3 or parent elements */
  .block-item h3 {
    font-size: inherit !important;
  }

  .block-item h3 span {
    font-size: inherit !important;
  }

  /* Override Tailwind classes */
  .block-item h3 .absolute {
    position: relative !important;
    top: auto !important;
    right: auto !important;
  }

  /* ========== DESKTOP TIER BOXES - COMPACT ========== */
  @media (min-width: 769px) {
    /* Reduce box padding */
    .block-item {
      padding: 15px 10px !important;
    }

    /* Slightly smaller discount number on desktop */
    .bf25-discount-number,
    .block-item .bf25-discount-number,
    .custom-pack-wrapper .bf25-discount-number {
      font-size: 48px !important;
    }

    /* Tighter items label */
    .bf25-items-label,
    .block-item .bf25-items-label {
      font-size: 11px !important;
      margin-bottom: 3px !important;
    }

    /* Tighter gift text */
    .bf25-gift-text,
    .block-item .bf25-gift-text {
      font-size: 10px !important;
      margin-top: 5px !important;
    }

    /* % size */
    .bf25-percent,
    .block-item .bf25-percent,
    .custom-pack-wrapper .bf25-percent {
      font-size: 13px !important;
    }

    .bf25-off-text,
    .block-item .bf25-off-text,
    .custom-pack-wrapper .bf25-off-text {
      font-size: 8px !important;
    }
  }

  /* Large desktop - can be slightly bigger */
  @media (min-width: 1200px) {
    .block-item {
      padding: 18px 12px !important;
    }

    .bf25-discount-number,
    .block-item .bf25-discount-number,
    .custom-pack-wrapper .bf25-discount-number {
      font-size: 52px !important;
    }

    .bf25-items-label,
    .block-item .bf25-items-label {
      font-size: 12px !important;
    }

    .bf25-gift-text,
    .block-item .bf25-gift-text {
      font-size: 11px !important;
    }
  }

  /* ========== MOBILE - SCALED DOWN ========== */
  @media (max-width: 768px) {
    .custom-pack-wrapper {
      padding: 16px 8px; /* Reduced from 20px (20% less) */
    }

    .block-items {
      grid-template-columns: repeat(4, 1fr);
      gap: 5.5px; /* Increased from 5px (10% more) */
      max-width: 100%;
      padding: 0 5px;
    }

    .block-item {
      padding: 6px 3px; /* Reduced from 8px (20% less) */
      min-height: 96px; /* Reduced from 120px (20% less) */
      border-radius: 8px;
    }

    /* Discount number - scaled down */
    .bf25-discount-number,
    .block-item .bf25-discount-number,
    .custom-pack-wrapper .bf25-discount-number {
      font-size: 32px !important;
    }

    /* Percent - scaled down */
    .bf25-percent,
    .block-item .bf25-percent,
    .custom-pack-wrapper .bf25-percent {
      font-size: 10px !important;
    }

    /* OFF - scaled down */
    .bf25-off-text,
    .block-item .bf25-off-text,
    .custom-pack-wrapper .bf25-off-text {
      font-size: 7px !important;
    }

    /* Items label */
    .bf25-items-label,
    .block-item .bf25-items-label {
      font-size: 9px !important;
    }

    /* Items label */
    .bf25-items-label,
    .block-item .bf25-items-label {
      font-size: 8px !important;
      margin-bottom: 2px !important;
    }

    /* Gift text */
    .bf25-gift-text,
    .block-item .bf25-gift-text {
      font-size: 7px !important;
      margin-top: 3px !important;
    }

    /* Suffix padding */
    .bf25-discount-suffix,
    .block-item .bf25-discount-suffix {
      padding-bottom: 2px !important;
    }
  }

  /* Tablet: 4 columns but adjust sizing */
  @media (max-width: 1024px) and (min-width: 769px) {
    .block-items {
      max-width: 100%;
      padding: 0 20px;
      gap: 6px;
    }

    .block-item {
      padding: 24px 16px;
      min-height: 180px;
    }
  }
</style>

<section class="bg-black text-center">
  <div class="custom-pack-wrapper">
  {% if section.settings.show_banner %}
  <div class="max-w-[700px] mx-auto">
    <img class="w-full" width="100%" height="auto"  src="{{ section.settings.banner_image | img_url:'master' }}">
  </div>
  {% endif %}
    {% if section.settings.section_title %}
      <h2 class="text-white text-[30px] md:text-[60px] font-sans font-bold relative">

        {{ section.settings.section_title }}
      </h2>
    {% endif %}
    {% if section.settings.section_eyebrow %}
      <div class="text-[#60c655] text-[18px] md:text-[24px] mb-[20px]">
        {{ section.settings.section_eyebrow }}
      </div>
    {% endif %}

    <div class="block-items">
      {% for block in section.blocks %}
        <div class="block-item" {{ block.shopify_attributes }}>
          {% if block.settings.eyebrow_position == false %}
            <div class="bf25-items-label">
              {{ block.settings.block_eyebrow }}
            </div>
          {% endif %}

          <h3 class="bf25-discount-row text-white font-sans leading-[1]">
            <span class="bf25-discount-number">{{ block.settings.block_title }}</span>
            <div class="bf25-discount-suffix">
              <span class="bf25-percent">%</span>
              <span class="bf25-off-text">OFF</span>
            </div>
          </h3>

          <!-- Gift text with auto-incrementing count (BF25-8.12b) -->
          <div class="bf25-gift-text">+ {{ forloop.index }} FREE GIFT{% if forloop.index > 1 %}S{% endif %}</div>

          {% if block.settings.eyebrow_position %}
            <div class="text-[#60c655] text-[14px] md:text-[20px] leading-[1] font-semibold mt-2">
              {{ block.settings.block_eyebrow }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Shopify Section: Custom Pack Builder -->
{% schema %}
{
  "name": "BF Promo Discount bf 2025",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "Show Banner",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Build Your Horror-Free Pack"
    },
    {
      "type": "text",
      "id": "section_eyebrow",
      "label": "Section Eyebrow",
      "default": "The More You Add, More You Save"
    }
  ],
  "blocks": [
    {
      "type": "block_item",
      "name": "Discount Tier",
      "settings": [
        {
          "type": "text",
          "id": "block_eyebrow",
          "label": "Items Text",
          "default": "4+ items"
        },
        {
          "type": "text",
          "id": "block_title",
          "label": "Discount Percentage",
          "default": "60"
        },
        {
          "type": "text",
          "id": "gift_text",
          "label": "Gift Text",
          "default": "+ 1 FREE GIFT"
        },
        {
          "type": "checkbox",
          "id": "eyebrow_position",
          "label": "Eyebrow below title",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Bf Promo Discount bf 2025",
      "category": "Custom",
      "blocks": [
        {
          "type": "block_item",
          "settings": {
            "block_eyebrow": "4+ items",
            "block_title": "60",
            "gift_text": "+ 1 FREE GIFT"
          }
        },
        {
          "type": "block_item",
          "settings": {
            "block_eyebrow": "8+ items",
            "block_title": "70",
            "gift_text": "+ 2 FREE GIFTS"
          }
        },
        {
          "type": "block_item",
          "settings": {
            "block_eyebrow": "12+ items",
            "block_title": "80",
            "gift_text": "+ 3 FREE GIFTS"
          }
        },
        {
          "type": "block_item",
          "settings": {
            "block_eyebrow": "16+ items",
            "block_title": "85",
            "gift_text": "+ 4 FREE GIFTS"
          }
        }
      ]
    }
  ]
}
{% endschema %}