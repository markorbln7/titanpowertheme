<script src="https://cdn.tailwindcss.com"></script>
<style>
   .font-sans {
        font-family: "Work Sans", serif;
        font-weight: 600;
   }
   .font-bold {
        font-weight: 900;
   }
  .custom-pack-wrapper {
    max-width: 1400px;
    padding: 60px 20px;
    margin: 0 auto;
    background: #000000;
  }

  .block-items {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    max-width: 1200px;
    margin: 0 auto;
    gap: 8px;
  }

  .block-item {
    background: linear-gradient(135deg, rgba(96, 198, 85, 0.1) 0%, rgba(0, 0, 0, 0.8) 100%);
    border: 2px solid rgba(96, 198, 85, 0.3);
    border-radius: 16px;
    padding: 32px 20px;
    text-align: center;
    transition: all 0.3s ease;
    min-height: 200px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .block-item:hover {
    border-color: rgba(96, 198, 85, 0.6);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(96, 198, 85, 0.2);
  }

  /* Mobile: 2x2 grid */
  @media (max-width: 768px) {
    .custom-pack-wrapper {
      padding: 40px 10px;
    }

    .block-items {
      grid-template-columns: repeat(2, 1fr);
      gap: 4px;
      max-width: 100%;
    }

    .block-item {
      padding: 20px 12px;
      min-height: 140px;
      border-radius: 12px;
    }
  }

  /* Tablet: 4 columns but adjust sizing */
  @media (max-width: 1024px) and (min-width: 769px) {
    .block-items {
      max-width: 100%;
      padding: 0 20px;
      gap: 6px;
    }

    .block-item {
      padding: 24px 16px;
      min-height: 180px;
    }
  }
</style>

<section class="bg-black text-center">
  <div class="custom-pack-wrapper">
  {% if section.settings.show_banner %}
  <div class="max-w-[700px] mx-auto">
    <img class="w-full" width="100%" height="auto"  src="{{ section.settings.banner_image | img_url:'master' }}">
  </div>
  {% endif %}
    {% if section.settings.section_title %}
      <h2 class="text-white text-[30px] md:text-[60px] font-sans font-bold relative">

        {{ section.settings.section_title }}
      </h2>
    {% endif %}
    {% if section.settings.section_eyebrow %}
      <div class="text-[#60c655] text-[18px] md:text-[24px] mb-[20px]">
        {{ section.settings.section_eyebrow }}
      </div>
    {% endif %}

    <div class="block-items">
      {% for block in section.blocks %}
        <div class="block-item" {{ block.shopify_attributes }}>
          {% if block.settings.eyebrow_position == false %}
            <div class="text-[#60c655] text-[14px] md:text-[20px] leading-[1] font-semibold mb-2">
              {{ block.settings.block_eyebrow }}
            </div>
          {% endif %}

          <h3 class="text-white text-[36px] md:text-[60px] font-sans leading-[1] relative">
            <div class="text-[24px] md:text-[40px] absolute top-0 right-0">%</div>
            <span>{{ block.settings.block_title }}</span><span class="text-[10px] md:text-[20px]"> OFF</span>
          </h3>

          {% if block.settings.eyebrow_position %}
            <div class="text-[#60c655] text-[14px] md:text-[20px] leading-[1] font-semibold mt-2">
              {{ block.settings.block_eyebrow }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Shopify Section: Custom Pack Builder -->
{% schema %}
{
  "name": "BF Promo Discount bf 2025",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "Show Banner",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Build Your Horror-Free Pack"
    },
    {
      "type": "text",
      "id": "section_eyebrow",
      "label": "Section Eyebrow",
      "default": "The More You Add, More You Save"
    }
  ],
  "blocks": [
    {
      "type": "block_item",
      "name": "Discount Tier",
      "settings": [
        {
          "type": "text",
          "id": "block_eyebrow",
          "label": "Items Text",
          "default": "4+ items"
        },
        {
          "type": "text",
          "id": "block_title",
          "label": "Discount Percentage",
          "default": "60"
        },
        {
          "type": "checkbox",
          "id": "eyebrow_position",
          "label": "Eyebrow below title",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Bf Promo Discount bf 2025",
      "category": "Custom",
      "blocks": [
        {
          "type": "block_item",
          "settings": {
            "block_eyebrow": "4+ items",
            "block_title": "60"
          }
        },
        {
          "type": "block_item",
          "settings": {
            "block_eyebrow": "8+ items",
            "block_title": "75"
          }
        },
        {
          "type": "block_item",
          "settings": {
            "block_eyebrow": "12+ items",
            "block_title": "80"
          }
        },
        {
          "type": "block_item",
          "settings": {
            "block_eyebrow": "16+ items",
            "block_title": "85"
          }
        }
      ]
    }
  ]
}
{% endschema %}