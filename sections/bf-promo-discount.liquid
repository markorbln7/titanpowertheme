<script src="https://cdn.tailwindcss.com"></script>
<style>
  /* ========== BF25 HERO HEADER - COMPACT (40% SMALLER LOGO) ========== */

  .bf25-hero-header {
    background: #000;
    padding: 15px 20px 10px !important;  /* Minimal padding */
    text-align: center;
    position: relative;
  }

  /* Top gradient line */
  .bf25-hero-line-top {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 200px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(96, 198, 85, 0.5), transparent);
  }

  /* Bottom gradient line */
  .bf25-hero-line-bottom {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 400px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(96, 198, 85, 0.3), transparent);
  }

  /* Logo container */
  .bf25-hero-logo-container {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Logo - Desktop (50% smaller total - was 40%, now 20% more) */
  .bf25-hero-logo {
    max-width: 336px !important;  /* 20% smaller than 420px */
    width: 48% !important;  /* 20% smaller than 60% */
    height: auto;
    margin-bottom: 8px !important;  /* Tight spacing */
    filter: drop-shadow(0 0 25px rgba(96, 198, 85, 0.3));
  }

  /* Desktop line widths */
  @media (min-width: 769px) {
    .bf25-hero-line-top {
      width: 250px;
    }

    .bf25-hero-line-bottom {
      width: 500px;
    }
  }

  /* Large desktop */
  @media (min-width: 1200px) {
    .bf25-hero-line-bottom {
      width: 600px;
    }
  }

  /* ========== MOBILE - 40% SMALLER LOGO + MINIMAL PADDING ========== */
  @media (max-width: 768px) {
    .bf25-hero-header {
      padding: 10px 15px 8px !important;  /* Very compact */
    }

    .bf25-hero-logo {
      max-width: 240px !important;  /* 40% smaller */
      width: 75% !important;
      margin-bottom: 8px !important;
    }

    .bf25-hero-line-top {
      width: 100px;
    }

    .bf25-hero-line-bottom {
      width: 200px;
    }
  }

  /* Extra small phones */
  @media (max-width: 400px) {
    .bf25-hero-header {
      padding: 10px 10px 8px !important;
    }

    .bf25-hero-logo {
      max-width: 200px !important;  /* Even smaller for tiny screens */
      width: 85% !important;
      margin-bottom: 8px !important;
    }
  }

  /* ========== EXISTING STYLES ========== */

   .font-sans {
        font-family: "Work Sans", serif;
        font-weight: 600;
   }
   .font-bold {
        font-weight: 900;
   }
  /* ========== TIER BOXES - COMPACT LAYOUT ========== */
  .custom-pack-wrapper {
    max-width: 1300px;
    padding: 12px 10px 15px !important;  /* Compact padding */
    margin: 0 auto;
  }

  .block-item {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    border-right: 4px solid white;
    align-items: center;
    justify-content: center;
    padding: 10px 8px 12px !important;  /* Compact internal padding */
    min-height: auto !important;
  }

  .block-item:last-child {
    border-right: none;
  }

  /* Desktop - Much more compact */
  @media (min-width: 768px) {
    .block-items {
      flex-direction: row;
      max-width: 650px !important;
      margin: 0 auto;
      gap: 10px;
    }

    .custom-pack-wrapper {
      padding: 12px 10px 15px !important;  /* Keep it compact on desktop too */
    }

    /* Smaller discount numbers on desktop */
    .block-item h3 {
      font-size: 50px !important;  /* was 80px */
    }

    /* Smaller % sign */
    .block-item h3 div {
      font-size: 16px !important;  /* was 52px */
    }

    /* Smaller items label on desktop */
    .block-item > div:first-child {
      font-size: 14px !important;  /* was 30px */
      margin-bottom: 2px !important;
    }
  }
</style>

<section class="bg-black text-center">
  {% if section.settings.show_banner %}
  <header class="bf25-hero-header">
    <!-- Top subtle line -->
    <div class="bf25-hero-line-top"></div>

    <!-- Logo container -->
    <div class="bf25-hero-logo-container">
      <img
        src="{{ section.settings.banner_image | img_url:'master' }}"
        alt="Black Friday Power Up Sale"
        class="bf25-hero-logo"
        width="700"
        height="350"
        loading="eager"
      >
    </div>

    <!-- Bottom subtle line -->
    <div class="bf25-hero-line-bottom"></div>
  </header>
  {% endif %}
  <div class="custom-pack-wrapper">
    {% if section.settings.section_title %}
      <h2 class="text-white text-[30px] md:text-[60px] font-sans font-bold relative">

        {{ section.settings.section_title }}
      </h2>
    {% endif %}
    {% if section.settings.section_eyebrow %}
      <div class="text-[#60c655] text-[18px] md:text-[24px] mb-[20px]">
        {{ section.settings.section_eyebrow }}
      </div>
    {% endif %}

    <div class="block-items flex flex-row md:flex-row max-w-[800px] mx-auto">
      {% for block in section.blocks limit: 3 %}
        <div class="block-item">
          {% if block.settings.eyebrow_position == false %}
            <div class="text-[#60c655] text-[16px] md:text-[30px] leading-[1]">
              {{ block.settings.block_eyebrow }}
            </div>
          {% endif %}

          <h3 class="text-white text-[40px] md:text-[80px] font-sans leading-[1] relative">
            <div class="text-[27px] md:text-[52px] absolute top-0 right-0">%</div>
            <span>{{ block.settings.block_title }}</span><span class="text-[11px] md:text-[22px]"> OFF</span>
          </h3>

          {% if block.settings.eyebrow_position %}
            <div class="text-[#60c655] text-[16px] md:text-[30px] leading-[1]">
              {{ block.settings.block_eyebrow }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Shopify Section: Custom Pack Builder -->
{% schema %}
{
  "name": "BF Promo Discount",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "Show Banner",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Build a Custom Pack"
    },
    {
      "type": "text",
      "id": "section_eyebrow",
      "label": "Section Eyebrow"
    }
  ],
  "blocks": [
    {
      "type": "block_item",
      "name": "Block Item",
      "settings": [
        {
          "type": "text",
          "id": "block_eyebrow",
          "label": "Block Eyebrow",
          "default": "4+ items"
        },
        {
          "type": "text",
          "id": "block_title",
          "label": "Block Title"
        },
        {
          "type": "checkbox",
          "id": "eyebrow_position",
          "label": "Eyebrow below title",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bf Promo Discount",
      "category": "Custom"
    }
  ]
}
{% endschema %}