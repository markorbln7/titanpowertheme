{% comment %}
  BF25 Hero Split Section
  - Split layout: 85% visual | Content with steps
  - Battery countdown timer
  - Currency-aware gift value
  - Energy text animation
{% endcomment %}

{% liquid
  assign gift_value_usd = section.settings.gift_value_usd | default: 275
  assign end_date_friday = section.settings.friday_end | default: '2025-11-29T07:59:59Z'
  assign end_date_sunday = section.settings.sunday_end | default: '2025-12-01T07:59:59Z'
  assign headline_start = section.settings.headline_start | default: "This Shouldn't"
  assign headline_energy = section.settings.headline_energy | default: "Exist."
  assign cta_link = section.settings.cta_link | default: "#bf25-bundle-builder"
  assign cta_text = section.settings.cta_text | default: "BUILD YOUR DEAL →"
%}

<section class="bf25-hero-split" data-section-id="{{ section.id }}">
  <!-- Main Hero Grid -->
  <div class="bf25-hero-grid">

    <!-- LEFT: Visual Side -->
    <div class="bf25-hero-visual">
      <div class="bf25-hero-visual-content">
        <div class="bf25-big-number">
          85<span class="bf25-percent">%</span>
        </div>
        <div class="bf25-big-label">Maximum Savings</div>
      </div>
    </div>

    <!-- RIGHT: Content Side -->
    <div class="bf25-hero-content">
      <!-- Logo -->
      <img
        src="{{ 'Black_Friday_Power_up_sale_badge33.png' | file_img_url: '400x' }}"
        alt="Black Friday Power Up Sale"
        class="bf25-hero-logo"
        loading="eager"
        width="200"
        height="auto"
      >

      <!-- Headline with energy animation -->
      <h1 class="bf25-hero-headline">
        {{ headline_start }} <span class="bf25-energy-text">{{ headline_energy }}</span>
      </h1>

      <!-- Subline with currency-aware gift value -->
      <p class="bf25-hero-subline">
        Add more. Pay less. Walk away with
        <span class="bf25-gift-value" data-usd-value="{{ gift_value_usd }}">
          <span class="money" data-currency-original="USD" data-currency="{{ cart.currency.iso_code }}">
            ${{ gift_value_usd }}
          </span>
        </span>
        in free gifts.
        <span class="bf25-cheeky">(We did this to ourselves.)</span>
      </p>

      <!-- Steps -->
      <div class="bf25-hero-steps">
        <div class="bf25-hero-step">
          <span class="bf25-step-num">1</span>
          <span><strong>Add any item</strong> <span class="bf25-step-detail">— cables, chargers, power banks, audio</span></span>
        </div>
        <div class="bf25-hero-step">
          <span class="bf25-step-num">2</span>
          <span><strong>Watch your discount grow</strong> <span class="bf25-step-detail">— 60% → 85%</span></span>
        </div>
        <div class="bf25-hero-step">
          <span class="bf25-step-num">3</span>
          <span><strong>Unlock 4 free gifts</strong> <span class="bf25-step-detail">— up to <span class="money" data-currency-original="USD">${{ gift_value_usd }}</span> added free</span></span>
        </div>
      </div>

      <!-- CTA Row -->
      <div class="bf25-cta-row">
        <a href="{{ cta_link }}" class="bf25-cta-button">
          {{ cta_text }}
        </a>
        <div class="bf25-timer-inline">
          <span class="bf25-pulse-dot"></span>
          <span class="bf25-timer-text">Ends in <span class="bf25-countdown-short">2d 22h</span></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Urgency Strip -->
  <div class="bf25-urgency-strip">
    <div class="bf25-urgency-group">
      <div class="bf25-urgency-label">
        <span class="bf25-pulse-dot"></span>
        <span>Black Friday Ends</span>
      </div>
      <div class="bf25-battery-container">
        <div class="bf25-battery-body">
          <div class="bf25-battery-fill"></div>
          <div class="bf25-battery-text">
            <svg class="bf25-bolt-icon" viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            <span class="bf25-countdown-battery">2d 22h 48m</span>
            <svg class="bf25-bolt-icon" viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
        </div>
        <div class="bf25-battery-cap"></div>
      </div>
    </div>

    <div class="bf25-social-item">
      <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
      <span><strong>1M+</strong> customers</span>
    </div>

    <div class="bf25-social-item">
      <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
      <span><strong>55K+</strong> 5-star reviews</span>
    </div>

    <!-- Mobile Social Row -->
    <div class="bf25-social-row-mobile">
      <div class="bf25-social-item">
        <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
        <span><strong>1M+</strong> customers</span>
      </div>

      <div class="bf25-social-item">
        <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        <span><strong>55K+</strong> 5-star reviews</span>
      </div>
    </div>
  </div>
</section>

<style>
/* ========================================
   BF25 HERO SPLIT - CORE STYLES
   ======================================== */

.bf25-hero-split {
  background: #000;
  color: #fff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* ========================================
   ENERGY FLOW ANIMATION
   ======================================== */

@keyframes bf25EnergyFlow {
  0% { background-position: 200% center; }
  100% { background-position: -200% center; }
}

.bf25-energy-text {
  background: linear-gradient(
    90deg,
    #4CAF50 0%,
    #60c655 20%,
    #7FFF00 40%,
    #39FF14 50%,
    #7FFF00 60%,
    #60c655 80%,
    #4CAF50 100%
  );
  background-size: 200% 100%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-weight: 900;
  filter: drop-shadow(0 0 4px rgba(96, 198, 85, 0.5));
  animation: bf25EnergyFlow 3000ms linear infinite;
  display: inline-block;
}

@keyframes bf25Pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

@keyframes bf25BatteryPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.85; }
}

/* ========================================
   HERO GRID - DESKTOP
   ======================================== */

.bf25-hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 360px;
}

/* LEFT: Visual Side */
.bf25-hero-visual {
  background: linear-gradient(135deg, #030303 0%, #080808 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 50px 40px;
  position: relative;
  overflow: hidden;
}

.bf25-hero-visual::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 350px;
  height: 350px;
  background: radial-gradient(circle, rgba(96, 198, 85, 0.08) 0%, transparent 70%);
  pointer-events: none;
}

.bf25-hero-visual-content {
  position: relative;
  z-index: 1;
  text-align: center;
}

.bf25-big-number {
  font-size: 150px;
  font-weight: 700;
  line-height: 0.85;
  color: #fff;
  display: flex;
  align-items: baseline;
  justify-content: center;
  letter-spacing: -3px;
}

.bf25-percent {
  font-size: 70px;
  color: #60c655;
  margin-left: 2px;
  font-weight: 700;
  letter-spacing: 0;
}

.bf25-big-label {
  font-size: 14px;
  font-weight: 600;
  color: #60c655;
  letter-spacing: 4px;
  text-transform: uppercase;
  margin-top: 10px;
}

/* RIGHT: Content Side */
.bf25-hero-content {
  background: #000;
  padding: 35px 40px 32px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.bf25-hero-logo {
  max-width: 200px;
  height: auto;
  margin-bottom: 16px;
}

.bf25-hero-headline {
  font-size: 30px;
  font-weight: 800;
  line-height: 1.15;
  margin: 0 0 6px 0;
  color: #fff;
}

.bf25-hero-subline {
  font-size: 14px;
  color: rgba(255,255,255,0.6);
  margin: 0 0 18px 0;
  line-height: 1.5;
}

.bf25-cheeky {
  color: rgba(255,255,255,0.4);
  font-style: italic;
}

/* Steps */
.bf25-hero-steps {
  margin-bottom: 20px;
}

.bf25-hero-step {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin-bottom: 8px;
  font-size: 13px;
  color: rgba(255,255,255,0.7);
  line-height: 1.4;
}

.bf25-step-num {
  width: 22px;
  height: 22px;
  background: rgba(96, 198, 85, 0.12);
  border: 1px solid rgba(96, 198, 85, 0.4);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 700;
  color: #60c655;
  flex-shrink: 0;
  margin-top: 1px;
}

.bf25-hero-step strong {
  color: #fff;
  font-weight: 600;
}

.bf25-step-detail {
  color: rgba(255,255,255,0.5);
}

/* CTA Row */
.bf25-cta-row {
  display: flex;
  align-items: center;
  gap: 15px;
}

.bf25-cta-button {
  background: linear-gradient(180deg, #6dd56d 0%, #60c655 50%, #4CAF50 100%);
  color: #000;
  font-size: 14px;
  font-weight: 800;
  padding: 14px 30px;
  border: none;
  border-radius: 10px;
  cursor: pointer;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  text-decoration: none;
  display: inline-block;
  box-shadow:
    0 0 20px rgba(96, 198, 85, 0.4),
    0 4px 15px rgba(96, 198, 85, 0.3),
    0 2px 4px rgba(0, 0, 0, 0.3),
    inset 0 1px 0 rgba(255, 255, 255, 0.2);
  transition: all 0.15s ease;
}

.bf25-cta-button:hover {
  transform: translateY(-2px);
  box-shadow:
    0 0 28px rgba(96, 198, 85, 0.5),
    0 6px 20px rgba(96, 198, 85, 0.4),
    inset 0 1px 0 rgba(255, 255, 255, 0.25);
  color: #000;
  text-decoration: none;
}

.bf25-timer-inline {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: rgba(255,255,255,0.45);
}

.bf25-pulse-dot {
  width: 5px;
  height: 5px;
  background: #ff4757;
  border-radius: 50%;
  animation: bf25Pulse 1.5s infinite;
}

/* ========================================
   URGENCY STRIP
   ======================================== */

.bf25-urgency-strip {
  background: rgba(12, 12, 12, 0.98);
  border-top: 1px solid rgba(255, 71, 87, 0.12);
  padding: 12px 35px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 28px;
}

.bf25-urgency-group {
  display: flex;
  align-items: center;
  gap: 10px;
}

.bf25-urgency-label {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 10px;
  color: #ff4757;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.8px;
}

/* Battery */
.bf25-battery-container {
  display: flex;
  align-items: center;
}

.bf25-battery-body {
  width: 155px;
  height: 28px;
  background: rgba(18, 18, 18, 0.95);
  border: 2px solid #883344;
  border-radius: 5px;
  position: relative;
  overflow: hidden;
}

.bf25-battery-cap {
  width: 5px;
  height: 12px;
  background: #883344;
  border-radius: 0 3px 3px 0;
}

.bf25-battery-fill {
  position: absolute;
  left: 2px;
  top: 2px;
  bottom: 2px;
  width: 35%;
  background: linear-gradient(90deg, #662233, #883344, #772233);
  border-radius: 3px;
  animation: bf25BatteryPulse 3s ease-in-out infinite;
  transition: width 1s ease;
}

.bf25-battery-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 11px;
  font-weight: 700;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 5px;
  text-shadow: 0 1px 2px rgba(0,0,0,0.8);
  white-space: nowrap;
}

.bf25-bolt-icon {
  width: 10px;
  height: 10px;
  fill: #fff;
}

/* Social Items - hide on desktop in urgency strip */
.bf25-urgency-strip > .bf25-social-item {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 12px;
  color: rgba(255,255,255,0.5);
}

.bf25-social-item svg {
  width: 13px;
  height: 13px;
  fill: #60c655;
}

.bf25-social-item strong {
  color: #fff;
}

/* Mobile social row - hide on desktop */
.bf25-social-row-mobile {
  display: none;
}

/* ========================================
   MOBILE STYLES
   ======================================== */

@media (max-width: 768px) {
  .bf25-hero-grid {
    grid-template-columns: 1fr;
    min-height: auto;
  }

  .bf25-hero-visual {
    padding: 20px 16px 15px;
    order: 1;
  }

  .bf25-hero-visual::before {
    width: 250px;
    height: 250px;
  }

  .bf25-big-number {
    font-size: 90px;
    font-weight: 700;
    letter-spacing: -2px;
  }

  .bf25-percent {
    font-size: 40px;
    margin-left: 2px;
  }

  .bf25-big-label {
    font-size: 9px;
    letter-spacing: 2px;
    margin-top: 5px;
  }

  .bf25-hero-content {
    padding: 16px 16px 18px;
    order: 2;
    text-align: center;
  }

  .bf25-hero-logo {
    max-width: 140px;
    margin: 0 auto 10px;
  }

  .bf25-hero-headline {
    font-size: 19px;
    margin-bottom: 5px;
  }

  .bf25-hero-subline {
    font-size: 11px;
    margin-bottom: 4px;
  }

  /* Cheeky on separate line on mobile */
  .bf25-cheeky {
    display: block;
    margin-top: 4px;
    margin-bottom: 12px;
    font-size: 10px;
  }

  .bf25-hero-steps {
    text-align: left;
    margin-bottom: 14px;
    padding: 0 5px;
  }

  .bf25-hero-step {
    font-size: 10px;
    margin-bottom: 5px;
    gap: 8px;
  }

  .bf25-step-num {
    width: 18px;
    height: 18px;
    font-size: 9px;
  }

  .bf25-cta-row {
    flex-direction: column;
    gap: 8px;
  }

  .bf25-cta-button {
    font-size: 12px;
    padding: 12px 24px;
    width: 100%;
    max-width: 240px;
  }

  .bf25-timer-inline {
    font-size: 9px;
  }

  /* Mobile Urgency Strip */
  .bf25-urgency-strip {
    flex-direction: column;
    gap: 10px;
    padding: 10px 12px;
  }

  .bf25-urgency-group {
    width: 100%;
    justify-content: center;
    gap: 8px;
  }

  .bf25-urgency-label {
    font-size: 8px;
  }

  .bf25-urgency-label span:last-child {
    display: none; /* Hide "Black Friday Ends" text */
  }

  .bf25-urgency-label::after {
    content: 'Ends';
  }

  .bf25-battery-body {
    width: 100px;
    height: 22px;
  }

  .bf25-battery-cap {
    width: 4px;
    height: 9px;
  }

  .bf25-battery-text {
    font-size: 9px;
    gap: 3px;
  }

  .bf25-bolt-icon {
    width: 8px;
    height: 8px;
  }

  /* Hide social items in urgency strip on mobile */
  .bf25-urgency-strip > .bf25-social-item {
    display: none;
  }

  /* Show social row on mobile - more visible */
  .bf25-social-row-mobile {
    display: flex;
    justify-content: center;
    gap: 20px;
    width: 100%;
    padding-top: 8px;
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .bf25-social-row-mobile .bf25-social-item {
    display: flex;
    font-size: 11px;
  }

  .bf25-social-row-mobile .bf25-social-item svg {
    width: 12px;
    height: 12px;
  }
}

/* Extra small screens */
@media (max-width: 375px) {
  .bf25-big-number {
    font-size: 75px;
  }

  .bf25-percent {
    font-size: 24px;
  }

  .bf25-hero-headline {
    font-size: 17px;
  }

  .bf25-hero-step {
    font-size: 9px;
  }
}

/* Tablet */
@media (min-width: 769px) and (max-width: 1024px) {
  .bf25-hero-grid {
    min-height: 320px;
  }

  .bf25-big-number {
    font-size: 120px;
  }

  .bf25-percent {
    font-size: 40px;
  }

  .bf25-hero-content {
    padding: 30px 30px 28px;
  }

  .bf25-hero-headline {
    font-size: 26px;
  }
}

/* Large desktop */
@media (min-width: 1200px) {
  .bf25-hero-grid {
    min-height: 400px;
  }

  .bf25-big-number {
    font-size: 170px;
  }

  .bf25-percent {
    font-size: 55px;
  }

  .bf25-hero-content {
    padding: 40px 50px 38px;
  }

  .bf25-hero-headline {
    font-size: 34px;
  }

  .bf25-hero-subline {
    font-size: 15px;
  }
}
</style>

<script>
(function() {
  'use strict';

  // Timer configuration (PST timezone)
  const FRIDAY_END_UTC = new Date('{{ end_date_friday }}').getTime();
  const SATURDAY_SHOW_UTC = new Date('2025-11-29T14:00:00Z').getTime(); // Saturday 6:00 AM PST
  const SUNDAY_END_UTC = new Date('{{ end_date_sunday }}').getTime();
  const SALE_START_UTC = new Date('2025-11-26T08:00:00Z').getTime(); // Wednesday 12:00 AM PST

  function getTimerState() {
    const now = Date.now();

    // Before Friday end
    if (now < FRIDAY_END_UTC) {
      return {
        endTime: FRIDAY_END_UTC,
        startTime: SALE_START_UTC,
        show: true
      };
    }

    // Friday ended, before Saturday 6am - hide timer
    if (now < SATURDAY_SHOW_UTC) {
      return { show: false };
    }

    // Saturday 6am onwards until Sunday end
    if (now < SUNDAY_END_UTC) {
      return {
        endTime: SUNDAY_END_UTC,
        startTime: SATURDAY_SHOW_UTC,
        show: true
      };
    }

    // Sale ended
    return { show: false, ended: true };
  }

  function formatTime(ms) {
    if (ms <= 0) return { days: 0, hours: 0, minutes: 0, seconds: 0 };

    const seconds = Math.floor((ms / 1000) % 60);
    const minutes = Math.floor((ms / (1000 * 60)) % 60);
    const hours = Math.floor((ms / (1000 * 60 * 60)) % 24);
    const days = Math.floor(ms / (1000 * 60 * 60 * 24));

    return { days, hours, minutes, seconds };
  }

  function updateCountdown() {
    const state = getTimerState();
    const section = document.querySelector('.bf25-hero-split');

    if (!section) return;

    if (!state.show) {
      if (state.ended) {
        section.style.display = 'none';
      }
      return;
    }

    const now = Date.now();
    const timeRemaining = state.endTime - now;
    const time = formatTime(timeRemaining);

    // Update countdown displays
    const shortDisplay = section.querySelector('.bf25-countdown-short');
    const batteryDisplay = section.querySelector('.bf25-countdown-battery');

    if (shortDisplay) {
      shortDisplay.textContent = `${time.days}d ${time.hours}h`;
    }

    if (batteryDisplay) {
      batteryDisplay.textContent = `${time.days}d ${time.hours}h ${time.minutes}m`;
    }

    // Update battery fill based on time remaining
    const batteryFill = section.querySelector('.bf25-battery-fill');
    if (batteryFill) {
      const totalDuration = state.endTime - state.startTime;
      const percentRemaining = Math.max(0, Math.min(100, (timeRemaining / totalDuration) * 100));
      batteryFill.style.width = `${percentRemaining}%`;
    }
  }

  // Initialize
  document.addEventListener('DOMContentLoaded', function() {
    updateCountdown();
    setInterval(updateCountdown, 1000);

    // Trigger currency converter if available
    if (typeof Currency !== 'undefined' && Currency.convertAll) {
      setTimeout(function() {
        Currency.convertAll(Currency.currentCurrency, Currency.currentCurrency);
      }, 100);
    }
  });
})();
</script>

{% schema %}
{
  "name": "BF25 Hero Split",
  "tag": "section",
  "class": "bf25-hero-split-section",
  "settings": [
    {
      "type": "header",
      "content": "Hero Content"
    },
    {
      "type": "text",
      "id": "headline_start",
      "label": "Headline Start",
      "default": "This Shouldn't"
    },
    {
      "type": "text",
      "id": "headline_energy",
      "label": "Headline Energy Text",
      "default": "Exist."
    },
    {
      "type": "number",
      "id": "gift_value_usd",
      "label": "Free Gift Value (USD)",
      "default": 275
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "CTA Button Link",
      "default": "#bf25-bundle-builder",
      "info": "Use # for anchor links or full URL"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "BUILD YOUR DEAL →"
    },
    {
      "type": "header",
      "content": "Timer Settings"
