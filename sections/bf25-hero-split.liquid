{{ 'bf25-hero.css' | asset_url | stylesheet_tag }}

{% comment %}
  BF25 Hero Split Section
  - Split layout: 85% visual | Content with steps
  - Battery countdown timer
  - Currency-aware gift value
  - Energy text animation
{% endcomment %}

{% liquid
  assign gift_value_usd = section.settings.gift_value_usd | default: 275
  assign end_date_friday = section.settings.friday_end | default: '2025-11-29T07:59:59Z'
  assign end_date_sunday = section.settings.sunday_end | default: '2025-12-01T07:59:59Z'
  assign headline_start = section.settings.headline_start | default: "This Shouldn't"
  assign headline_energy = section.settings.headline_energy | default: "Exist."
  assign cta_link = section.settings.cta_link | default: "#bf25-bundle-builder"
  assign cta_text = section.settings.cta_text | default: "BUILD YOUR DEAL →"
%}

<section class="bf25-hero-split" data-section-id="{{ section.id }}">
  <!-- Main Hero Grid -->
  <div class="bf25-hero-grid">

    <!-- LEFT: Visual Side -->
    <div class="bf25-hero-visual">
      <!-- Floating Products (decorative) -->
      <img src="https://cdn.shopify.com/s/files/1/0071/1727/5191/files/T462.png?v=1764251682"
           alt=""
           class="bf25-floating-product bf25-floating-cable"
           loading="lazy"
           aria-hidden="true">
      <img src="https://cdn.shopify.com/s/files/1/0071/1727/5191/files/T1023.png?v=1764251682"
           alt=""
           class="bf25-floating-product bf25-floating-earbuds"
           loading="lazy"
           aria-hidden="true">

      <div class="bf25-hero-visual-content">
        <div class="bf25-big-number">
          85<span class="bf25-percent">%</span>
        </div>
        <div class="bf25-big-label">Maximum Savings</div>
      </div>
    </div>

    <!-- RIGHT: Content Side -->
    <div class="bf25-hero-content">
      <!-- Logo -->
      <img
        src="https://cdn.shopify.com/s/files/1/0071/1727/5191/files/neon_2_1.png?v=1764249758"
        alt="Black Friday Power Up Sale"
        class="bf25-hero-logo"
        loading="eager"
        width="200"
        height="auto"
      >

      <!-- Headline with energy animation - "Exist." on separate line -->
      <h1 class="bf25-hero-headline">
        {{ headline_start }}<br>
        <span class="bf25-energy-text">{{ headline_energy }}</span>
      </h1>

      <!-- Subline with currency-aware gift value -->
      <p class="bf25-hero-subline">
        Add more. Pay less. Walk away with
        <span class="bf25-gift-value" data-usd-value="{{ gift_value_usd }}">
          <span class="money" data-currency-original="USD" data-currency="{{ cart.currency.iso_code }}">
            {{ cart.currency.symbol }}{{ gift_value_usd }}
          </span>
        </span>
        in free gifts.
      </p>
      <p class="bf25-cheeky">(We did this to ourselves.)</p>

      <!-- Steps (Timeline Style) -->
      <div class="bf25-hero-steps">
        <div class="bf25-hero-step">
          <span class="bf25-step-num">1</span>
          <span><strong>Add any item</strong> <span class="bf25-step-detail">— cables, chargers, power banks, audio</span></span>
        </div>
        <div class="bf25-hero-step">
          <span class="bf25-step-num">2</span>
          <span><strong>Watch your discount grow</strong> <span class="bf25-step-detail">— savings up to 85%</span></span>
        </div>
        <div class="bf25-hero-step">
          <span class="bf25-step-num">3</span>
          <span><strong>Unlock 4 free gifts</strong> <span class="bf25-step-detail">— up to <span class="money" data-currency-original="USD" data-usd-value="{{ gift_value_usd }}">{{ cart.currency.symbol }}{{ gift_value_usd }}</span> added free</span></span>
        </div>
      </div>

      <!-- CTA Row -->
      <div class="bf25-cta-row">
        <a href="#PowerPairsBF25" class="bf25-cta-button" data-scroll-to="power-pairs">
          {{ cta_text }}
        </a>
        <div class="bf25-timer-inline">
          <span class="bf25-pulse-dot"></span>
          <span class="bf25-timer-text">Ends in <span class="bf25-countdown-short">2d 22h</span></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Urgency Strip -->
  <div class="bf25-urgency-strip">
    <div class="bf25-urgency-group">
      <div class="bf25-urgency-label">
        <span class="bf25-pulse-dot"></span>
        <span>Black Friday Ends</span>
      </div>
      <div class="bf25-battery-container">
        <div class="bf25-battery-body">
          <div class="bf25-battery-fill"></div>
          <div class="bf25-battery-text">
            <svg class="bf25-bolt-icon" viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            <span class="bf25-countdown-battery">2d 22h 48m</span>
            <svg class="bf25-bolt-icon" viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
        </div>
        <div class="bf25-battery-cap"></div>
      </div>
    </div>

    <div class="bf25-social-item">
      <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
      <span><strong>1M+</strong> customers</span>
    </div>

    <div class="bf25-social-item">
      <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
      <span><strong>55K+</strong> 5-star reviews</span>
    </div>

    <!-- Mobile Social Row -->
    <div class="bf25-social-row-mobile">
      <div class="bf25-social-item">
        <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
        <span><strong>1M+</strong> customers</span>
      </div>

      <div class="bf25-social-item">
        <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        <span><strong>55K+</strong> 5-star reviews</span>
      </div>
    </div>
  </div>
</section>

<style>
/* ========================================
   BF25 HERO SPLIT - CORE STYLES
   ======================================== */

.bf25-hero-split {
  background: transparent;
  color: #fff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* ========================================
   ENERGY FLOW ANIMATION
   ======================================== */

@keyframes bf25EnergyFlow {
  0% { background-position: 200% center; }
  100% { background-position: -200% center; }
}

.bf25-energy-text {
  background: linear-gradient(
    90deg,
    #4CAF50 0%,
    #60c655 20%,
    #7FFF00 40%,
    #39FF14 50%,
    #7FFF00 60%,
    #60c655 80%,
    #4CAF50 100%
  );
  background-size: 200% 100%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-weight: 900;
  filter: drop-shadow(0 0 6px rgba(96, 198, 85, 0.6));
  animation: bf25EnergyFlow 3000ms linear infinite;
  display: inline-block;
  font-size: 1.1em;
}

@keyframes bf25Pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

@keyframes bf25BatteryPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.85; }
}

/* Confetti animation */
@keyframes bf25ConfettiFall {
  0% { transform: translateY(-100%) rotate(0deg); opacity: 1; }
  100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
}

.bf25-confetti {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 9999;
  overflow: hidden;
}

.bf25-confetti-piece {
  position: absolute;
  width: 10px;
  height: 10px;
  animation: bf25ConfettiFall 3s ease-out forwards;
}

/* ========================================
   HERO GRID - DESKTOP
   ======================================== */

.bf25-hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 420px;
}

/* LEFT: Visual Side - CENTERED */
.bf25-hero-visual {
  background: #000;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 50px 60px;
  position: relative;
  overflow: hidden;
}

.bf25-hero-visual::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 400px;
  height: 400px;
  background: radial-gradient(circle, rgba(96, 198, 85, 0.1) 0%, transparent 70%);
  pointer-events: none;
}

.bf25-hero-visual-content {
  position: relative;
  z-index: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 85% NUMBER - PROPERLY CENTERED WITH INLINE % */
.bf25-big-number {
  font-size: 180px;
  font-weight: 700;
  line-height: 1;
  color: #fff;
  display: inline-flex;
  align-items: baseline;
  justify-content: center;
  letter-spacing: -6px;
}

.bf25-percent {
  font-size: 50px;  /* Base size - will be overridden by media queries */
  color: #60c655;
  font-weight: 700;
  letter-spacing: 0;
  margin-left: 4px;
}

.bf25-big-label {
  font-size: 15px;
  font-weight: 600;
  color: #60c655;
  letter-spacing: 5px;
  text-transform: uppercase;
  margin-top: 15px;
}

/* RIGHT: Content Side - TRANSPARENT BACKGROUND */
.bf25-hero-content {
  background: #000;
  padding: 45px 50px 50px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.bf25-hero-logo {
  max-width: 200px;
  height: auto;
  margin-bottom: 24px;
}

/* HEADLINE - EXIST ON SEPARATE LINE */
.bf25-hero-headline {
  font-size: 36px;
  font-weight: 800;
  line-height: 1.1;
  margin: 0 0 12px 0;
  color: #fff;
}

.bf25-hero-subline {
  font-size: 15px;
  color: rgba(255,255,255,0.65);
  margin: 0 0 8px 0;
  line-height: 1.6;
}

/* CHEEKY - SEPARATE LINE */
.bf25-cheeky {
  color: rgba(255,255,255,0.4);
  font-style: italic;
  font-size: 14px;
  margin: 0 0 20px 0;
}

/* Steps */
.bf25-hero-steps {
  margin-bottom: 24px;
}

.bf25-hero-step {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 10px;
  font-size: 14px;
  color: rgba(255,255,255,0.75);
  line-height: 1.5;
}

.bf25-step-num {
  width: 24px;
  height: 24px;
  background: rgba(96, 198, 85, 0.15);
  border: 1px solid rgba(96, 198, 85, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  color: #60c655;
  flex-shrink: 0;
  margin-top: 2px;
}

.bf25-hero-step strong {
  color: #fff;
  font-weight: 600;
}

.bf25-step-detail {
  color: rgba(255,255,255,0.5);
}

/* CTA Row */
.bf25-cta-row {
  display: flex;
  align-items: center;
  gap: 18px;
}

.bf25-cta-button {
  background: linear-gradient(180deg, #6dd56d 0%, #60c655 50%, #4CAF50 100%);
  color: #000;
  font-size: 15px;
  font-weight: 800;
  padding: 16px 36px;
  border: none;
  border-radius: 12px;
  cursor: pointer;
  text-transform: uppercase;
  letter-spacing: 1px;
  text-decoration: none;
  display: inline-block;
  box-shadow:
    0 0 25px rgba(96, 198, 85, 0.45),
    0 4px 20px rgba(96, 198, 85, 0.35),
    0 2px 4px rgba(0, 0, 0, 0.3),
    inset 0 1px 0 rgba(255, 255, 255, 0.25);
  transition: all 0.2s ease;
}

.bf25-cta-button:hover {
  transform: translateY(-3px);
  box-shadow:
    0 0 35px rgba(96, 198, 85, 0.55),
    0 8px 25px rgba(96, 198, 85, 0.45),
    inset 0 1px 0 rgba(255, 255, 255, 0.3);
  color: #000;
  text-decoration: none;
}

.bf25-timer-inline {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: rgba(255,255,255,0.5);
}

.bf25-pulse-dot {
  width: 6px;
  height: 6px;
  background: #ff4757;
  border-radius: 50%;
  animation: bf25Pulse 1.5s infinite;
}

/* ========================================
   URGENCY STRIP - NO RED BORDER
   ======================================== */

.bf25-urgency-strip {
  background: rgba(8, 8, 8, 0.95);
  border-top: none;
  padding: 16px 40px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 40px;
}

.bf25-urgency-group {
  display: flex;
  align-items: center;
  gap: 12px;
}

.bf25-urgency-label {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  color: #ff6b7a;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1px;
}

/* Battery - LIGHTER RED */
.bf25-battery-container {
  display: flex;
  align-items: center;
}

.bf25-battery-body {
  width: 160px;
  height: 30px;
  background: rgba(20, 20, 20, 0.95);
  border: 2px solid #cc5566;
  border-radius: 6px;
  position: relative;
  overflow: hidden;
}

.bf25-battery-cap {
  width: 6px;
  height: 14px;
  background: #cc5566;
  border-radius: 0 3px 3px 0;
}

.bf25-battery-fill {
  position: absolute;
  left: 2px;
  top: 2px;
  bottom: 2px;
  width: 35%;
  background: linear-gradient(90deg, #884455, #aa5566, #995566);
  border-radius: 4px;
  animation: bf25BatteryPulse 3s ease-in-out infinite;
  transition: width 1s ease;
}

.bf25-battery-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 12px;
  font-weight: 700;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 6px;
  text-shadow: 0 1px 3px rgba(0,0,0,0.9);
  white-space: nowrap;
}

.bf25-bolt-icon {
  width: 11px;
  height: 11px;
  fill: #fff;
}

/* Social Items */
.bf25-urgency-strip > .bf25-social-item {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  color: rgba(255,255,255,0.55);
}

.bf25-social-item svg {
  width: 14px;
  height: 14px;
  fill: #60c655;
}

.bf25-social-item strong {
  color: #fff;
}

/* Mobile social row - hide on desktop */
.bf25-social-row-mobile {
  display: none;
}

/* ========================================
   MOBILE STYLES
   ======================================== */

@media (max-width: 768px) {
  .bf25-hero-grid {
    grid-template-columns: 1fr;
    min-height: auto;
  }

  .bf25-hero-visual {
    padding: 25px 20px 20px;
    order: 1;
  }

  .bf25-hero-visual::before {
    width: 280px;
    height: 280px;
  }

  .bf25-big-number {
    font-size: 100px;
    letter-spacing: -3px;
  }

  .bf25-percent {
    font-size: 42px;
    margin-left: 3px;
  }

  .bf25-big-label {
    font-size: 10px;
    letter-spacing: 3px;
    margin-top: 8px;
  }

  .bf25-hero-content {
    padding: 20px 18px 24px;
    order: 2;
    text-align: center;
  }

  .bf25-hero-logo {
    max-width: 150px;
    margin: 0 auto 16px;
  }

  .bf25-hero-headline {
    font-size: 24px;
    margin-bottom: 8px;
  }

  .bf25-hero-subline {
    font-size: 12px;
    margin-bottom: 6px;
  }

  .bf25-cheeky {
    font-size: 11px;
    margin-bottom: 16px;
  }

  .bf25-hero-steps {
    text-align: left;
    margin-bottom: 18px;
    padding: 0 8px;
  }

  .bf25-hero-step {
    font-size: 11px;
    margin-bottom: 7px;
    gap: 10px;
  }

  .bf25-step-num {
    width: 20px;
    height: 20px;
    font-size: 10px;
  }

  .bf25-cta-row {
    flex-direction: column;
    gap: 10px;
  }

  .bf25-cta-button {
    font-size: 13px;
    padding: 14px 28px;
    width: auto;
    min-width: 200px;
  }

  .bf25-timer-inline {
    font-size: 10px;
  }

  /* Mobile Urgency Strip */
  .bf25-urgency-strip {
    flex-direction: column;
    gap: 12px;
    padding: 14px 16px;
  }

  .bf25-urgency-group {
    justify-content: center;
    gap: 10px;
  }

  .bf25-urgency-label {
    font-size: 9px;
  }

  .bf25-battery-body {
    width: 110px;
    height: 24px;
  }

  .bf25-battery-cap {
    width: 5px;
    height: 11px;
  }

  .bf25-battery-text {
    font-size: 10px;
    gap: 4px;
  }

  .bf25-bolt-icon {
    width: 9px;
    height: 9px;
  }

  /* Hide social items in urgency strip on mobile */
  .bf25-urgency-strip > .bf25-social-item {
    display: none;
  }

  /* Show social row on mobile */
  .bf25-social-row-mobile {
    display: flex;
    justify-content: center;
    gap: 24px;
    width: 100%;
    padding-top: 10px;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .bf25-social-row-mobile .bf25-social-item {
    display: flex;
    font-size: 12px;
  }
}

/* Extra small screens */
@media (max-width: 375px) {
  .bf25-big-number {
    font-size: 85px;
  }

  .bf25-percent {
    font-size: 36px;
  }

  .bf25-hero-headline {
    font-size: 20px;
  }

  .bf25-hero-step {
    font-size: 10px;
  }
}

/* Tablet */
@media (min-width: 769px) and (max-width: 1024px) {
  .bf25-hero-grid {
    min-height: 360px;
  }

  .bf25-big-number {
    font-size: 140px;
  }

  .bf25-percent {
    font-size: 56px;
  }

  .bf25-hero-content {
    padding: 35px 35px 38px;
  }

  .bf25-hero-headline {
    font-size: 30px;
  }
}

/* Large desktop */
@media (min-width: 1200px) {
  .bf25-hero-grid {
    min-height: 450px;
  }

  .bf25-big-number {
    font-size: 200px;
    margin-left: 300px;
  }

  .bf25-percent {
    font-size: 50px !important;  /* Force 50px as requested */
  }

  .bf25-big-label {
    margin-left: 315px;
    margin-bottom: 20px;
    font-weight: 700;
    font-size: 18px;
  }

  .bf25-hero-content {
    padding: 50px 60px 55px;
  }

  .bf25-hero-headline {
    font-size: 42px;
  }

  .bf25-hero-subline {
    font-size: 16px;
  }
}
</style>

<script>
(function() {
  'use strict';

  // Timer configuration (PST timezone)
  const FRIDAY_END_UTC = new Date('{{ end_date_friday }}').getTime();
  const SATURDAY_SHOW_UTC = new Date('2025-11-29T14:00:00Z').getTime();
  const SUNDAY_END_UTC = new Date('{{ end_date_sunday }}').getTime();
  const SALE_START_UTC = new Date('2025-11-26T08:00:00Z').getTime();

  function getTimerState() {
    const now = Date.now();
    if (now < FRIDAY_END_UTC) {
      return { endTime: FRIDAY_END_UTC, startTime: SALE_START_UTC, show: true };
    }
    if (now < SATURDAY_SHOW_UTC) {
      return { show: false };
    }
    if (now < SUNDAY_END_UTC) {
      return { endTime: SUNDAY_END_UTC, startTime: SATURDAY_SHOW_UTC, show: true };
    }
    return { show: false, ended: true };
  }

  function formatTime(ms) {
    if (ms <= 0) return { days: 0, hours: 0, minutes: 0, seconds: 0 };
    const seconds = Math.floor((ms / 1000) % 60);
    const minutes = Math.floor((ms / (1000 * 60)) % 60);
    const hours = Math.floor((ms / (1000 * 60 * 60)) % 24);
    const days = Math.floor(ms / (1000 * 60 * 60 * 24));
    return { days, hours, minutes, seconds };
  }

  function updateCountdown() {
    const state = getTimerState();
    const section = document.querySelector('.bf25-hero-split');
    if (!section) return;

    if (!state.show) {
      if (state.ended) section.style.display = 'none';
      return;
    }

    const now = Date.now();
    const timeRemaining = state.endTime - now;
    const time = formatTime(timeRemaining);

    const shortDisplay = section.querySelector('.bf25-countdown-short');
    const batteryDisplay = section.querySelector('.bf25-countdown-battery');

    if (shortDisplay) shortDisplay.textContent = `${time.days}d ${time.hours}h`;
    if (batteryDisplay) batteryDisplay.textContent = `${time.days}d ${time.hours}h ${time.minutes}m`;

    const batteryFill = section.querySelector('.bf25-battery-fill');
    if (batteryFill) {
      const totalDuration = state.endTime - state.startTime;
      const percentRemaining = Math.max(0, Math.min(100, (timeRemaining / totalDuration) * 100));
      batteryFill.style.width = `${percentRemaining}%`;
    }
  }

  // CONFETTI FUNCTION
  function triggerConfetti() {
    const container = document.createElement('div');
    container.className = 'bf25-confetti';
    document.body.appendChild(container);

    const colors = ['#60c655', '#6dd56d', '#4CAF50', '#7FFF00', '#39FF14', '#fff', '#FFD700'];
    const shapes = ['square', 'circle'];

    for (let i = 0; i < 80; i++) {
      const piece = document.createElement('div');
      piece.className = 'bf25-confetti-piece';
      piece.style.left = Math.random() * 100 + '%';
      piece.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
      piece.style.borderRadius = shapes[Math.floor(Math.random() * shapes.length)] === 'circle' ? '50%' : '2px';
      piece.style.width = (Math.random() * 8 + 6) + 'px';
      piece.style.height = (Math.random() * 8 + 6) + 'px';
      piece.style.animationDelay = Math.random() * 0.5 + 's';
      piece.style.animationDuration = (Math.random() * 2 + 2) + 's';
      container.appendChild(piece);
    }

    setTimeout(() => container.remove(), 4000);
  }

  // SMOOTH SCROLL FUNCTION
  function smoothScrollTo(target) {
    const element = document.querySelector(target);
    if (element) {
      const headerOffset = 80;
      const elementPosition = element.getBoundingClientRect().top;
      const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

      window.scrollTo({
        top: offsetPosition,
        behavior: 'smooth'
      });
    }
  }

  // Initialize
  document.addEventListener('DOMContentLoaded', function() {
    updateCountdown();
    setInterval(updateCountdown, 1000);

    // CTA Button - Confetti + Smooth Scroll
    const ctaButton = document.querySelector('.bf25-cta-button');
    if (ctaButton) {
      ctaButton.addEventListener('click', function(e) {
        const href = this.getAttribute('href');

        // If it's an anchor link
        if (href && href.startsWith('#')) {
          e.preventDefault();
          triggerConfetti();

          // Delay scroll slightly for confetti impact
          setTimeout(() => {
            smoothScrollTo(href);
          }, 300);
        }
      });
    }

    // Currency converter - let it handle conversion
    // Convert gift value - SAME LOGIC AS bf25-hero
    function convertGiftValue() {
      const giftValueEls = document.querySelectorAll('.bf25-gift-value .money, .bf25-step-detail .money');
      if (!giftValueEls.length) return;
      
      // Get currency symbol (SAME as hero)
      const currencySymbol = window.Shopify?.currency?.symbol || '{{ cart.currency.symbol }}' || '€';
      
      // Get conversion rate from USD to current currency
      let conversionRate = 1;
      const currentCurrency = window.Shopify?.currency?.active || 'USD';
      
      if (currentCurrency === 'USD') {
        conversionRate = 1;
      } else if (window.Currency && window.Currency.rates) {
        // Currency converter: rates are from USD (base currency)
        conversionRate = window.Currency.rates[currentCurrency] || 1;
      } else if (window.Shopify?.currency?.rate) {
        // Shopify rate: from shop base to current
        conversionRate = window.Shopify.currency.rate;
      } else if (typeof BOGOCurrency !== 'undefined') {
        // BOGOCurrency converts from EUR, so: USD -> EUR -> current
        // USD to EUR: divide by ~1.10
        const usdToEur = 1 / 1.10;
        const eurToCurrent = BOGOCurrency.getConversionRate();
        conversionRate = usdToEur * eurToCurrent;
      }
      
      // Format money (SAME as hero)
      const formatMoney = (amount) => {
        const converted = amount * conversionRate;
        if (currencySymbol === '¥' || currencySymbol === 'RSD' || currencySymbol.includes('Ft')) {
          return currencySymbol + Math.round(converted);
        } else if (currencySymbol === '€') {
          return currencySymbol + converted.toFixed(2).replace('.', ',');
        } else {
          return currencySymbol + converted.toFixed(2);
        }
      };
      
      giftValueEls.forEach(function(el) {
        // Get USD value from element's own data attribute or parent's
        let usdValue = parseFloat(el.dataset.usdValue);
        if (!usdValue || isNaN(usdValue)) {
          const parent = el.closest('[data-usd-value]');
          usdValue = parseFloat(parent?.dataset?.usdValue);
        }
        if (!usdValue || isNaN(usdValue)) {
          // Last resort: extract from initial text (before any conversion)
          usdValue = parseFloat(el.textContent.replace(/[^\d.]/g, ''));
        }
        if (usdValue && !isNaN(usdValue) && usdValue < 10000) { // Sanity check: prevent millions
          el.textContent = formatMoney(usdValue);
        }
      });
    }
    
    // Run conversion (SAME as hero - after data loads)
    setTimeout(convertGiftValue, 100);
    setTimeout(convertGiftValue, 500);
  });

  // Smooth scroll to slider section
  document.addEventListener('DOMContentLoaded', function() {
    const ctaBtn = document.querySelector('.bf25-cta-button[data-scroll-to="power-pairs"]');
    if (ctaBtn) {
      ctaBtn.addEventListener('click', function(e) {
        e.preventDefault();
        const target = document.getElementById('PowerPairsBF25');
        if (target) {
          const offset = 80; // Offset from top for better positioning
          const targetPosition = target.getBoundingClientRect().top + window.pageYOffset - offset;
          window.scrollTo({
            top: targetPosition,
            behavior: 'smooth'
          });
        }
      });
    }
  });
})();
</script>

