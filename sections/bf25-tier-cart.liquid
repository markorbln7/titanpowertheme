  ];

  console.log('[BF25 Config] ✓ Tier and gift configuration loaded');
  console.log('[BF25 Config] Tiers:', window.BF25_TIERS.length, '| Gifts defined:', Object.keys(window.GIFT_VARIANT_MAP).length);
</script>

<!-- Load JavaScript (Order matters: BundleManager → CartManager → Isolation) -->
<script src="{{ 'bf25-bundle-manager.js' | asset_url }}" defer></script>
<script src="{{ 'bf25-tier-cart.js' | asset_url }}" defer></script>
<script src="{{ 'bf25-cart-isolation.js' | asset_url }}" defer></script>

<!-- Load Test Suite (Development Only) -->
{% if section.settings.enable_testing %}
<script src="{{ 'bf25sc-tier-cart-tests.js' | asset_url }}" defer></script>
{% endif %}

<!-- Schema for Theme Customizer -->
{% schema %}
{
  "name": "BF25 Sticky Cart",
  "tag": "section",
  "class": "bf25sc-tier-cart-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_by_default",
      "label": "Show by default (for testing)",
      "default": true,
      "info": "Turn off in production to only show when cart has items"
    },
    {
      "type": "checkbox",
      "id": "enable_testing",
      "label": "Enable testing suite",
      "default": false,
      "info": "Load test scripts for development"
    },
    {
      "type": "header",
      "content": "Position"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Sticky position",
      "options": [
        {
          "value": "bottom",
          "label": "Bottom of screen"
        },
        {
          "value": "top",
          "label": "Top of screen"
        }
      ],
      "default": "bottom"
    }
  ],
  "presets": [
    {
      "name": "BF25 Sticky Cart"
    }
  ]
}
{% endschema %}
