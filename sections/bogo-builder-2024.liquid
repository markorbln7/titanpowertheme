  }

  {%- comment -%} Premium Product Cards - RESTORED DESIGN {%- endcomment -%}
  .dark-mode .section-collections-with-nav__product {
    background: linear-gradient(145deg, #1a1a1a, #0f0f0f);
    border: 2px solid rgba(96, 198, 85, 0.2);
