    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  {%- comment -%} Dark Mode Theme - PREMIUM RESTORATION {%- endcomment -%}
  .dark-mode .section-collections-with-nav__navigation {
    background: #000000;
    position: relative;
    z-index: 20;
  }

  .dark-mode .collection-link {
    color: #e0e0e0;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    font-weight: 500;
  }

  .dark-mode .collection-link:hover,
  .dark-mode .active .collection-link {
    color: #60c655;
