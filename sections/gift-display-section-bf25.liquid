{% comment %}
  ═══════════════════════════════════════════════════════════════════
  BF25 UNIFIED GIFT & TIERS SECTION
  Combines gift display with discount tiers in one cohesive section
  SCOPED: All styles use .bf25-unified-gifts prefix to avoid conflicts
  ═══════════════════════════════════════════════════════════════════
{% endcomment %}

{% liquid
  assign giftRepeater = section.blocks | where: 'type', 'gift_images'
%}

<style>
/* ═══════════════════════════════════════════════════════════════════
   BF25 UNIFIED GIFTS SECTION - SCOPED STYLES
   All classes prefixed with .bf25-unified-gifts to avoid conflicts
   ═══════════════════════════════════════════════════════════════════ */

.bf25-unified-gifts {
  background: linear-gradient(180deg, #e8f5e9 0%, #d7f0d5 100%);
  padding: 32px 16px;
  font-family: "Work Sans", sans-serif;
}

.bf25-unified-gifts__container {
  max-width: 1100px;
  margin: 0 auto;
}

/* Header */
.bf25-unified-gifts__header {
  text-align: center;
  margin-bottom: 24px;
}

.bf25-unified-gifts__title {
  font-size: 22px;
  font-weight: 700;
  color: #1a1a1a;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.bf25-unified-gifts__title-icon {
  font-size: 24px;
}

/* Grid Layout */
.bf25-unified-gifts__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid rgba(0, 0, 0, 0.06);
}

/* Individual Tier Column */
.bf25-unified-gifts__tier {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20px 12px;
  position: relative;
  text-align: center;
}

/* Vertical separator between tiers */
.bf25-unified-gifts__tier:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 10%;
  height: 80%;
  width: 1px;
  background: rgba(0, 0, 0, 0.08);
}

/* ─────────────────────────────────────────────────────
   TOP SECTION: Tier Info (items + discount + gift count)
   ───────────────────────────────────────────────────── */
.bf25-unified-gifts__tier-info {
  margin-bottom: 16px;
  width: 100%;
}

/* Items label: "4+ items" */
.bf25-unified-gifts__items-label {
  color: #2e7d32;
  font-size: 15px;
  font-weight: 700;
  margin-bottom: 6px;
}

/* Discount row: "60 % OFF" */
.bf25-unified-gifts__discount-row {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 3px;
  margin-bottom: 6px;
}

.bf25-unified-gifts__discount-number {
  font-size: 52px;
  font-weight: 800;
  color: #1a1a1a;
  line-height: 0.9;
}

.bf25-unified-gifts__discount-suffix {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding-bottom: 6px;
}

.bf25-unified-gifts__percent {
  font-size: 14px;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1;
}

.bf25-unified-gifts__off-text {
  font-size: 9px;
  font-weight: 600;
  color: #666;
  line-height: 1;
  margin-top: 2px;
}

/* Gift count: "+ 1 GIFT" */
.bf25-unified-gifts__gift-count {
  color: #2e7d32;
  font-size: 13px;
  font-weight: 700;
  text-transform: uppercase;
}

/* ─────────────────────────────────────────────────────
   BOTTOM SECTION: Gift Product Display
   ───────────────────────────────────────────────────── */
.bf25-unified-gifts__product {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Product image container */
.bf25-unified-gifts__product-image-wrap {
  position: relative;
  width: 100%;
  max-width: 140px;
  aspect-ratio: 1;
  margin-bottom: 10px;
  border-radius: 12px;
  overflow: visible;
  background: linear-gradient(180deg, #f8fdf8 0%, #e8f5e9 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Confetti overlay */
.bf25-unified-gifts__confetti {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
}

.bf25-unified-gifts__confetti img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Product image */
.bf25-unified-gifts__product-image {
  position: relative;
  z-index: 2;
  width: 85%;
  height: auto;
  object-fit: contain;
  transition: transform 0.3s ease;
}

.bf25-unified-gifts__tier:hover .bf25-unified-gifts__product-image {
  transform: scale(1.05);
}

/* Product name */
.bf25-unified-gifts__product-name {
  font-size: 11px;
  font-weight: 700;
  color: #1a1a1a;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 4px;
}

/* Struck price */
.bf25-unified-gifts__product-price {
  font-size: 13px;
  font-weight: 600;
  color: #e53935;
  text-decoration: line-through;
}

/* ═══════════════════════════════════════════════════════════════════
   TABLET STYLES (769px - 1024px)
   ═══════════════════════════════════════════════════════════════════ */
@media (min-width: 769px) and (max-width: 1024px) {
  .bf25-unified-gifts__tier {
    padding: 16px 10px;
  }

  .bf25-unified-gifts__discount-number {
    font-size: 44px;
  }

  .bf25-unified-gifts__product-image-wrap {
    max-width: 120px;
  }
}

/* ═══════════════════════════════════════════════════════════════════
   DESKTOP STYLES (1025px+)
   ═══════════════════════════════════════════════════════════════════ */
@media (min-width: 1025px) {
  .bf25-unified-gifts {
    padding: 40px 24px;
  }

  .bf25-unified-gifts__title {
    font-size: 26px;
    margin-bottom: 8px;
  }

  .bf25-unified-gifts__tier {
    padding: 24px 16px;
  }

  .bf25-unified-gifts__discount-number {
    font-size: 64px;
  }

  .bf25-unified-gifts__percent {
    font-size: 16px;
  }

  .bf25-unified-gifts__off-text {
    font-size: 10px;
  }

  .bf25-unified-gifts__items-label {
    font-size: 17px;
  }

  .bf25-unified-gifts__gift-count {
    font-size: 15px;
  }

  .bf25-unified-gifts__product-image-wrap {
    max-width: 160px;
  }

  .bf25-unified-gifts__product-name {
    font-size: 12px;
  }

  .bf25-unified-gifts__product-price {
    font-size: 15px;
  }
}

/* ═══════════════════════════════════════════════════════════════════
   MOBILE STYLES (max 768px)
   ═══════════════════════════════════════════════════════════════════ */
@media (max-width: 768px) {
  .bf25-unified-gifts {
    padding: 24px 12px;
  }

  .bf25-unified-gifts__title {
    font-size: 18px;
  }

  .bf25-unified-gifts__grid {
    gap: 0;
    border-radius: 12px;
  }

  .bf25-unified-gifts__tier {
    padding: 14px 6px;
  }

  .bf25-unified-gifts__items-label {
    font-size: 11px;
    margin-bottom: 4px;
  }

  .bf25-unified-gifts__discount-row {
    gap: 2px;
    margin-bottom: 4px;
  }

  .bf25-unified-gifts__discount-number {
    font-size: 32px;
  }

  .bf25-unified-gifts__discount-suffix {
    padding-bottom: 4px;
  }

  .bf25-unified-gifts__percent {
    font-size: 10px;
  }

  .bf25-unified-gifts__off-text {
    font-size: 7px;
  }

  .bf25-unified-gifts__gift-count {
    font-size: 9px;
  }

  .bf25-unified-gifts__tier-info {
    margin-bottom: 10px;
  }

  .bf25-unified-gifts__product-image-wrap {
    max-width: 70px;
    margin-bottom: 8px;
  }

  .bf25-unified-gifts__product-name {
    font-size: 8px;
    letter-spacing: 0.3px;
  }

  .bf25-unified-gifts__product-price {
    font-size: 10px;
  }
}

/* ═══════════════════════════════════════════════════════════════════
   SMALL MOBILE (max 400px)
   ═══════════════════════════════════════════════════════════════════ */
@media (max-width: 400px) {
  .bf25-unified-gifts__title {
    font-size: 16px;
  }

  .bf25-unified-gifts__discount-number {
    font-size: 26px;
  }

  .bf25-unified-gifts__items-label {
    font-size: 9px;
  }

  .bf25-unified-gifts__gift-count {
    font-size: 8px;
  }

  .bf25-unified-gifts__product-image-wrap {
    max-width: 60px;
  }

  .bf25-unified-gifts__product-name {
    font-size: 7px;
  }

  .bf25-unified-gifts__product-price {
    font-size: 9px;
  }
}
</style>

<section class="bf25-unified-gifts">
  <div class="bf25-unified-gifts__container">

    {% comment %} Section Header {% endcomment %}
    {% if section.settings.welcome_message %}
      <header class="bf25-unified-gifts__header">
        <h2 class="bf25-unified-gifts__title">
          <span class="bf25-unified-gifts__title-icon">🎁</span>
          {{ section.settings.welcome_message }}
        </h2>
      </header>
    {% endif %}

    {% comment %} Tier Grid {% endcomment %}
    <div class="bf25-unified-gifts__grid">
      {% for block in giftRepeater %}
        {% assign prHandle = block.settings.money_product %}
        {% assign giftPriceHandle = block.settings.gift_price_product %}
        {% assign tierIndex = forloop.index %}

        {% comment %} Calculate tier values based on index {% endcomment %}
        {% case tierIndex %}
          {% when 1 %}
            {% assign itemsLabel = "4+ items" %}
            {% assign discountNum = "60" %}
            {% assign giftCount = 1 %}
          {% when 2 %}
            {% assign itemsLabel = "8+ items" %}
            {% assign discountNum = "70" %}
            {% assign giftCount = 2 %}
          {% when 3 %}
            {% assign itemsLabel = "12+ items" %}
            {% assign discountNum = "80" %}
            {% assign giftCount = 3 %}
          {% when 4 %}
            {% assign itemsLabel = "16+ items" %}
            {% assign discountNum = "85" %}
            {% assign giftCount = 4 %}
          {% else %}
            {% assign itemsLabel = "4+ items" %}
            {% assign discountNum = "60" %}
            {% assign giftCount = tierIndex %}
        {% endcase %}

        <div class="bf25-unified-gifts__tier" {{ block.shopify_attributes }}>

          {% comment %} TOP: Tier Info {% endcomment %}
          <div class="bf25-unified-gifts__tier-info">
            <div class="bf25-unified-gifts__items-label">{{ itemsLabel }}</div>

            <div class="bf25-unified-gifts__discount-row">
              <span class="bf25-unified-gifts__discount-number">{{ discountNum }}</span>
              <div class="bf25-unified-gifts__discount-suffix">
                <span class="bf25-unified-gifts__percent">%</span>
                <span class="bf25-unified-gifts__off-text">OFF</span>
              </div>
            </div>

            <div class="bf25-unified-gifts__gift-count">+ {{ giftCount }} GIFT{% if giftCount > 1 %}S{% endif %}</div>
          </div>

          {% comment %} BOTTOM: Gift Product {% endcomment %}
          <div class="bf25-unified-gifts__product">
            <div class="bf25-unified-gifts__product-image-wrap">
              {% comment %} Confetti animation {% endcomment %}
              <div class="bf25-unified-gifts__confetti">
                <img src="{{ 'conf.gif' | asset_img_url }}" alt="" loading="lazy" width="100" height="100">
              </div>

              {% comment %} Product image {% endcomment %}
              {% if block.settings.pdp_hero_icon %}
                <img
                  class="bf25-unified-gifts__product-image"
                  src="{{ block.settings.pdp_hero_icon | img_url: 'medium' }}"
                  srcset="{{ block.settings.pdp_hero_icon | img_url: 'small' }} 100w,
                          {{ block.settings.pdp_hero_icon | img_url: 'medium' }} 200w,
                          {{ block.settings.pdp_hero_icon | img_url: 'large' }} 400w"
                  sizes="(max-width: 768px) 70px, 160px"
                  alt="{{ block.settings.pdp_hero_icon_title | default: 'Free Gift' }}"
                  loading="lazy"
                  width="160"
                  height="160"
                >
              {% endif %}
            </div>

            {% comment %} Product name {% endcomment %}
            <div class="bf25-unified-gifts__product-name">
              {{ block.settings.pdp_hero_icon_title | default: 'FREE GIFT' }}
            </div>

            {% comment %} Struck price {% endcomment %}
            {% if giftPriceHandle != blank %}
              <div class="bf25-unified-gifts__product-price">
                {{ all_products[giftPriceHandle].price | money }}
              </div>
            {% endif %}
          </div>

        </div>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "BF25 Unified Gift Tiers",
  "settings": [
    {
      "type": "text",
      "id": "welcome_message",
      "label": "Section Title",
      "default": "Stack Deals to Unlock FREE GIFTS!"
    }
  ],
  "blocks": [
    {
      "type": "gift_images",
      "name": "Gift Tier",
      "settings": [
        {
          "type": "image_picker",
          "id": "pdp_hero_icon",
          "label": "Gift Image"
        },
        {
          "type": "text",
          "id": "pdp_hero_icon_title",
          "label": "Gift Name",
          "default": "FREE GIFT"
        },
        {
          "type": "product",
          "id": "gift_price_product",
          "label": "Gift Product (for price)"
        },
        {
          "type": "product",
          "id": "money_product",
          "label": "Money Goal Product"
        },
        {
          "type": "text",
          "id": "product_number_unlocker",
          "label": "Tier Number (1-4)",
          "default": "1"
        },
        {
          "type": "text",
          "id": "pdp_hero_icon_title_top",
          "label": "Top Title (legacy)"
        },
        {
          "type": "text",
          "id": "top_note",
          "label": "Top Note (legacy)",
          "default": "Free"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "BF25 Unified Gift Tiers",
      "category": "Black Friday 2025",
      "blocks": [
        {
          "type": "gift_images",
          "settings": {
            "pdp_hero_icon_title": "4-IN-1 CABLE",
            "product_number_unlocker": "1"
          }
        },
        {
          "type": "gift_images",
          "settings": {
            "pdp_hero_icon_title": "TURBO DOCK",
            "product_number_unlocker": "2"
          }
        },
        {
          "type": "gift_images",
          "settings": {
            "pdp_hero_icon_title": "UNRELEASED",
            "product_number_unlocker": "3"
          }
        },
        {
          "type": "gift_images",
          "settings": {
            "pdp_hero_icon_title": "MYSTERY BOX",
            "product_number_unlocker": "4"
          }
        }
      ]
    }
  ]
}
{% endschema %}