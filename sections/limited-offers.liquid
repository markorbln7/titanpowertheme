{{ 'section-limited-offers.css' | asset_url | stylesheet_tag }}
{{ 'section-limited-offers.js' | asset_url | script_tag }}
<div class="top-image mb-[20px]">
  <img class="w-full desktop" width="100%" height="auto" src="{{ section.settings.image | img_url:'master' }}">
  <img class="w-full mobile" width="100%" height="auto" src="{{ section.settings.image_mobile | img_url:'master' }}">
</div>
<section class="">
  <div class="offers-title">{{ section.settings.text_right }}</div>
  <div class="timer" id="timer">
    <div class="flex flex-col items-center leading-none" id="days"></div>:
    <div class="flex flex-col items-center leading-none" id="hours"></div>:
    <div class="flex flex-col items-center leading-none" id="minutes"></div>:
    <div class="flex flex-col items-center leading-none" id="seconds"></div>
  </div>
  <div class="offers-list">
    {% for block in section.blocks %}
      <div class="offers-list__single {%if block.settings.oos%}out-of-stock{% endif %}">
        {%if block.settings.oos%}
          <div class="offers-list__single--image block">
            <img class="w-100" width="100" height="auto" src="{{ block.settings.product_image | img_url:'master' }}">
          </div>
        {% else %}
          <a href="{{ block.settings.url }}" class="offers-list__single--image block">
            <img class="w-100" width="100" height="auto" src="{{ block.settings.product_image | img_url:'master' }}">
          </a>
        {% endif %}
        {% if block.settings.text != blank %}
          <div class="offers-list__single--text">
              {{ block.settings.text }}
          </div>
        {% endif %}
        {%if block.settings.oos%}
        <button disabled class="offers-list__single--url">
            Sold Out!
        </button>
        {% else %}
          <a href="{{ block.settings.url }}" class="offers-list__single--url">
            Learn More
          </a>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>
<script>
    // Dobavi samo jednom vrednost sa servera
const countdownTo = "{{ section.settings.countdown_to | date: "%Y-%m-%dT%H:%M:%S" }}"; // ISO format

function makeTimer(className, dateTo) {
    const endTime = new Date(dateTo);
    if (isNaN(endTime.getTime())) {
        console.error("Invalid date: ", dateTo);
        return;
    }

    const now = new Date();
    const timeLeft = (endTime - now) / 1000;

    if (timeLeft <= 0) {
        $(className).html('<div class="expired">Offer expired</div>');
        return;
    }

    const days = String(Math.floor(timeLeft / 86400)).padStart(2, "0");
    const hours = String(Math.floor((timeLeft % 86400) / 3600)).padStart(2, "0");
    const minutes = String(Math.floor((timeLeft % 3600) / 60)).padStart(2, "0");
    const seconds = String(Math.floor(timeLeft % 60)).padStart(2, "0");

    $(className + " #days").html(days + '<div class="small-text">Days</div>');
    $(className + " #hours").html(hours + '<div class="small-text">Hours</div>');
    $(className + " #minutes").html(minutes + '<div class="small-text">Min</div>');
    $(className + " #seconds").html(seconds + '<div class="small-text">Sec</div>');
}

setInterval(function () {
    makeTimer('.timer', countdownTo);
}, 1000);

</script>


{% schema %}
{
  "name": "Limited Offers",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Top Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Top Image Mobile"
    },
    {
      "type": "text",
      "id": "text_right",
      "label": "Text right",
      "default": "LIMITED TIME OFFERS"
    },
    {
      "type": "text",
      "id": "countdown_to",
      "label": "Countdown to"
    }
  ],
  "blocks": [
    {
      "type": "air_tabs",
      "name": "Tabs",
      "settings": [
        {
          "type": "checkbox",
          "id": "oos",
          "label": "Out Of Stock"
        },
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Url"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Url"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Limited Offers"
    }
  ]
}
{% endschema %}