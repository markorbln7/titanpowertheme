{% if section.settings.enable_section %}
{{ 'bf25-hero.css' | asset_url | stylesheet_tag }}

<svg style="display: none;" xmlns="http://www.w3.org/2000/svg">
  <symbol id="icon-lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
  </symbol>
  <symbol id="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
     <path d="M20 6L9 17l-5-5"/>
  </symbol>
  <symbol id="icon-benefit-check" viewBox="0 0 20 20" fill="currentColor">
    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
  </symbol>
  <symbol id="icon-finger-drag" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M14 8V4a2 2 0 0 0-4 0v2"/>
    <path d="M10 10V6a2 2 0 0 0-4 0v8"/>
    <path d="M6 14l-2 2a2 2 0 1 0 2.83 2.83L10 16"/>
    <path d="M14 8h4a2 2 0 0 1 2 2v6a8 8 0 0 1-16 0V6"/>
    <path d="M18 12l3-3m0 0l-3-3m3 3H10" stroke-width="2"/>
  </symbol>
</svg>

<section class="bf25-hero" id="bf25-hero-section">
  <div class="bf25-hero__container">

    <header class="bf25-hero__header">
      <h1 class="bf25-hero__heading">
        More Items = <span class="bf25-energy-text">Bigger Rewards</span>
      </h1>
      <h2 class="bf25-hero__subheading !text-white">
        Every tier unlocks a bigger discount and a better free gift. See below.
      </h2>
    </header>

    <div class="bf25-hero__module">

      <div class="bf25-hero__gifts-header">
        <span class="bf25-hero__gifts-header-text">Slide to unlock Discounts + Free Gifts</span>
      </div>

      <div class="bf25-hero__gifts">

        <div class="bf25-hero__gift-box" data-gift-id="cable" data-tier="1">
          <div class="bf25-hero__gift-image-wrapper">
            <img src="https://cdn.shopify.com/s/files/1/0071/1727/5191/files/4_in_1_top_image_a895a2f4-c7a7-4e8f-889a-883407938d24.png?v=1763844565" alt="4-in-1 Cable" class="bf25-hero__gift-image" width="80" height="80" loading="lazy"/>
            <div class="bf25-hero__gift-overlay"></div>
            <span class="bf25-hero__gift-status-icon" aria-hidden="true">
                <svg class="icon icon-lock"><use xlink:href="#icon-lock"></use></svg>
                <svg class="icon icon-check"><use xlink:href="#icon-check"></use></svg>
            </span>
          </div>
          <span class="bf25-hero__gift-label">Cable</span>
        </div>

        <div class="bf25-hero__gift-box" data-gift-id="dock" data-tier="2">
            <div class="bf25-hero__gift-image-wrapper">
                <img src="https://cdn.shopify.com/s/files/1/0071/1727/5191/files/T119.png?format=webp&v=1764472938" alt="Turbo Dock" class="bf25-hero__gift-image" width="80" height="80" loading="lazy"/>
                <div class="bf25-hero__gift-overlay"></div>
                <span class="bf25-hero__gift-status-icon" aria-hidden="true">
                    <svg class="icon icon-lock"><use xlink:href="#icon-lock"></use></svg>
                    <svg class="icon icon-check"><use xlink:href="#icon-check"></use></svg>
                </span>
            </div>
            <span class="bf25-hero__gift-label">Dock</span>
        </div>

        <div class="bf25-hero__gift-box" data-gift-id="magnetic" data-tier="3">
            <div class="bf25-hero__gift-image-wrapper">
                <img src="https://cdn.shopify.com/s/files/1/0071/1727/5191/files/Untitled-3.png?v=1763847726" alt="Magnetic Set" class="bf25-hero__gift-image" width="80" height="80" loading="lazy"/>
                <div class="bf25-hero__gift-overlay"></div>
                <span class="bf25-hero__gift-status-icon" aria-hidden="true">
                    <svg class="icon icon-lock"><use xlink:href="#icon-lock"></use></svg>
                    <svg class="icon icon-check"><use xlink:href="#icon-check"></use></svg>
                </span>
            </div>
            <span class="bf25-hero__gift-label">Magnetic</span>
        </div>

        <div class="bf25-hero__gift-box bf25-hero__gift-box--mystery" data-gift-id="mystery" data-tier="4">
            <div class="bf25-hero__gift-image-wrapper">
                <!-- Magical effects container -->
                <div class="bf25-hero__gift-magic" aria-hidden="true">
                    <!-- Rotating light rays -->
                    <div class="bf25-hero__gift-rays"></div>
                    <!-- Floating sparkles -->
                    <div class="bf25-hero__gift-sparkles">
                        <span class="sparkle sparkle-1"></span>
                        <span class="sparkle sparkle-2"></span>
                        <span class="sparkle sparkle-3"></span>
                        <span class="sparkle sparkle-4"></span>
                    </div>
                    <!-- Pulsing glow ring -->
                    <div class="bf25-hero__gift-glow-ring"></div>
                </div>

                <img src="https://cdn.shopify.com/s/files/1/0071/1727/5191/files/holora-ad-alien_artifact_myste-17643243505814.png?v=1764325476" alt="Mystery Box" class="bf25-hero__gift-image" width="80" height="80" loading="lazy"/>
                <div class="bf25-hero__gift-overlay"></div>
                <span class="bf25-hero__gift-status-icon" aria-hidden="true">
                    <svg class="icon icon-lock"><use xlink:href="#icon-lock"></use></svg>
                    <svg class="icon icon-check"><use xlink:href="#icon-check"></use></svg>
                </span>
            </div>
            <span class="bf25-hero__gift-label">Mystery</span>
        </div>
      </div>

      <div class="bf25-hero__slider-wrapper">

        <!-- NEW: Discount Labels Above Bar -->
        <div class="bf25-hero__discount-labels">
          <!-- NEW: 50% at 1 item -->
          <div class="bf25-hero__discount-label-item" data-tier="0" data-value="1">
            <span class="bf25-hero__discount-text">50%</span>
          </div>

          <div class="bf25-hero__discount-label-item" data-tier="1" data-value="4">
            <span class="bf25-hero__discount-text">60%</span>
          </div>
          <div class="bf25-hero__discount-label-item" data-tier="2" data-value="8">
            <span class="bf25-hero__discount-text">70%</span>
          </div>
          <div class="bf25-hero__discount-label-item" data-tier="3" data-value="12">
            <span class="bf25-hero__discount-text">80%</span>
          </div>
          <div class="bf25-hero__discount-label-item" data-tier="4" data-value="16">
            <span class="bf25-hero__discount-text">85%</span>
          </div>
        </div>

        <!-- Simplified drag indicator -->
        <div class="bf25-hero__drag-indicator" id="bf25-drag-indicator">
          <div class="bf25-hero__drag-arrow">→</div>
          <span class="bf25-hero__drag-text">DRAG</span>
        </div>

        <!-- UPDATED: Progress Bar (DOM Segments) -->
        <div class="progress-bar progress-bar--segmented" id="bf25-visualization">
          <div class="progress-bar__segments">
            {% for i in (1..16) %}
            <div class="progress-bar__segment" data-segment="{{ i }}"></div>
            {% endfor %}
          </div>
        </div>

        <input type="range" min="0" max="16" step="1" value="0" class="bf25-hero__input" id="bf25-hero-slider"
               aria-label="Select number of items to see tier discounts and unlock gifts"
               aria-valuemin="0" aria-valuemax="16" aria-valuenow="0" aria-valuetext="0 items selected"/>

        <div class="bf25-hero__checkpoints">
          <!-- NEW: 1 Item Checkpoint -->
          <div class="bf25-hero__checkpoint" data-value="1">
            <span class="bf25-hero__checkpoint-label">1 <span class="checkpoint-subtext">item</span></span>
          </div>
          <!-- Existing checkpoints remain -->
          <div class="bf25-hero__checkpoint" data-tier="1" data-value="4">
            <span class="bf25-hero__checkpoint-label">4 <span class="checkpoint-subtext">items</span></span>
          </div>
          <div class="bf25-hero__checkpoint" data-tier="2" data-value="8">
            <span class="bf25-hero__checkpoint-label">8 <span class="checkpoint-subtext">items</span></span>
          </div>
          <div class="bf25-hero__checkpoint" data-tier="3" data-value="12">
            <span class="bf25-hero__checkpoint-label">12 <span class="checkpoint-subtext">items</span></span>
          </div>
          <div class="bf25-hero__checkpoint" data-tier="4" data-value="16">
            <span class="bf25-hero__checkpoint-label">16 <span class="checkpoint-subtext">items</span></span>
          </div>
        </div>
      </div>

      <div class="bf25-hero__card" data-active-tier="0">
        <div class="bf25-hero__card-header">
          <div class="bf25-hero__tier-badge">
            <span class="bf25-hero__tier-badge-text">Explore Tiers</span>
          </div>
          <div class="bf25-hero__discount-display">
            <!-- Two-line message for tier 0 -->
            <div class="bf25-hero__default-message">
              <p class="bf25-hero__default-subtitle">
                All products <span class="bf25-hero__default-highlight">50% OFF</span>
              </p>
              <p class="bf25-hero__default-title">Drag the slider to see more Savings</p>
            </div>
            <!-- Normal discount label (hidden at tier 0) -->
            <span class="bf25-hero__discount-label">60% OFF</span>
          </div>
        </div>

        <!-- NEW: Benefits Wrapper -->
        <div class="bf25-hero__benefits-wrapper">
          <div class="bf25-hero__benefits-list" aria-live="polite">
          </div>
        </div>

        <div class="bf25-hero__card-footer">
          <div class="bf25-hero__pricing">
            <div class="bf25-hero__pricing-row">
              <span class="bf25-hero__pricing-label">Est. Total:</span>
              <span class="bf25-hero__pricing-value" data-price-type="total">—</span>
            </div>

            <div class="bf25-hero__pricing-row bf25-hero__pricing-row--per-item">
              <span class="bf25-hero__pricing-label">Per Item:</span>
              <span class="bf25-hero__pricing-value" data-price-type="per-item">—</span>
            </div>

            <div class="bf25-hero__pricing-row bf25-hero__pricing-row--savings">
              <span class="bf25-hero__pricing-label">Average Savings:</span>
              <span class="bf25-hero__pricing-value bf25-hero__pricing-value--savings" data-price-type="savings">—</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <div class="bf25-hero__cta">
      <a href="{{ section.settings.cta_url | default: '#bf25-products' }}" class="bf25-hero__cta-button">
        {{ section.settings.cta_text | default: "Start Building Your Deal" }}
      </a>
    </div>

  </div>
</section>

<script type="application/json" id="bf25HeroData">
{
  "config": {
    "max_items": 16,
    "currency_symbol": "{{ cart.currency.symbol | default: '€' }}",
    "avg_price_retail": {{ section.settings.avg_price_retail | default: 40 | json }},
    "avg_price_shopify": {{ section.settings.avg_price_shopify | default: 20 | json }}
  },
  "gifts": [
    {
      "id": "cable",
      "name": "4-in-1 Cable",
      "value": 30.00,
      "tier": 1,
      "benefit_text": "FREE 4-in-1 Cable (€30 value)"
    },
    {
      "id": "dock",
      "name": "Turbo Dock + Free Shipping",
      "value": 35.00,
      "tier": 2,
      "benefit_text": "FREE Turbo Dock (€35 value)"
    },
    {
      "id": "magnetic",
      "name": "Magnetic Cable Set",
      "value": 40.00,
      "tier": 3,
      "benefit_text": "🆕 NEW RELEASE: Magnetic Cable Set (€40 value)",
      "special_class": "exclusive"
    },
    {
      "id": "mystery",
      "name": "Mystery Box",
      "value": 150.00,
      "tier": 4,
      "benefit_text": "🎁 EXCLUSIVE: Mystery Box (€150+ value)",
      "special_class": "mystery"
    }
  ],
  "tiers": [
    {
      "id": 0,
      "min": 0,
      "max": 3,
      "badge": "Explore Tiers",
      "display_label": "Drag the slider",
      "multiplier": 1.0,
      "color": "#6b7280",
      "discount_benefit_text": null
    },
    {
      "id": 1,
      "min": 4,
      "max": 7,
      "badge": "Better Deal",
      "display_label": "60% OFF",
      "multiplier": 0.91,
      "color": "#60c655",
      "discount_benefit_text": "60% OFF all items"
    },
    {
      "id": 2,
      "min": 8,
      "max": 11,
      "badge": "Great Deal",
      "display_label": "70% OFF",
      "multiplier": 0.76,
      "color": "#60c655",
      "discount_benefit_text": "70% OFF all items"
    },
    {
      "id": 3,
      "min": 12,
      "max": 15,
      "badge": "Gold Tier",
      "display_label": "80% OFF",
      "multiplier": 0.65,
      "color": "#FFD700",
      "discount_benefit_text": "80% OFF all items"
    },
    {
      "id": 4,
      "min": 16,
      "max": 999,
      "badge": "Platinum Unlock",
      "display_label": "85% OFF",
      "multiplier": 0.57,
      "color": "#E0F7FF",
      "discount_benefit_text": "85% OFF all items"
    }
  ]
}
</script>

<script src="{{ 'bf25-hero.js' | asset_url }}" defer></script>

{% endif %}

{% schema %}
{
  "name": "BF25 Interactive Hero",
  "tag": "section",
  "class": "bf25-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "📱 Content Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Headline",
      "default": "Build Your Black Friday Deal",
      "info": "Large H1 text (28-40px responsive)"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtitle",
      "default": "Slide to unlock bigger discounts + premium gifts",
      "info": "Secondary text below headline"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Start Building Your Deal"
    },
    {
      "type": "text",
      "id": "cta_url",
      "label": "CTA Button Link",
      "default": "#bf25-products",
      "info": "Can use anchor links like #products or full URLs"
    },
    {
      "type": "header",
      "content": "💰 Pricing Configuration"
    },
    {
      "type": "paragraph",
      "content": "These values calculate estimated totals and savings. Retail price is compare_at_price. Base price has tier multipliers applied."
    },
    {
      "type": "number",
      "id": "avg_price_retail",
      "label": "Average Retail Price",
      "default": 40,
      "info": "Used for savings calculation (e.g., €40)"
    },
    {
      "type": "number",
      "id": "avg_price_shopify",
      "label": "Average Base Price",
      "default": 20,
      "info": "Price that multipliers apply to (e.g., €20)"
    },
    {
      "type": "header",
      "content": "🔧 Advanced Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable Hero Section",
      "default": true,
      "info": "Toggle section visibility"
    }
  ],
  "presets": [
    {
      "name": "BF25 Interactive Hero",
      "category": "Promotional"
    }
  ]
}
{% endschema %}
