═══════════════════════════════════════════════════════════════════════
SHOPIFY THEME CUSTOMIZER SCHEMA
═══════════════════════════════════════════════════════════════════════
{%- endcomment -%}

{% schema %}
{
  "name": "BF25 Interactive Hero",
  "tag": "section",
  "class": "bf25-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading (H1)",
      "default": "Build Your Black Friday Deal"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading (H2)",
      "default": "Slide to unlock bigger discounts + premium gifts"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Start Building Your Deal"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Button URL",
      "default": "#bf25-products"
    },
    {
      "type": "header",
      "content": "Pricing Configuration"
    },
    {
      "type": "number",
      "id": "avg_price_retail",
      "label": "Average Retail Price (€)",
      "default": 40.00,
      "info": "Used to calculate total value and savings"
    },
    {
      "type": "number",
      "id": "avg_price_shopify",
      "label": "Average Shopify Price (€)",
      "default": 20.00,
      "info": "Base price after initial discount (before tier multipliers)"
    }
  ],
  "presets": [
    {
      "name": "BF25 Interactive Hero",
      "category": "Promotional"
    }
  ]
}
{% endschema %}
