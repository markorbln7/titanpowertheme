{% comment %}
  BF25 Snowfall Background Effect
  - Full page bokeh snow with realistic depth of field
  - Toggleable via section settings for A/B testing
  - Auto-pauses when not visible for performance
{% endcomment %}

{%- if section.settings.enable_snowfall -%}
<div class="bf25-snowfall-wrapper" data-section-id="{{ section.id }}">
  <canvas id="bf25-snowfall-canvas" aria-hidden="true"></canvas>
</div>

<style>
  .bf25-snowfall-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
  }

  #bf25-snowfall-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  /* Ensure content sits above snowfall */
  .section-bundle-builder-bf25,
  .bf25-bundle-builder,
  .bf25-hero,
  .bf25-hero-split,
  .power-pack-section,
  .shopify-section {
    position: relative;
    z-index: 1;
  }
</style>

<script>
(function() {
  'use strict';

  const canvas = document.getElementById('bf25-snowfall-canvas');
  if (!canvas) return;

  const ctx = canvas.getContext('2d', { alpha: true });
  let animationId = null;
  let snowflakes = [];
  let isVisible = true;
  let isInitialized = false;

  // Configuration
  const config = {
    layers: {
      close: {{ section.settings.close_flakes | default: 10 }},
      midClose: {{ section.settings.midclose_flakes | default: 12 }},
      mid: {{ section.settings.mid_flakes | default: 22 }},
      midFar: {{ section.settings.midfar_flakes | default: 14 }},
      far: {{ section.settings.far_flakes | default: 12 }}
    },
    windSpeed: {{ section.settings.wind_speed | default: 0.12 }},
    wobbleAmount: 0.25,
    maxSize: {{ section.settings.max_size | default: 16 }}
  };

  // Layer configurations - realistic DOF (max 16px)
  const layerConfigs = {
    close: {
      sizeMin: 12, sizeMax: config.maxSize,
      speedMult: 1.2,
      opacity: { min: 0.4, max: 0.6 },
      blur: { min: 3, max: 5 },
      zIndex: 5
    },
    midClose: {
      sizeMin: 8, sizeMax: 12,
      speedMult: 1.0,
      opacity: { min: 0.5, max: 0.7 },
      blur: { min: 1, max: 2 },
      zIndex: 4
    },
    mid: {
      sizeMin: 5, sizeMax: 10,
      speedMult: 0.8,
      opacity: { min: 0.7, max: 0.95 },
      blur: { min: 0, max: 0 },
      zIndex: 3
    },
    midFar: {
      sizeMin: 3, sizeMax: 5,
      speedMult: 0.55,
      opacity: { min: 0.4, max: 0.6 },
      blur: { min: 0.5, max: 1 },
      zIndex: 2
    },
    far: {
      sizeMin: 2, sizeMax: 4,
      speedMult: 0.35,
      opacity: { min: 0.2, max: 0.4 },
      blur: { min: 1, max: 2 },
      zIndex: 1
    }
  };

  function resizeCanvas() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    if (!isInitialized) {
      initSnowflakes();
      isInitialized = true;
    }
  }

  function createSnowflake(layerType, startFromTop) {
    const cfg = layerConfigs[layerType];
    const size = Math.random() * (cfg.sizeMax - cfg.sizeMin) + cfg.sizeMin;
    const blur = Math.random() * (cfg.blur.max - cfg.blur.min) + cfg.blur.min;
    const opacity = Math.random() * (cfg.opacity.max - cfg.opacity.min) + cfg.opacity.min;

    return {
      x: Math.random() * canvas.width,
      y: startFromTop ? -size - (Math.random() * 150) : (Math.random() * canvas.height * 1.5) - (canvas.height * 0.5),
      size: size,
      speedY: (0.3 + Math.random() * 0.2) * cfg.speedMult,
      speedX: config.windSpeed * cfg.speedMult + (Math.random() * 0.08 - 0.04),
      wobblePhase: Math.random() * Math.PI * 2,
      wobbleSpeed: 0.015 + Math.random() * 0.01,
      opacity: opacity,
      blur: blur,
      zIndex: cfg.zIndex,
      layerType: layerType
    };
  }

  function initSnowflakes() {
    snowflakes = [];
    Object.entries(config.layers).forEach(([layerType, count]) => {
      for (let i = 0; i < count; i++) {
        snowflakes.push(createSnowflake(layerType, false));
      }
    });
  }

  function animate() {
    if (!isVisible) return;

    ctx.clearRect(0, 0, canvas.width, canvas.height);
    snowflakes.sort((a, b) => a.zIndex - b.zIndex);

    for (let i = 0; i < snowflakes.length; i++) {
      const flake = snowflakes[i];

      flake.wobblePhase += flake.wobbleSpeed;
      const wobbleX = Math.sin(flake.wobblePhase) * config.wobbleAmount * (flake.zIndex / 3);

      flake.y += flake.speedY;
      flake.x += flake.speedX + wobbleX;

      if (flake.y > canvas.height + flake.size + 10) {
        snowflakes[i] = createSnowflake(flake.layerType, true);
        continue;
      }

      if (flake.x > canvas.width + flake.size) flake.x = -flake.size;
      if (flake.x < -flake.size) flake.x = canvas.width + flake.size;

      ctx.save();
      if (flake.blur > 0) {
        ctx.filter = `blur(${flake.blur}px)`;
      }
      ctx.fillStyle = `rgba(255, 255, 255, ${flake.opacity})`;
      ctx.beginPath();
      ctx.arc(flake.x, flake.y, flake.size / 2, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    animationId = requestAnimationFrame(animate);
  }

  function startAnimation() {
    if (!animationId && isVisible) {
      animate();
    }
  }

  function stopAnimation() {
    if (animationId) {
      cancelAnimationFrame(animationId);
      animationId = null;
    }
  }

  // Initialize
  resizeCanvas();
  startAnimation();

  // Visibility observer - pause when tab is hidden
  document.addEventListener('visibilitychange', function() {
    if (document.hidden) {
      stopAnimation();
    } else {
      isVisible = true;
      startAnimation();
    }
  });

  // IntersectionObserver - pause when scrolled far past
  if ('IntersectionObserver' in window) {
    const wrapper = document.querySelector('.bf25-snowfall-wrapper');
    const observer = new IntersectionObserver((entries) => {
      isVisible = entries[0].isIntersecting;
      if (isVisible) {
        startAnimation();
      } else {
        stopAnimation();
      }
    }, { threshold: 0 });

    observer.observe(wrapper);
  }

  // Debounced resize
  let resizeTimeout;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(resizeCanvas, 250);
  });

  // Expose for debugging
  window.BF25Snowfall = {
    start: startAnimation,
    stop: stopAnimation,
    isRunning: () => !!animationId
  };

  console.log('❄️ BF25 Snowfall initialized:', Object.values(config.layers).reduce((a,b) => a+b, 0), 'flakes');
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "BF25 Snowfall",
  "tag": "section",
  "class": "bf25-snowfall-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_snowfall",
      "label": "Enable Snowfall Effect",
      "default": true,
      "info": "Toggle for A/B testing"
    },
    {
      "type": "header",
      "content": "Snowflake Distribution"
    },
    {
      "type": "range",
      "id": "close_flakes",
      "label": "Close (large, blurry)",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "midclose_flakes",
      "label": "Mid-Close",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "mid_flakes",
      "label": "Middle (sharp, in focus)",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 22
    },
    {
      "type": "range",
      "id": "midfar_flakes",
      "label": "Mid-Far",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "far_flakes",
      "label": "Far (tiny, faint)",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 12
    },
    {
      "type": "header",
      "content": "Animation Settings"
    },
    {
      "type": "range",
      "id": "wind_speed",
      "label": "Wind Speed",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 2,
      "info": "0 = No wind, 10 = Strong wind"
    },
    {
      "type": "range",
      "id": "max_size",
      "label": "Max Flake Size (px)",
      "min": 8,
      "max": 24,
      "step": 1,
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "BF25 Snowfall",
      "category": "Black Friday"
    }
  ]
}
{% endschema %}