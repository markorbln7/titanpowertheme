{%- comment -%}
Mystery Box Section
Clean, simple implementation with Tailwind CSS
{%- endcomment -%}

{{ 'section-mystery-box.css' | asset_url | stylesheet_tag }}
{{ 'bf25-modal-design.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-mystery-box.js' | asset_url }}" defer></script>

{%- liquid
  assign master_product = section.settings.master_product
  assign main_variant = master_product.selected_or_first_available_variant
  
  if main_variant == blank
    assign main_variant = master_product.variants.first
  endif
-%}

<section
  id="MysteryBox-{{ section.id }}"
  class="mystery-box"
  data-section-id="{{ section.id }}"
  data-section-type="mystery-box"
>
  <div class="bg-[#0a0a0a] py-[40px] px-[10px] md:px-0">
    <div class="max-w-[1446px] mx-auto bg-black border-2 glass-surface">
      <div class="grid grid-cols-1 lg:grid-cols-[57%_43%]">
        
        {%- comment -%} IMAGE AREA (LEFT 60%) {%- endcomment -%}
        <div class="relative w-full">
          {%- comment -%} Desktop Image {%- endcomment -%}
          {%- if section.settings.image_desktop != blank -%}
            <img
              src="{{ section.settings.image_desktop | image_url: width: 1200 }}"
              alt="{{ section.settings.title }}"
              class="w-full h-full object-cover hidden lg:block"
              loading="lazy"
            >
          {%- endif -%}
          
          {%- comment -%} Mobile Image {%- endcomment -%}
          {%- if section.settings.image_mobile != blank -%}
            <img
              src="{{ section.settings.image_mobile | image_url: width: 800 }}"
              alt="{{ section.settings.title }}"
              class="w-full h-full object-cover lg:hidden"
              loading="lazy"
            >
          {%- endif -%}

          {%- comment -%} Hotspots - wrapped in bf25-product-card for modal compatibility {%- endcomment -%}
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- liquid
                assign hotspot_product = block.settings.product
                assign hotspot_variant = hotspot_product.selected_or_first_available_variant
                
                if hotspot_variant == blank
                  assign hotspot_variant = hotspot_product.variants.first
                endif
              -%}
              
              {%- comment -%} bf25-product-card wrapper enables modal event delegation {%- endcomment -%}
              <article
                class="mystery-box__hotspot bf25-product-card absolute"
                {{ block.shopify_attributes }}
                data-product-id="{{ hotspot_product.id }}"
                data-section="mystery-box"
                data-has-variants="{% if hotspot_product.variants.size > 1 %}true{% else %}false{% endif %}"
                data-default-variant-id="{{ hotspot_variant.id }}"
                role="button"
                tabindex="0"
                aria-label="View {{ hotspot_product.title }} details"
                style="
                  --desktop-top: {{ block.settings.position_desktop_top }}%;
                  --desktop-left: {{ block.settings.position_desktop_left }}%;
                  --mobile-top: {{ block.settings.position_mobile_top }}%;
                  --mobile-left: {{ block.settings.position_mobile_left }}%;
                  --desktop-line-width: {{ block.settings.line_width_desktop }}%;
                  --mobile-line-width: {{ block.settings.line_width_mobile }}%;
                "
              >
                {%- if block.settings.eyebrow != blank -%}
                  <p class="text-[#60c655] text-[12px] mb-1">{{ block.settings.eyebrow }}</p>
                {%- endif -%}
                
                {%- if block.settings.hotspot_title != blank -%}
                  <p class="text-white text-[14px] mb-1">{{ block.settings.hotspot_title }}</p>
                {%- endif -%}
                
                {%- if hotspot_product != blank and hotspot_variant -%}
                  <p class="text-white text-[20px] font-bold">{{ hotspot_variant.price | money }}</p>
                {%- endif -%}
                
                {%- comment -%} Pointer Line {%- endcomment -%}
                <div class="mystery-box__hotspot-line"></div>
              </article>
            {%- endfor -%}
          {%- endif -%}
        </div>

        {%- comment -%} CONTENT AREA (RIGHT 40%) {%- endcomment -%}
        <div class="md:p-8 p-4 lg:p-12 flex flex-col justify-center md:!pl-0">
          
          {%- comment -%} Title {%- endcomment -%}
          {%- if section.settings.title != blank -%}
            <h2 class="text-white md:text-[40px] text-[32px] font-bold mb-2">
              {{ section.settings.title }}
            </h2>
          {%- endif -%}

          {%- comment -%} Subtitle {%- endcomment -%}
          {%- if section.settings.subtitle != blank -%}
            <p class="text-[#d1d1d1] md:text-[24px] text-[18px] mb-2">
              {{ section.settings.subtitle }}
            </p>
          {%- endif -%}

          {%- comment -%} Note {%- endcomment -%}
          {%- if section.settings.note != blank -%}
            <p class="text-[#d1d1d1] md:text-[16px] text-[14px] mb-2">
              {{ section.settings.note }}
            </p>
          {%- endif -%}

          {%- comment -%} Pricing {%- endcomment -%}
          {%- if master_product != blank and main_variant -%}
            <div class="flex md:items-end items-start flex-col md:flex-row gap-4 mb-5">
              <p class="text-[#60c655] md:text-[42px] text-[32px] font-bold leading-none">
                {{ main_variant.price | money }}
              </p>
              
              {%- if main_variant.compare_at_price > main_variant.price -%}
                <div class="pb-2">
                  <p class="text-white text-[24px] font-bold leading-[28px]">
                    Worth Up to
                  </p>
                  <p class="text-[#ff9900] text-[24px] font-bold leading-[28px]">
                    {{ main_variant.compare_at_price | money }}
                  </p>
                </div>
              {%- endif -%}
            </div>

            {%- comment -%} Buttons {%- endcomment -%}
            <div class="flex flex-col gap-5">
              <button
                type="button"
                class="mystery-box__add-to-cart"
                data-variant-id="{{ main_variant.id }}"
                data-product-id="{{ master_product.id }}"
                data-action="add-to-deal"
              >
                <span data-button-text>Add to Deal</span>
              </button>

              <button
                type="button"
                class="mystery-box__buynow"
                data-variant-id="{{ main_variant.id }}"
                data-action="buy-now"
              >
                Buy Now
              </button>
            </div>
          {%- endif -%}
        </div>

      </div>
    </div>
  </div>
</section>

{%- comment -%}
═══════════════════════════════════════════════════════════
PRODUCT DATA FOR HOTSPOTS - Same format as section-bundle-builder-bf25
═══════════════════════════════════════════════════════════
{%- endcomment -%}
<script>
(function() {
  'use strict';

  // Initialize data containers if they don't exist
  window.productData = window.productData || {};
  window.productVariants = window.productVariants || {};
  window.productOptions = window.productOptions || {};

  {%- comment -%} Master Product Data for Add to Deal {%- endcomment -%}
  {%- if master_product != blank -%}
    {%- liquid
      assign desc_rendered = master_product.metafields.custom.product_description | metafield_tag
      if desc_rendered == blank
        assign desc_rendered = master_product.description
      endif
    -%}
  // ─────────────────────────────────────────────────────────
  // Master Product: {{ master_product.title }}
  // ─────────────────────────────────────────────────────────
  window.productData["{{ master_product.id }}"] = {
    id: "{{ master_product.id }}",
    handle: "{{ master_product.handle }}",
    title: {{ master_product.title | json }},
    basePrice: {{ master_product.price }},
    comparePrice: {{ master_product.compare_at_price | default: 0 }},
    featuredImage: "{{ master_product.featured_image | image_url: width: 800 }}",
    description: {{ desc_rendered | json }},
    ticks: {{ master_product.metafields.custom.ticks | json }},
    reviewRating: {{ master_product.metafields.reviews.rating | default: 0 }},
    reviewCount: {{ master_product.metafields.reviews.count | default: 0 }},
    isBestseller: {% if master_product.metafields.custom.is_bestseller %}true{% else %}false{% endif %},
    discount: {{ master_product.metafields.custom.new_shop_discount | json }},
    stockLevel: {{ main_variant.inventory_quantity | default: 0 }},
    available: {{ master_product.available | json }},
    upsells: [],
    productType: {{ master_product.type | json }},
    tags: {{ master_product.tags | json }},
    vendor: {{ master_product.vendor | json }}
  };

  // Variants for {{ master_product.title }}
  window.productVariants[{{ master_product.id }}] = [
    {%- for variant in master_product.variants -%}
    {
      id: {{ variant.id | json }},
      title: {{ variant.title | json }},
      options: [
        {%- for option in variant.options -%}
        {{ option | json }}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ],
      available: {{ variant.available | json }},
      price: {{ variant.price | json }},
      compare_at_price: {{ variant.compare_at_price | default: 'null' | json }},
      {%- if variant.featured_image -%}
      featured_image: {
        src: {{ variant.featured_image.src | image_url: width: 800 | json }},
        alt: {{ variant.featured_image.alt | default: master_product.title | json }}
      }
      {%- else -%}
      featured_image: null
      {%- endif -%}
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ];

  // Options for {{ master_product.title }}
  window.productOptions[{{ master_product.id }}] = [
    {%- for option in master_product.options_with_values -%}
    {
      name: {{ option.name | json }},
      position: {{ option.position }},
      values: {{ option.values | json }}
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ];
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- liquid
      assign hotspot_product = block.settings.product
      if hotspot_product != blank
        assign hotspot_variant = hotspot_product.selected_or_first_available_variant
        if hotspot_variant == blank
          assign hotspot_variant = hotspot_product.variants.first
        endif
        
        assign desc_rendered = hotspot_product.metafields.custom.product_description | metafield_tag
        if desc_rendered == blank
          assign desc_rendered = hotspot_product.description
        endif
      endif
    -%}
    
    {%- if hotspot_product != blank -%}
  // ─────────────────────────────────────────────────────────
  // Product: {{ hotspot_product.title }}
  // ─────────────────────────────────────────────────────────
  window.productData["{{ hotspot_product.id }}"] = {
    id: "{{ hotspot_product.id }}",
    handle: "{{ hotspot_product.handle }}",
    title: {{ hotspot_product.title | json }},
    basePrice: {{ hotspot_product.price }},
    comparePrice: {{ hotspot_product.compare_at_price | default: 0 }},
    featuredImage: "{{ hotspot_product.featured_image | image_url: width: 800 }}",
    description: {{ desc_rendered | json }},
    ticks: {{ hotspot_product.metafields.custom.ticks | json }},
    reviewRating: {{ hotspot_product.metafields.reviews.rating | default: 0 }},
    reviewCount: {{ hotspot_product.metafields.reviews.count | default: 0 }},
    isBestseller: {% if hotspot_product.metafields.custom.is_bestseller %}true{% else %}false{% endif %},
    discount: {{ hotspot_product.metafields.custom.new_shop_discount | json }},
    stockLevel: {{ hotspot_variant.inventory_quantity | default: 0 }},
    available: {{ hotspot_product.available | json }},
    upsells: [],
    productType: {{ hotspot_product.type | json }},
    tags: {{ hotspot_product.tags | json }},
    vendor: {{ hotspot_product.vendor | json }}
  };

  // Variants for {{ hotspot_product.title }}
  window.productVariants[{{ hotspot_product.id }}] = [
    {%- for variant in hotspot_product.variants -%}
    {
      id: {{ variant.id | json }},
      title: {{ variant.title | json }},
      options: [
        {%- for option in variant.options -%}
        {{ option | json }}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ],
      available: {{ variant.available | json }},
      price: {{ variant.price | json }},
      compare_at_price: {{ variant.compare_at_price | default: 'null' | json }},
      {%- if variant.featured_image -%}
      featured_image: {
        src: {{ variant.featured_image.src | image_url: width: 800 | json }},
        alt: {{ variant.featured_image.alt | default: hotspot_product.title | json }}
      }
      {%- else -%}
      featured_image: null
      {%- endif -%}
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ];

  // Options for {{ hotspot_product.title }}
  window.productOptions[{{ hotspot_product.id }}] = [
    {%- for option in hotspot_product.options_with_values -%}
    {
      name: {{ option.name | json }},
      position: {{ option.position }},
      values: {{ option.values | json }}
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ];
    {%- endif -%}
  {%- endfor -%}

  console.log('[MysteryBox] Product data loaded:', Object.keys(window.productData).length, 'products');
})();
</script>

{% schema %}
{
  "name": "Mystery Box",
  "tag": "section",
  "class": "section-mystery-box",
  "settings": [
    {
      "type": "header",
      "content": "Main Product"
    },
    {
      "type": "product",
      "id": "master_product",
      "label": "Product",
      "info": "Select the product to add to cart"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Tech Essentials Box"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Includes 1 Random Item or Bundle per Box"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "default": "Note: Colors are random and bundles may ship separately"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow Text"
        },
        {
          "type": "text",
          "id": "hotspot_title",
          "label": "Title"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Product price will be displayed"
        },
        {
          "type": "header",
          "content": "Desktop Position"
        },
        {
          "type": "range",
          "id": "position_desktop_top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Top",
          "default": 50
        },
        {
          "type": "range",
          "id": "position_desktop_left",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Left",
          "default": 50
        },
        {
          "type": "header",
          "content": "Mobile Position"
        },
        {
          "type": "range",
          "id": "position_mobile_top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Top",
          "default": 50
        },
        {
          "type": "range",
          "id": "position_mobile_left",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Left",
          "default": 50
        },
        {
          "type": "header",
          "content": "Pointer Line"
        },
        {
          "type": "text",
          "id": "line_width_desktop",
          "label": "Line Width Desktop (%)",
          "default": "20",
          "info": "Enter width as percentage (e.g., 20 or 150)"
        },
        {
          "type": "text",
          "id": "line_width_mobile",
          "label": "Line Width Mobile (%)",
          "default": "20",
          "info": "Enter width as percentage (e.g., 20 or 150)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mystery Box"
    }
  ]
}
{% endschema %}
