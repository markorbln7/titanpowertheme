{%- comment -%}
═══════════════════════════════════════════════════════════
ACCESSIBILITY - SKIP LINK
Allows keyboard users to skip to main bundle content
═══════════════════════════════════════════════════════════
{%- endcomment -%}

<a href="#pp-bundles-grid" class="pp-skip-link">
  Skip to bundle selection
</a>

{%- comment -%}
═══════════════════════════════════════════════════════════
PERFORMANCE OPTIMIZATION - RESOURCE HINTS
Preconnect to Shopify CDN for faster image loading
═══════════════════════════════════════════════════════════
{%- endcomment -%}

{%- if section.settings.enable_performance_optimizations -%}
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="dns-prefetch" href="https://cdn.shopify.com">
{%- endif -%}

{{ 'section-power-pairs-bf25.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-power-pairs-bf25.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
═══════════════════════════════════════════════════════════
POWER PAIRS BUNDLE SYSTEM - BLACK FRIDAY 2025
PROMPT 2: DATA PROCESSING & BUNDLE ASSOCIATION
═══════════════════════════════════════════════════════════
{%- endcomment -%}

{%- liquid
  comment
    STEP 1: Separate blocks by type
  endcomment
  assign bundle_definitions = section.blocks | where: 'type', 'bundle'
  assign all_product_blocks = section.blocks | where: 'type', 'bundle_product'

  comment
    STEP 2: Validate we have bundles configured
  endcomment
  assign has_bundles = false
  if bundle_definitions.size > 0
    assign has_bundles = true
  endif
-%}

{%- comment -%}
═══════════════════════════════════════════════════════════
CRITICAL DIAGNOSTIC - BLOCK ASSOCIATION DEBUG
═══════════════════════════════════════════════════════════
Total blocks in section: {{ section.blocks.size }}

Bundle Parent Blocks (type: "bundle"):
Found {{ bundle_definitions.size }} bundle blocks
{%- for b in bundle_definitions -%}
  Bundle {{ forloop.index }}:
    - Block ID (Shopify): {{ b.id }}
    - Bundle ID (Custom): "{{ b.settings.bundle_id }}"
    - Title: "{{ b.settings.bundle_title }}"
{%- endfor -%}

Product Child Blocks (type: "bundle_product"):
Found {{ all_product_blocks.size }} product blocks
{%- for p in all_product_blocks -%}
  Product {{ forloop.index }}:
    - Block ID (Shopify): {{ p.id }}
    - Parent Bundle ID: "{{ p.settings.parent_bundle_id }}"
    - Product Handle: {{ p.settings.product.handle }}
    - Product Title: {{ p.settings.product.title }}
    - Quantity: {{ p.settings.quantity }}
{%- endfor -%}

Product Association Test:
{%- for bundle_block in bundle_definitions -%}
  {%- assign test_bundle_id = bundle_block.settings.bundle_id -%}
  {%- assign test_products = all_product_blocks | where: 'settings.parent_bundle_id', test_bundle_id -%}
  Bundle "{{ test_bundle_id }}" → Found {{ test_products.size }} matching products
  {%- for tp in test_products -%}
    - {{ tp.settings.product.title }}
  {%- endfor -%}
{%- endfor -%}
═══════════════════════════════════════════════════════════
{%- endcomment -%}

<section
  id="PowerPairsBF25"
  class="pp-main-container"
  role="region"
  aria-labelledby="pp-section-heading"
  lang="{{ request.locale.iso_code }}"
  data-section-id="{{ section.id }}"
  data-customers-served="{{ section.settings.customers_served }}"
  data-satisfaction-rate="{{ section.settings.satisfaction_rate }}"
>

  {%- comment -%} Hidden heading for screen readers {%- endcomment -%}
  <h2 id="pp-section-heading" class="pp-sr-only">
    {{ section.settings.section_title | default: "Power Pairs Bundle Builder" }}
  </h2>

  {%- comment -%} SECTION HEADER {%- endcomment -%}
  {% if section.settings.section_title != blank or section.settings.section_subtitle != blank %}
    <div class="pp-header">
      {% if section.settings.section_title != blank %}
        <h2 class="pp-header__title">{{ section.settings.section_title }}</h2>
      {% endif %}

      {% if section.settings.section_subtitle != blank %}
        <p class="pp-header__subtitle">{{ section.settings.section_subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  {%- comment -%}
  ═══════════════════════════════════════════════════════════
  TRUST BADGES SECTION (Added in Prompt 13)
  Displays trust-building elements before bundle cards
  ═══════════════════════════════════════════════════════════
  {%- endcomment -%}
  {%- if section.settings.show_trust_badges -%}
    <div class="pp-trust-badges">

      {%- if section.settings.trust_badge_1_enabled -%}
        <div class="pp-trust-badge">
          <div class="pp-trust-badge__icon">{{ section.settings.trust_badge_1_icon }}</div>
          <div class="pp-trust-badge__text">{{ section.settings.trust_badge_1_text }}</div>
        </div>
      {%- endif -%}

      {%- if section.settings.trust_badge_2_enabled -%}
        <div class="pp-trust-badge">
          <div class="pp-trust-badge__icon">{{ section.settings.trust_badge_2_icon }}</div>
          <div class="pp-trust-badge__text">{{ section.settings.trust_badge_2_text }}</div>
        </div>
      {%- endif -%}

      {%- if section.settings.trust_badge_3_enabled -%}
        <div class="pp-trust-badge">
          <div class="pp-trust-badge__icon">{{ section.settings.trust_badge_3_icon }}</div>
          <div class="pp-trust-badge__text">{{ section.settings.trust_badge_3_text }}</div>
        </div>
      {%- endif -%}

      {%- if section.settings.trust_badge_4_enabled -%}
        <div class="pp-trust-badge">
          <div class="pp-trust-badge__icon">{{ section.settings.trust_badge_4_icon }}</div>
          <div class="pp-trust-badge__text">{{ section.settings.trust_badge_4_text }}</div>
        </div>
      {%- endif -%}

    </div>
  {%- endif -%}

  {%- comment -%} BUNDLE GRID CONTAINER {%- endcomment -%}
  {% if has_bundles %}
    <div id="pp-bundles-grid" class="pp-bundles-grid">

      {%- comment -%}
        STEP 3: Loop through each bundle definition
      {%- endcomment -%}
      {% for bundle_block in bundle_definitions %}
        {%- liquid
          comment
            Get bundle settings
          endcomment
          assign bundle_id = bundle_block.settings.bundle_id
          assign bundle_title = bundle_block.settings.bundle_title
          assign tier_level = bundle_block.settings.tier_level
          assign bundle_id_clean = bundle_id | strip | downcase

          comment
            STEP 4: Find all products that belong to this bundle
            Using robust matching with cleaned IDs
          endcomment
          assign total_price = 0
          assign total_compare_price = 0
          assign total_items = 0
          assign has_products = false
          assign matched_product_count = 0
        -%}

        {%- comment -%} Count and calculate totals for matched products {%- endcomment -%}
        {% for product_block in all_product_blocks %}
          {%- liquid
            assign parent_id_clean = product_block.settings.parent_bundle_id | strip | downcase

            if parent_id_clean == bundle_id_clean
              assign has_products = true
              assign matched_product_count = matched_product_count | plus: 1

              assign product = product_block.settings.product
              assign quantity = product_block.settings.quantity | default: 1

              if product != blank
                assign product_total = product.price | times: quantity
                assign total_price = total_price | plus: product_total

                assign compare_price = product.compare_at_price | default: product.price
                assign compare_total = compare_price | times: quantity
                assign total_compare_price = total_compare_price | plus: compare_total

                assign total_items = total_items | plus: quantity
              endif
            endif
          -%}
        {% endfor %}

        {%- comment -%}
          Render bundle card component
          Totals already calculated in the loop above
        {%- endcomment -%}
        {% render 'bundle-card-bf25',
          bundle_settings: bundle_block.settings,
          total_price: total_price,
          total_compare_price: total_compare_price,
          total_items: total_items,
          has_products: has_products
        %}

      {% endfor %}

    </div>
  {% else %}
    {%- comment -%} No bundles configured {%- endcomment -%}
    <div class="pp-empty-state">
      <p style="text-align: center; padding: 60px 20px; color: #999; font-size: 16px;">
        👆 Click "Add block" above and add a "📦 Bundle Kit (Parent)" to get started.
      </p>
    </div>
  {% endif %}

  {%- comment -%}
  ═══════════════════════════════════════════════════════════
  BOTTOM SHEET (Added in Prompt 5)
  Mobile: Slides up from bottom
  Desktop: Slides in from right
  ═══════════════════════════════════════════════════════════
  {%- endcomment -%}

  {%- comment -%} Overlay backdrop {%- endcomment -%}
  <div id="pp-bottom-sheet-overlay" class="pp-sheet-overlay"></div>

  {%- comment -%} Bottom sheet container {%- endcomment -%}
  <aside id="pp-bottom-sheet" class="pp-bottom-sheet" role="dialog" aria-modal="true" aria-labelledby="pp-sheet-title">

    {%- comment -%} Sheet header {%- endcomment -%}
    <div class="pp-sheet-header">
      <h2 id="pp-sheet-title" class="pp-sheet-title">Customize Your Kit</h2>
      <button
        class="pp-sheet-close"
        data-action="close-sheet"
        aria-label="Close customization panel"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    {%- comment -%} Sheet body (content will be populated by JavaScript in Prompt 7) {%- endcomment -%}
    <div class="pp-sheet-body">
      <p class="pp-sheet-placeholder">Sheet content will load here...</p>
    </div>

    {%- comment -%} Sheet footer (sticky add to cart) {%- endcomment -%}
    <div class="pp-sheet-footer">
      <button class="pp-sheet-cta" disabled>
        <span class="pp-sheet-cta-text">Add to Cart</span>
        <span class="pp-sheet-cta-price">$0.00</span>
      </button>
    </div>

    {%- comment -%}
    ═══════════════════════════════════════════════════════════
    VARIANT SELECTION MINI-MODAL
    Nested inside bottom sheet for variant selection
    ═══════════════════════════════════════════════════════════
    {%- endcomment -%}

    <div
      id="pp-variant-modal-overlay"
      class="pp-variant-modal-overlay"
      aria-hidden="true"
    ></div>

    <div
      id="pp-variant-modal"
      class="pp-variant-modal glass-surface"
      role="dialog"
      aria-modal="true"
      aria-labelledby="pp-variant-modal-title"
      aria-hidden="true"
    >
      <button
        class="pp-variant-modal__close"
        aria-label="Close variant selector"
        type="button"
      >
        <span class="pp-variant-modal__close-icon">✕</span>
      </button>

      <div id="pp-variant-modal-content" class="pp-variant-modal__content">
        {%- comment -%} Content populated by JavaScript {%- endcomment -%}
      </div>
    </div>

  </aside>

  {%- comment -%}
  ═══════════════════════════════════════════════════════════
  DATA EXPORT TO JAVASCRIPT
  Export bundle and product data as JSON for state management
  ═══════════════════════════════════════════════════════════
  {%- endcomment -%}

  {%- comment -%}
  ═══════════════════════════════════════════════════════════
  DEBUG: Bundle and Product Association Report
  ═══════════════════════════════════════════════════════════
  Bundle Definitions Found: {{ bundle_definitions.size }}
  Product Blocks Found: {{ all_product_blocks.size }}

  {% for bundle_block in bundle_definitions %}
  Bundle {{ forloop.index }}: ID="{{ bundle_block.settings.bundle_id }}" Title="{{ bundle_block.settings.bundle_title }}"
  {% endfor %}

  {% for product_block in all_product_blocks %}
  Product {{ forloop.index }}: Parent="{{ product_block.settings.parent_bundle_id }}" Product="{{ product_block.settings.product.title }}"
  {% endfor %}
  ═══════════════════════════════════════════════════════════
  {%- endcomment -%}

  <script type="application/json" id="PowerPairsData">
  {
    "bundles": [
      {% for bundle_block in bundle_definitions %}
        {%- liquid
          assign bundle_id = bundle_block.settings.bundle_id
          assign bundle_id_clean = bundle_id | strip | downcase
        -%}
        {
          "id": {{ bundle_id | json }},
          "title": {{ bundle_block.settings.bundle_title | json }},
          "tier": {{ bundle_block.settings.tier_level | json }},
          "tierBadgeText": {{ bundle_block.settings.tier_badge_text | strip_html | json }},
          "avatarTags": {{ bundle_block.settings.avatar_tags | json }},
          "multipliers": {{ bundle_block.settings.multipliers | split: ',' | json }},
          "products": [
            {%- liquid
              assign product_count = 0
            -%}
            {% for product_block in all_product_blocks %}
              {%- liquid
                comment
                  ROBUST PRODUCT MATCHING: Compare cleaned IDs (stripped, lowercase)
                  This handles user input variations like extra spaces or case differences
                endcomment
                assign parent_id_clean = product_block.settings.parent_bundle_id | strip | downcase
                assign is_match = false

                if parent_id_clean == bundle_id_clean
                  assign is_match = true
                endif
              -%}
              {% if is_match %}
                {%- liquid
                  assign product = product_block.settings.product
                  assign quantity = product_block.settings.quantity | default: 1
                -%}
                {% if product != blank %}
                  {%- if product_count > 0 -%},{%- endif -%}
                  {
                    "id": {{ product.id | json }},
                    "title": {{ product.title | json }},
                    "handle": {{ product.handle | json }},
                    "image": {{ product.featured_image | image_url: width: 300 | json }},
                    "price": {{ product.price | json }},
                    "compareAtPrice": {{ product.compare_at_price | default: product.price | json }},
                    "quantity": {{ quantity | json }},
                    "hasVariants": {% if product.has_only_default_variant %}false{% else %}true{% endif %},
                    "available": {{ product.available | json }},
                    "rating": {{ product.metafields.reviews.rating | default: 0 | json }},
                    "reviewCount": {{ product.metafields.reviews.count | default: 0 | json }},
                    "isBestSeller": {% if product.tags contains 'best-seller' %}true{% else %}false{% endif %},
                    "variants": [
                      {% for variant in product.variants %}
                        {
                          "id": {{ variant.id | json }},
                          "title": {{ variant.title | json }},
                          "price": {{ variant.price | json }},
                          "compareAtPrice": {{ variant.compare_at_price | default: variant.price | json }},
                          "available": {{ variant.available | json }},
                          "options": [
                            {% for option in variant.options %}
                              {{ option | json }}{% unless forloop.last %},{% endunless %}
                            {% endfor %}
                          ],
                          "image": {% if variant.image %}{{ variant.image | image_url: width: 300 | json }}{% else %}{{ product.featured_image | image_url: width: 300 | json }}{% endif %}
                        }{% unless forloop.last %},{% endunless %}
                      {% endfor %}
                    ],
                    "options": [
                      {% for option in product.options_with_values %}
                        {
                          "name": {{ option.name | json }},
                          "position": {{ option.position | json }},
                          "values": {{ option.values | json }}
                        }{% unless forloop.last %},{% endunless %}
                      {% endfor %}
                    ]
                  }
                  {%- liquid
                    assign product_count = product_count | plus: 1
                  -%}
                {% endif %}
              {% endif %}
            {% endfor %}
          ]
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }
  </script>

  {%- comment -%}
  ═══════════════════════════════════════════════════════════
  ACCESSIBILITY - LIVE REGIONS
  Screen reader announcements for state changes
  ═══════════════════════════════════════════════════════════
  {%- endcomment -%}

  <div
    id="pp-sr-announcements"
    class="pp-sr-only"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  ></div>

  <div
    id="pp-sr-alerts"
    class="pp-sr-only"
    role="alert"
    aria-live="assertive"
    aria-atomic="true"
  ></div>

</section>

{% schema %}
{
  "name": "Power Pairs BF25",
  "class": "section-power-pairs-bf25",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "🎁 POWER PAIRS - Ready-Made Kits"
    },
    {
      "type": "text",
      "id": "section_subtitle",
      "label": "Section Subtitle",
      "default": "Jump straight to your tier"
    },
    {
      "type": "header",
      "content": "Trust & Social Proof"
    },
    {
      "type": "checkbox",
      "id": "show_trust_badges",
      "label": "Show Trust Badges",
      "default": true,
      "info": "Display trust elements above bundle cards"
    },
    {
      "type": "checkbox",
      "id": "trust_badge_1_enabled",
      "label": "Enable Badge 1",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_badge_1_icon",
      "label": "Badge 1 Icon",
      "default": "🔒",
      "info": "Emoji or icon for badge 1"
    },
    {
      "type": "text",
      "id": "trust_badge_1_text",
      "label": "Badge 1 Text",
      "default": "Secure Checkout"
    },
    {
      "type": "checkbox",
      "id": "trust_badge_2_enabled",
      "label": "Enable Badge 2",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_badge_2_icon",
      "label": "Badge 2 Icon",
      "default": "✓",
      "info": "Emoji or icon for badge 2"
    },
    {
      "type": "text",
      "id": "trust_badge_2_text",
      "label": "Badge 2 Text",
      "default": "30-Day Returns"
    },
    {
      "type": "checkbox",
      "id": "trust_badge_3_enabled",
      "label": "Enable Badge 3",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_badge_3_icon",
      "label": "Badge 3 Icon",
      "default": "🚚",
      "info": "Emoji or icon for badge 3"
    },
    {
      "type": "text",
      "id": "trust_badge_3_text",
      "label": "Badge 3 Text",
      "default": "Free Shipping"
    },
    {
      "type": "checkbox",
      "id": "trust_badge_4_enabled",
      "label": "Enable Badge 4",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_badge_4_icon",
      "label": "Badge 4 Icon",
      "default": "⭐",
      "info": "Emoji or icon for badge 4"
    },
    {
      "type": "text",
      "id": "trust_badge_4_text",
      "label": "Badge 4 Text",
      "default": "50K+ Reviews"
    },
    {
      "type": "text",
      "id": "customers_served",
      "label": "Customers Served (Social Proof)",
      "default": "100,000",
      "info": "Display in CTA section (e.g., '100,000' or '100K')"
    },
    {
      "type": "text",
      "id": "satisfaction_rate",
      "label": "Satisfaction Rate (Social Proof)",
      "default": "98",
      "info": "Percentage only (e.g., '98' for 98%)"
    },
    {
      "type": "header",
      "content": "Performance Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_performance_optimizations",
      "label": "Enable performance optimizations",
      "default": true,
      "info": "Lazy loading, resource hints, optimized animations"
    },
    {
      "type": "checkbox",
      "id": "defer_bottom_sheet_js",
      "label": "Defer bottom sheet initialization",
      "default": true,
      "info": "Load bottom sheet code only when needed (recommended)"
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "📦 Bundle Kit (Parent)",
      "limit": 4,
      "settings": [
        {
          "type": "header",
          "content": "⚠️ CRITICAL: Bundle Configuration"
        },
        {
          "type": "paragraph",
          "content": "The Bundle ID must be unique and match exactly in child products below."
        },
        {
          "type": "text",
          "id": "bundle_id",
          "label": "Bundle ID (Unique Identifier)",
          "info": "CRITICAL: Use a unique ID like 'quick-start' or 'power-user'. Must match exactly in child products.",
          "default": "bundle-1"
        },
        {
          "type": "header",
          "content": "Bundle Details"
        },
        {
          "type": "text",
          "id": "bundle_title",
          "label": "Bundle Title",
          "default": "Quick Start Kit",
          "info": "e.g., Quick Start Kit, Power User Pack"
        },
        {
          "type": "select",
          "id": "tier_level",
          "label": "Base Tier Level",
          "info": "The tier this bundle starts at (before multipliers)",
          "options": [
            { "value": "1", "label": "⚡ Tier 1 (4 items base)" },
            { "value": "2", "label": "🎁 Tier 2 (8 items base)" },
            { "value": "3", "label": "🔥 Tier 3 (12 items base)" },
            { "value": "4", "label": "💎 Tier 4 (16 items base)" }
          ],
          "default": "1"
        },
        {
          "type": "richtext",
          "id": "tier_badge_text",
          "label": "Tier Badge Text",
          "default": "<p>⚡ TIER 1 - Unlock 60% OFF</p>",
          "info": "Displays on the bundle card"
        },
        {
          "type": "textarea",
          "id": "avatar_tags",
          "label": "Built For (Avatar Tags)",
          "default": "🎒 Students, ✈️ Travelers, 💡 First Buyers",
          "info": "Comma-separated tags describing target customers"
        },
        {
          "type": "text",
          "id": "multipliers",
          "label": "Available Multipliers",
          "default": "1,2,3,4",
          "info": "Comma-separated values. e.g., 1,2,3,4 allows users to buy 1x, 2x, 3x, or 4x kits"
        }
      ]
    },
    {
      "type": "bundle_product",
      "name": "🧩 Bundle Product (Child)",
      "settings": [
        {
          "type": "header",
          "content": "⚠️ Product Configuration"
        },
        {
          "type": "paragraph",
          "content": "This product belongs to a bundle. The Parent Bundle ID must match the Bundle ID above EXACTLY."
        },
        {
          "type": "text",
          "id": "parent_bundle_id",
          "label": "Parent Bundle ID",
          "info": "MUST match the 'Bundle ID' from the parent bundle above (e.g., 'quick-start')",
          "default": "bundle-1"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "number",
          "id": "quantity",
          "label": "Quantity in Bundle",
          "default": 1,
          "info": "How many of this product are included in one bundle kit"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Power Pairs BF25",
      "category": "Promotional"
    }
  ]
}
{% endschema %}
