{% comment %}
  Titan Tower Replacement Section
  Shows main Titan Tower product with 6 replacement products arranged around it
{% endcomment %}
<script src="https://cdn.tailwindcss.com"></script>
{% assign main_product = section.settings.main_product %}

<section class="titan-tower-replacement py-[60px] bg-white">
  <div class="container mx-auto px-[20px] max-w-[1200px]">
    
    {% comment %} Section Header {% endcomment %}
    {% if section.settings.title != blank or section.settings.subtitle != blank %}
      <div class="text-center mb-[50px]">
        {% if section.settings.title != blank %}
          <h2 class="text-[32px] lg:text-[40px] font-bold text-[#2e2a39] mb-[15px]">
            {{ section.settings.title }}
          </h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="text-[16px] lg:text-[18px] text-[#666] max-w-[600px] mx-auto">
            {{ section.settings.subtitle }}
          </p>
        {% endif %}
      </div>
    {% endif %}
    
    {% comment %} Desktop Layout {% endcomment %}
    <div class="hidden lg:block">
      <div class="grid grid-cols-[200px_1fr_200px] gap-[20px] items-center max-w-[900px] mx-auto">
        
        {% comment %} Left Column - 2 Products {% endcomment %}
        <div class="flex flex-col gap-[20px]">
          {% for block in section.blocks limit: 2 %}
            {% if block.type == 'replacement_product' %}
              {% assign product_item = block.settings.product %}
              <div class="bg-white rounded-[15px] shadow-[0_5px_20px_rgba(0,0,0,0.08)] p-[15px] text-center">
                {% if product_item.featured_image %}
                  <img 
                    src="{{ product_item.featured_image | image_url: width: 100 }}" 
                    alt="{{ product_item.title }}"
                    width="100"
                    height="100"
                    class="w-[100px] h-[100px] object-contain mx-auto mb-[10px]"
                  >
                {% endif %}
                
                <h3 class="text-[12px] text-[#2e2a39] font-medium mb-[5px] leading-[1.2]">
                  {{ product_item.title }}
                </h3>
                
                <div class="text-[14px] text-[#999] font-semibold">
                  Save <span class="line-through">{{ product_item.price | money }}</span>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
        
        {% comment %} Center Column - Product Above + Main Product + Product Below {% endcomment %}
        <div class="flex flex-col gap-[20px] items-center">
          
          {% comment %} Product Above Main {% endcomment %}
          {% assign top_product = section.blocks[4] %}
          {% if top_product.type == 'replacement_product' %}
            {% assign product_item = top_product.settings.product %}
            <div class="bg-white rounded-[15px] shadow-[0_5px_20px_rgba(0,0,0,0.08)] p-[15px] text-center w-[200px]">
              {% if product_item.featured_image %}
                <img 
                  src="{{ product_item.featured_image | image_url: width: 100 }}" 
                  alt="{{ product_item.title }}"
                  width="100"
                  height="100"
                  class="w-[100px] h-[100px] object-contain mx-auto mb-[10px]"
                >
              {% endif %}
              
              <h3 class="text-[12px] text-[#2e2a39] font-medium mb-[5px] leading-[1.2]">
                {{ product_item.title }}
              </h3>
              
              <div class="text-[14px] text-[#999] font-semibold">
                Save <span class="line-through">{{ product_item.price | money }}</span>
              </div>
            </div>
            

          {% endif %}
          
          {% comment %} Main Titan Product {% endcomment %}
          <div class="bg-white rounded-[20px] shadow-[0_10px_40px_rgba(0,0,0,0.1)] p-[40px] text-center relative">
            {% if main_product.featured_image %}
              <img 
                src="{{ main_product.featured_image | image_url: width: 320 }}" 
                alt="{{ main_product.title }}"
                width="320"
                height="320"
                class="w-[320px] h-[320px] object-contain mx-auto mb-[20px]"
              >
            {% endif %}
            
            {% comment %} Calculate total value of all replacement products {% endcomment %}
            {% assign total_value = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'replacement_product' and block.settings.product %}
                {% assign total_value = total_value | plus: block.settings.product.price %}
              {% endif %}
            {% endfor %}
            
            {% comment %} Calculate savings {% endcomment %}
            {% assign main_price = main_product.price %}
            {% assign savings = total_value | minus: main_price %}
            
            <div class="mb-[5px]">
              <span class="text-[16px] text-[#999] line-through block">Total Value {{ total_value | money }}</span>
            </div>
            
            <div class="mb-[5px] flex items-center justify-center gap-[10px]">
              <span class="text-[20px] text-[#60c655] font-bold">Now {{ main_price | money }}</span>
              {% if savings > 0 %}
                <span class="bg-[#60c655] text-white text-[11px] font-semibold px-[12px] py-[4px] rounded-full">
                  Save {{ savings | money }}
                </span>
              {% endif %}
            </div>
            
            <div class="mb-[5px]">
              <span class="text-[18px] text-[#2e2a39] font-medium block">{{ section.settings.normal_text_1 }}</span>
            </div>
            
            <div class="mb-[15px]">
              <span class="text-[16px] text-[#666] block">{{ section.settings.normal_text_2 }}</span>
            </div>
            
            <button 
              type="button"
              onclick="scrollToElement('{{ section.settings.scroll_target_id }}')"
              class="inline-block bg-[#60c655] hover:bg-[#54b349] text-white text-[16px] font-semibold px-[30px] py-[12px] rounded-[8px] transition-all duration-300 border-0 cursor-pointer"
            >
              Get Yours Today
            </button>
          </div>
          
          {% comment %} Product Below Main {% endcomment %}
          {% assign bottom_product = section.blocks[5] %}
          {% if bottom_product.type == 'replacement_product' %}
            
            {% assign product_item = bottom_product.settings.product %}
            <div class="bg-white rounded-[15px] shadow-[0_5px_20px_rgba(0,0,0,0.08)] p-[15px] text-center w-[200px]">
              {% if product_item.featured_image %}
                <img 
                  src="{{ product_item.featured_image | image_url: width: 100 }}" 
                  alt="{{ product_item.title }}"
                  width="100"
                  height="100"
                  class="w-[100px] h-[100px] object-contain mx-auto mb-[10px]"
                >
              {% endif %}
              
              <h3 class="text-[12px] text-[#2e2a39] font-medium mb-[5px] leading-[1.2]">
                {{ product_item.title }}
              </h3>
              
              <div class="text-[14px] text-[#999] font-semibold">
                Save <span class="line-through">{{ product_item.price | money }}</span>
              </div>
            </div>
          {% endif %}
          
        </div>
        
        {% comment %} Right Column - 2 Products {% endcomment %}
        <div class="flex flex-col gap-[20px]">
          {% for block in section.blocks offset: 2 limit: 2 %}
            {% if block.type == 'replacement_product' %}
              {% assign product_item = block.settings.product %}
              <div class="bg-white rounded-[15px] shadow-[0_5px_20px_rgba(0,0,0,0.08)] p-[20px] text-center">
                {% if product_item.featured_image %}
                  <img 
                    src="{{ product_item.featured_image | image_url: width: 140 }}" 
                    alt="{{ product_item.title }}"
                    width="140"
                    height="140"
                    class="w-[140px] h-[140px] object-contain mx-auto mb-[15px]"
                  >
                {% endif %}
                
                <h3 class="text-[14px] text-[#2e2a39] font-medium mb-[8px] leading-[1.3]">
                  {{ product_item.title }}
                </h3>
                
                <div class="text-[16px] text-[#999] font-semibold">
                  Save {{ product_item.price | money }}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      

    </div>
    
    {% comment %} Mobile Layout {% endcomment %}
    <div class="block lg:hidden">
      
      {% comment %} Main Product on Mobile {% endcomment %}
      <div class="bg-white rounded-[20px] shadow-[0_10px_40px_rgba(0,0,0,0.1)] p-[25px] mb-[40px] text-center">
        {% if main_product.featured_image %}
          <img 
            src="{{ main_product.featured_image | image_url: width: 250 }}" 
            alt="{{ main_product.title }}"
            width="250"
            height="250"
            class="w-[250px] h-[250px] object-contain mx-auto mb-[20px]"
          >
        {% endif %}
        
        {% comment %} Calculate total value of all replacement products {% endcomment %}
        {% assign total_value = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'replacement_product' and block.settings.product %}
            {% assign total_value = total_value | plus: block.settings.product.price %}
          {% endif %}
        {% endfor %}
        
        {% comment %} Calculate savings {% endcomment %}
        {% assign main_price = main_product.price %}
        {% assign savings = total_value | minus: main_price %}
        
        <div class="mb-[15px]">
          <span class="text-[16px] text-[#999] line-through block">Total Value {{ total_value | money }}</span>
        </div>
        
        <div class="mb-[15px] flex items-center justify-center gap-[10px]">
          <span class="text-[22px] text-[#2e2a39] font-bold">Now {{ main_price | money }}</span>
          {% if savings > 0 %}
            <span class="bg-[#60c655] text-white text-[12px] font-semibold px-[10px] py-[3px] rounded-full">
              Save {{ savings | money }}
            </span>
          {% endif %}
        </div>
        
        <div class="mb-[15px]">
          <span class="text-[18px] text-[#2e2a39] font-medium block">{{ section.settings.normal_text_1 }}</span>
        </div>
        
        <div class="mb-[25px]">
          <span class="text-[16px] text-[#666] block">{{ section.settings.normal_text_2 }}</span>
        </div>
        
        <button 
          type="button"
          onclick="scrollToElement('{{ section.settings.scroll_target_id }}')"
          class="inline-block bg-[#60c655] hover:bg-[#54b349] text-white text-[16px] font-semibold px-[30px] py-[12px] rounded-[8px] transition-all duration-300 border-0 cursor-pointer"
        >
          Get Yours Today
        </button>
      </div>
      
      {% comment %} Mobile Header for Replacement Products {% endcomment %}
      {% if section.settings.mobile_items_text != blank %}
        <div class="text-center mb-[30px]">
          <h3 class="text-[20px] font-semibold text-[#2e2a39]">
            {{ section.settings.mobile_items_text }}
          </h3>
        </div>
      {% endif %}
      
      {% comment %} Replacement Products Stacked on Mobile {% endcomment %}
      <div class="space-y-[20px]">
        {% for block in section.blocks %}
          {% if block.type == 'replacement_product' %}
            {% assign product_item = block.settings.product %}
            
            <div class="bg-white rounded-[15px] shadow-[0_5px_20px_rgba(0,0,0,0.08)] p-[20px] flex items-center">
              {% if product_item.featured_image %}
                <img 
                  src="{{ product_item.featured_image | image_url: width: 80 }}" 
                  alt="{{ product_item.title }}"
                  width="80"
                  height="80"
                  class="w-[80px] h-[80px] object-contain mr-[20px] flex-shrink-0"
                >
              {% endif %}
              
              <div class="flex-1">
                <h3 class="text-[16px] text-[#2e2a39] font-medium mb-[8px] leading-[1.3]">
                  {{ product_item.title }}
                </h3>
                
                <div class="text-[16px] text-[#999] font-semibold">
                  Save <span class="line-through">{{ product_item.price | money }}</span>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    
  </div>
</section>

<script>
function scrollToElement(targetId) {
  if (!targetId) return;
  
  const targetElement = document.getElementById(targetId);
  if (targetElement) {
    targetElement.scrollIntoView({
      behavior: 'smooth',
      block: 'start'
    });
  }
}
</script>

{% schema %}
{
  "name": "Titan Tower Replacement",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "One Product Replaces Everything",
      "info": "Main heading for the section"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Save money and simplify your setup with the Titan Tower - the all-in-one solution that replaces 6 different products.",
      "info": "Descriptive text below the title"
    },
    {
      "type": "product",
      "id": "main_product",
      "label": "Main Product (Titan Tower)",
      "info": "Select the main Titan Tower product to display in the center"
    },
          {
        "type": "text",
        "id": "normal_text_1",
        "label": "Primary Text",
        "default": "Replaces all these for one low price",
        "info": "Main descriptive text"
      },
    {
      "type": "text",
      "id": "normal_text_2",
      "label": "Secondary Text",
      "default": "All-in-one solution",
      "info": "Additional descriptive text"
    },
    {
      "type": "text",
      "id": "mobile_items_text",
      "label": "Mobile Items Header",
      "default": "Replaces These 6 Items:",
      "info": "Text shown above replacement products on mobile only"
    },
    {
      "type": "text",
      "id": "scroll_target_id",
      "label": "Scroll Target ID",
      "default": "product-form",
      "info": "ID of the element to scroll to when 'Get Yours Today' is clicked (without #)"
    }
  ],
  "blocks": [
    {
      "type": "replacement_product",
      "name": "Replacement Product",
      "limit": 6,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Select a product that the Titan Tower replaces"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Titan Tower",
      "blocks": [
        {
          "type": "replacement_product"
        },
        {
          "type": "replacement_product"
        },
        {
          "type": "replacement_product"
        },
        {
          "type": "replacement_product"
        },
        {
          "type": "replacement_product"
        },
        {
          "type": "replacement_product"
        }
      ]
    }
  ]
}
{% endschema %} 