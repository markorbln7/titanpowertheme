{% assign first_upsell_product = all_products[upsell_product_one] %}
{% assign second_upsell_product = all_products[upsell_product_two] %}

<aside class="buy-now-popup fixed inset-0 bottom-0 left-0 right-0 top-0 z-[1000] bg-black bg-opacity-60 close-buy-now-popup" data-section="bf25" data-product-id="{{ product_id_attr }}">
    <div class="buy-now-popup__wrapper absolute left-[50%] top-[50%] translate-x-[-50%] translate-y-[-50%] h-[70vh] max-h-[860px] w-[80vw] max-w-[1280px] py-[70px] rounded-xl bg-[#fff]">
        <svg viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="6948" width="32" height="32" class="close-buy-now-popup absolute right-[16px] top-[16px] z-[2] h-[25px] w-[25px] cursor-pointer fill-[#999]">
            <path d="M557.311759 513.248864l265.280473-263.904314c12.54369-12.480043 12.607338-32.704421 0.127295-45.248112-12.512727-12.576374-32.704421-12.607338-45.248112-0.127295L512.127295 467.904421 249.088241 204.063755c-12.447359-12.480043-32.704421-12.54369-45.248112-0.063647-12.512727 12.480043-12.54369 32.735385-0.063647 45.280796l262.975407 263.775299-265.151458 263.744335c-12.54369 12.480043-12.607338 32.704421-0.127295 45.248112 6.239161 6.271845 14.463432 9.440452 22.687703 9.440452 8.160624 0 16.319527-3.103239 22.560409-9.311437l265.216826-263.807983 265.440452 266.240344c6.239161 6.271845 14.432469 9.407768 22.65674 9.407768 8.191587 0 16.352211-3.135923 22.591372-9.34412 12.512727-12.480043 12.54369-32.704421 0.063647-45.248112L557.311759 513.248864z" p-id="6949"></path>
        </svg>
        <div class="buy-now-popup__product-body flex h-full px-[70px] overflow-y-auto">
            <figure class="max-h-[432px] h-full w-[47%] mr-[5%] relative">
                {% if badge_text %}
                  <div class="absolute left-[10px] top-[10px]">
                    <div class="discount_message relative flex bg-[#60c655] rounded-tl-[20px] md:text-[18px] text-[14px] color-white p-[6px] font-bold pr-[10px]">
                      <div>{{ badge_text }}</div>
                      <div class="absolute right-[-25px] md:right-[-40px] md:w-[60px] w-[40px] md:top-[-15px] top-[-8px]"><img width="100" height="auto" src="https://cdn.shopify.com/s/files/1/0071/1727/5191/files/lightning_bolt.png?v=1730972558"></div>
                    </div>
                  </div>
                {% endif %}
                <img src="{{ product_image | img_url: 'master' }}" alt="{{product_image.alt}}" height="432" width="432" class="h-full w-full object-cover js-variant-image"/>
            </figure>
            <div class="buy-now-popup__content flex-1">
                <a href="{{ product.url }}" class="text-[21px] pb-[6px] border-b border-solid border-[#e5e5e5] leading-[1.2] font-bold color-black">{{ title }}</a>
                <div class="flex items-center mt-[12px]">
                    <span class="mr-[8px] text-[21px] text-[#60c655] font-bold js-variant-price">{{ price | money }}</span> <span class="crossed text-[#999] js-variant-compare-price">{{ compare_at_price | money }}</span>
                </div>
                {% if description != blank %}
                    <div class="buy-now-popup__description pb-[24px] overflow-hidden">
                        <div class="buy-now-popup__description-inner h-[100px] with-gradient overflow-hidden">
                            <div>{{ description }}</div>
                        </div>
                        <p class="buy-now-popup__expand-desc text-black text-[16px] pt-[14px] pointer flex items-center gap-[6px] color-[#60c655] color-titan-green">
                           <span> Learn More</span>
                            <svg class="text-black w-[16px] h-[16px]" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="5772" width="32" height="32">
                                <path d="M225.408 368.384L496 640.641l270.592-272.257-48.64-49.024L496 542.592 274.176 319.36l-48.768 49.024z m0 0z" fill="#60c655" p-id="5773"></path>
                            </svg>
                        </p>
                    </div>
                {% endif %}
                {% if product.variants.size > 1 %}
                  <!-- Visual Variant Selectors (BOGO-VARIANT-SWATCHES-020) -->
                  <div class="variant-selectors-visual">
                    {% for option in product.options_with_values %}
                      {% if option.name != 'Title' or option.values[0] != 'Default Title' %}
                        <div class="variant-option-group">
                          <label class="variant-option-label">{{ option.name }}:</label>

                          {% assign option_lower = option.name | downcase %}
                          {% if option_lower contains 'color' or option_lower contains 'colour' %}
                            <!-- Color Swatches -->
                            <div class="variant-swatches" data-option-index="{{ forloop.index }}">
                              {% for value in option.values %}
                                {% assign color_slug = value | downcase | replace: ' ', '' %}
                                <div class="variant-swatch {% if forloop.first %}selected{% endif %}"
                                     data-value="{{ value }}"
                                     data-color="{{ color_slug }}"
                                     title="{{ value }}"
                                     onclick="selectVariantSwatch(this, {{ forloop.index }})">
                                </div>
                              {% endfor %}
                            </div>

                          {% else %}
                            <!-- Size/Length Buttons -->
                            <div class="variant-buttons" data-option-index="{{ forloop.index }}">
                              {% for value in option.values %}
                                <button class="variant-button {% if forloop.first %}selected{% endif %}"
                                        data-value="{{ value }}"
                                        type="button"
                                        onclick="selectVariantButton(this, {{ forloop.index }})">
                                  {{ value }}
                                </button>
                              {% endfor %}
                            </div>

                          {% endif %}
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>

                  <!-- Hidden fallback selects for compatibility -->
                  <div class="variant-selectors-fallback">
                    {% for option in product.options_with_values %}
                      {% if option.name != 'Title' or option.values[0] != 'Default Title' %}
                        <select class="variant-selector" data-option-index="{{ forloop.index }}">
                          {% for value in option.values %}
                            <option value="{{ value }}">{{ value }}</option>
                          {% endfor %}
                        </select>
                      {% endif %}
                    {% endfor %}
                  </div>
                {% endif %}
{%- comment -%}
  ============================================
  BF25 QUANTITY SELECTION SYSTEM
  Pack buttons (quick presets) + Quantity stepper
  Both visible simultaneously, synced via JavaScript
  ============================================
{%- endcomment -%}

{%- comment -%} Progress Indicator - Tier Preview {%- endcomment -%}
<div class="bf25-modal-tier-preview mb-[16px]">
  <div class="bf25-tier-message text-[14px] text-[#60c655] font-semibold flex items-center gap-[6px]">
    <span class="bf25-tier-icon">🔥</span>
    <span class="bf25-tier-text js-modal-tier-message">Select quantity to see your savings</span>
  </div>
</div>

{%- comment -%} Pack Buttons - Quick Presets {%- endcomment -%}
<div class="bf25-pack-buttons-container mb-[20px]">
  <h4 class="text-[14px] font-semibold text-[#333] mb-[10px]">Choose Your Pack:</h4>
  <div class="bf25-pack-buttons flex flex-wrap gap-[8px]">

    <button type="button"
            class="bf25-pack-btn js-pack-btn"
            data-quantity="4"
            data-tier="1"
            data-discount="60"
            aria-label="Select 4 items with 60% discount">
      <span class="pack-qty">4 ITEMS</span>
      <span class="pack-discount">60% OFF</span>
      <span class="pack-checkmark">✓</span>
    </button>

    <button type="button"
            class="bf25-pack-btn js-pack-btn bf25-pack-btn--popular"
            data-quantity="8"
            data-tier="2"
            data-discount="70"
            aria-label="Select 8 items with 70% discount - Most Popular">
      <span class="pack-badge">MOST POPULAR</span>
      <span class="pack-qty">8 ITEMS</span>
      <span class="pack-discount">70% OFF</span>
      <span class="pack-checkmark">✓</span>
    </button>

    <button type="button"
            class="bf25-pack-btn js-pack-btn"
            data-quantity="12"
            data-tier="3"
            data-discount="80"
            aria-label="Select 12 items with 80% discount">
      <span class="pack-qty">12 ITEMS</span>
      <span class="pack-discount">80% OFF</span>
      <span class="pack-checkmark">✓</span>
    </button>

  </div>
</div>

{%- comment -%} Quantity Stepper - Fine Adjustment {%- endcomment -%}
<div class="bf25-quantity-section">
  <h4 class="text-[14px] font-semibold text-white mb-[8px]">Or adjust quantity:</h4>
  <div class="bf25-quantity-wrapper flex items-center gap-[16px]">
    <div class="bf25-quantity-stepper flex items-center border border-[rgba(255,255,255,0.2)] rounded-[8px] overflow-hidden">
      <button type="button"
              class="bf25-qty-btn js-qty-minus w-[44px] h-[44px] flex items-center justify-center bg-transparent hover:bg-[rgba(255,255,255,0.1)] transition-colors"
              aria-label="Decrease quantity">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M3 8H13" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
      <input type="number"
             class="bf25-qty-input js-qty-input w-[60px] h-[44px] text-center text-[18px] font-bold border-none outline-none bg-transparent text-white"
             value="1"
             min="1"
             max="99"
             aria-label="Quantity">
      <button type="button"
              class="bf25-qty-btn js-qty-plus w-[44px] h-[44px] flex items-center justify-center bg-transparent hover:bg-[rgba(255,255,255,0.1)] transition-colors"
              aria-label="Increase quantity">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M8 3V13M3 8H13" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <span class="bf25-qty-summary text-[14px] text-[rgba(255,255,255,0.7)] js-qty-summary">1 item selected</span>
  </div>
</div>

{%- comment -%} Pack Buttons + Stepper Sync JavaScript {%- endcomment -%}
<script>
(function() {
  'use strict';

  // Wait for DOM to be ready within this modal context
  const initPackButtons = () => {
    const modal = document.querySelector('.buy-now-popup[data-product-id="{{ product_id_attr }}"]');
    if (!modal) return;

    const packButtons = modal.querySelectorAll('.js-pack-btn');
    const qtyInput = modal.querySelector('.js-qty-input');
    const qtyMinus = modal.querySelector('.js-qty-minus');
    const qtyPlus = modal.querySelector('.js-qty-plus');
    const qtySummary = modal.querySelector('.js-qty-summary');
    const tierMessage = modal.querySelector('.js-modal-tier-message');
    const atcButton = modal.querySelector('.js-atc-bf');

    if (!qtyInput) return;

    const PACK_SIZES = [4, 8, 12, 16];
    const TIER_MESSAGES = {
      0: { min: 1, max: 3, text: 'Add more items to unlock discounts!', discount: '0%' },
      1: { min: 4, max: 7, text: '🔥 60% OFF + FREE Cable unlocked!', discount: '60%' },
      2: { min: 8, max: 11, text: '🎁 70% OFF + FREE Case unlocked!', discount: '70%' },
      3: { min: 12, max: 15, text: '⚡ 80% OFF + FREE Magnetic Set!', discount: '80%' },
      4: { min: 16, max: 999, text: '🎉 MAXIMUM 85% OFF + Mystery Box!', discount: '85%' }
    };

    // Update all UI elements based on quantity
    function updateUI(qty) {
      qty = parseInt(qty) || 1;
      if (qty < 1) qty = 1;
      if (qty > 99) qty = 99;

      // Update input value
      qtyInput.value = qty;

      // Update summary text
      if (qtySummary) {
        qtySummary.textContent = qty === 1 ? '1 item selected' : `${qty} items selected`;
      }

      // Update pack button highlights
      packButtons.forEach(btn => {
        const packQty = parseInt(btn.dataset.quantity);
        // Highlight if quantity exactly matches OR if qty >= 16 and this is the 16+ button
        const isMatch = (packQty === qty) || (packQty === 16 && qty >= 16);
        btn.classList.toggle('is-selected', isMatch);
      });

      // Update tier message
      if (tierMessage) {
        let currentTier = 0;
        for (let i = 4; i >= 0; i--) {
          if (qty >= TIER_MESSAGES[i].min) {
            currentTier = i;
            break;
          }
        }
        tierMessage.textContent = TIER_MESSAGES[currentTier].text;

        // Add next tier hint if not at max
        if (currentTier < 4) {
          const nextTier = TIER_MESSAGES[currentTier + 1];
          const itemsNeeded = nextTier.min - qty;
          if (itemsNeeded > 0 && itemsNeeded <= 4) {
            tierMessage.textContent += ` Add ${itemsNeeded} more for ${nextTier.discount}!`;
          }
        }
      }

      // Update ATC button data attribute
      if (atcButton) {
        atcButton.dataset.quantity = qty;
      }

      // Dispatch custom event for external listeners
      modal.dispatchEvent(new CustomEvent('bf25:quantity-changed', {
        detail: { quantity: qty, productId: '{{ product_id_attr }}' }
      }));
    }

    // Pack button click handler
    packButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const qty = parseInt(btn.dataset.quantity);
        updateUI(qty);
      });
    });

    // Quantity stepper handlers
    if (qtyMinus) {
      qtyMinus.addEventListener('click', (e) => {
        e.preventDefault();
        const current = parseInt(qtyInput.value) || 1;
        updateUI(current - 1);
      });
    }

    if (qtyPlus) {
      qtyPlus.addEventListener('click', (e) => {
        e.preventDefault();
        const current = parseInt(qtyInput.value) || 1;
        updateUI(current + 1);
      });
    }

    // Input direct change handler
    qtyInput.addEventListener('change', () => {
      updateUI(qtyInput.value);
    });

    qtyInput.addEventListener('input', () => {
      // Debounced update on typing
      clearTimeout(qtyInput._debounce);
      qtyInput._debounce = setTimeout(() => updateUI(qtyInput.value), 300);
    });

    // Initialize with default value
    updateUI(1);

    console.log('[BF25] Pack buttons + quantity stepper initialized for modal');
  };

  // Initialize when modal opens (listen for custom event or mutation)
  document.addEventListener('bf25:modal-opened', initPackButtons);

  // Also try immediate init in case modal is already open
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPackButtons);
  } else {
    initPackButtons();
  }

})();
</script>

{%- comment -%} Pack Buttons Styling {%- endcomment -%}
<style>
/* BF25 Pack Buttons */
.bf25-pack-buttons {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}

.bf25-pack-btn {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100px;
  padding: 16px 12px;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  border: 2px solid #333;
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.3s ease;
  text-align: center;
}

.bf25-pack-btn:hover {
  border-color: #60c655;
  transform: translateY(-2px);
  box-shadow: 0 4px 15px rgba(96, 198, 85, 0.3);
}

.bf25-pack-btn.is-selected {
  border-color: #60c655;
  background: linear-gradient(135deg, #1a3a1a 0%, #0d2818 100%);
  box-shadow: 0 0 20px rgba(96, 198, 85, 0.4);
}

.bf25-pack-btn .pack-badge {
  position: absolute;
  top: -10px;
  left: 50%;
  transform: translateX(-50%);
  background: #60c655;
  color: #000;
  font-size: 9px;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 10px;
  white-space: nowrap;
  text-transform: uppercase;
}

.bf25-pack-btn .pack-qty {
  font-size: 20px;
  font-weight: 700;
  color: #fff;
  letter-spacing: 0.5px;
  margin-bottom: 4px;
}

.bf25-pack-btn .pack-discount {
  font-size: 16px;
  font-weight: 700;
  color: #60c655;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

/* Checkmark indicator */
.bf25-pack-btn .pack-checkmark {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 24px;
  height: 24px;
  background: #60c655;
  border-radius: 50%;
  color: #000;
  font-size: 14px;
  font-weight: 700;
  display: none;
  align-items: center;
  justify-content: center;
}

.bf25-pack-btn.is-selected .pack-checkmark {
  display: flex;
}

/* Popular variant */
.bf25-pack-btn--popular {
  border-color: #60c655;
}

/* Max savings variant */
.bf25-pack-btn--max .pack-discount {
  color: #ffd700;
}

.bf25-pack-btn--max.is-selected {
  background: linear-gradient(135deg, #3a2a0a 0%, #2a1a05 100%);
  border-color: #ffd700;
  box-shadow: 0 0 20px rgba(255, 215, 0, 0.4);
}

/* Tier message */
.bf25-tier-message {
  padding: 8px 12px;
  background: rgba(96, 198, 85, 0.1);
  border-radius: 8px;
  border-left: 3px solid #60c655;
}

/* Quantity stepper styling */
.bf25-quantity-stepper {
  background: transparent;
}

.bf25-qty-input {
  -moz-appearance: textfield;
}

.bf25-qty-input::-webkit-outer-spin-button,
.bf25-qty-input::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

/* Mobile responsive */
@media (max-width: 640px) {
  .bf25-pack-buttons {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }

  .bf25-pack-btn {
    min-width: unset;
    min-height: 90px;
    padding: 12px 8px;
  }

  .bf25-pack-btn .pack-qty {
    font-size: 18px;
  }

  .bf25-pack-btn .pack-discount {
    font-size: 14px;
  }
}
</style>

